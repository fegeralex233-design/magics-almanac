function weddingElemCompat(e1,e2){
  if(e1===e2)return{label:'Kindred Souls',desc:'Two '+e1+' signs share a natural understanding and deep resonance — their bond feels like coming home.',stars:5};
  var pairs=[['Fire','Air'],['Earth','Water']];
  for(var i=0;i<pairs.length;i++){
    if((pairs[i][0]===e1&&pairs[i][1]===e2)||(pairs[i][1]===e1&&pairs[i][0]===e2)){
      if(e1==='Fire'||e2==='Fire')return{label:'Fanning the Flame',desc:'Air lifts Fire higher — this union is electric, creative, and ever-growing. You inspire each other endlessly.',stars:5};
      return{label:'Roots and Rain',desc:'Earth and Water nourish one another — this is a bond of steadiness and deep feeling, built to last lifetimes.',stars:5};
    }
