  },{passive:true});
  updateWandVisibility();
})();
function waveWandToTop(){
  const icon=document.getElementById('wandTopIcon');
  const btn=document.getElementById('wandTopBtn');
  if(icon){
    icon.style.animation='none';icon.offsetHeight;icon.style.animation='wandWave 1.1s ease-in-out';
  }
  if(!document.getElementById('wandTopStyle')){
    const st=document.createElement('style');st.id='wandTopStyle';
    st.textContent='@keyframes wandWave{0%{transform:rotate(0deg)}20%{transform:rotate(-28deg)}45%{transform:rotate(18deg)}70%{transform:rotate(-10deg)}90%{transform:rotate(4deg)}100%{transform:rotate(0deg)}}@keyframes wandSparkPop{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(var(--sx),var(--sy)) scale(.2)}}@keyframes wandSparkleThrough{0%{opacity:0;transform:scale(.4)}15%{opacity:1;transform:scale(1)}75%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.5) translateY(-40px)}}#wandTopBtn:active{transform:scale(.94)}';
    document.head.appendChild(st);
  }
  // sparkle burst right at the wand (doubled)
  if(btn){
    const syms=['✦','✧','⋆','✶','·'];
    const hues=['#ffe9b0','#c9a2ff','#7ee8ff','#f0c040'];
    for(let i=0;i<16;i++){
      const s=document.createElement('div');
      const ang=(Math.PI*2*i)/16+Math.random()*.4;
      const dist=22+Math.random()*34;
      s.textContent=syms[i%syms.length];
      s.style.cssText=`position:absolute;left:22px;top:8px;font-size:${(9+Math.random()*8).toFixed(0)}px;color:${hues[i%hues.length]};pointer-events:none;text-shadow:0 0 6px currentColor;--sx:${(Math.cos(ang)*dist).toFixed(0)}px;--sy:${(Math.sin(ang)*dist-16).toFixed(0)}px;animation:wandSparkPop .7s ease-out forwards;z-index:501`;
      btn.appendChild(s);
      setTimeout(()=>s.remove(),720);
    }
  }
  // slow, eased scroll to top, with sparkles shining through the page as it glides up
  const startY=window.scrollY||document.documentElement.scrollTop||0;
  const duration=1400;
  const startTime=performance.now();
  const easeInOutCubic=t=>t<0.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
  function spawnPageSparkle(){
    const syms=['✦','✧','⋆','✶','☆'];
    const hues=['#ffe9b0','#c9a2ff','#7ee8ff','#f0c040','#ffffff'];
    const s=document.createElement('div');
    const left=6+Math.random()*88;
    const top=8+Math.random()*80;
    s.textContent=syms[Math.floor(Math.random()*syms.length)];
    s.style.cssText=`position:fixed;left:${left}vw;top:${top}vh;font-size:${(10+Math.random()*12).toFixed(0)}px;color:${hues[Math.floor(Math.random()*hues.length)]};pointer-events:none;text-shadow:0 0 10px currentColor;z-index:499;animation:wandSparkleThrough ${(.7+Math.random()*.5).toFixed(2)}s ease-out forwards`;
    document.body.appendChild(s);
    setTimeout(()=>s.remove(),1300);
  }
  function tick(now){
    const elapsed=now-startTime;
    const t=Math.min(1,elapsed/duration);
    const eased=easeInOutCubic(t);
    window.scrollTo(0,startY*(1-eased));
    if(Math.random()<0.55)spawnPageSparkle();
    if(Math.random()<0.55)spawnPageSparkle();
    if(t<1)requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

// ═══ AI RELAY ═══
// This app never calls Gemini directly (that would expose an API key to
// anyone who opens the file). Instead every AI-powered tab calls a small
// relay you deploy yourself, which holds the key server-side. Paste your
// deployed relay's URL below — see MAGICS-SETUP.md for the two-minute
// Cloudflare Worker deploy steps.
const RELAY_URL = 'https://magics-relay.fegeralex233.workers.dev'; 

function relayConfigured(){return RELAY_URL && !RELAY_URL.includes('PASTE_YOUR_WORKER_URL');}

async function callRelay(body){
  let res;
  try{
    res=await fetch(RELAY_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  }catch(networkErr){
    // fetch() itself threw — the browser couldn't even reach the URL at all
    // (typo in the URL, no internet, or the Worker's CORS headers rejected us).
    throw new Error('NETWORK: could not reach '+RELAY_URL+' — '+(networkErr.message||networkErr));
  }
  const raw=await res.text();
  let data;
  try{data=JSON.parse(raw);}catch(parseErr){
    // The Worker responded, but not with JSON — likely a Cloudflare error page
    // (wrong URL, Worker not deployed, or it crashed before returning JSON).
    throw new Error('BADRESPONSE ('+res.status+'): '+raw.slice(0,200));
  }
  if(!res.ok||data.error)throw new Error((data.error||'Relay error')+' (HTTP '+res.status+')');
  return data;
}
