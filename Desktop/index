function summonDragonPortrait(){
  var name=(document.getElementById('dragonName')||{}).value||'';
  var sign=(document.getElementById('dragonSign')||{}).value||'Leo';
  var wish=(document.getElementById('dragonWish')||{}).value||'';
  if(!name.trim()){
    var inp=document.getElementById('dragonName');
    if(inp){inp.style.borderColor='#ff6060';inp.focus();}
    return;
  }
  var section=document.getElementById('dragonPortraitSection');
  var loading=document.getElementById('dragonPortraitLoading');
  var img=document.getElementById('dragonPortraitImg');
  var label=document.getElementById('dragonPortraitLabel');
  var traitBox=document.getElementById('dragonTraitBox');
  var traitText=document.getElementById('dragonTraitText');
  var wishDisplay=document.getElementById('dragonWishDisplay');
  var actionBtns=document.getElementById('dragonActionBtns');
  var saveBtn=document.getElementById('dragonSaveBtn');
  if(section) section.style.display='block';
  if(img){img.style.display='none';img.src='';}
  if(traitBox) traitBox.style.display='none';
  if(wishDisplay) wishDisplay.style.display='none';
  if(actionBtns) actionBtns.style.display='none';
  if(loading) loading.textContent='🐉 Reaching into the ancient realms... summoning your dragon...';
  if(label) label.textContent='🐉 Summoning '+name+'\'s Dragon...';
  section.scrollIntoView({behavior:'smooth',block:'start'});

  var dt=dragonZodiacTraits[sign]||{color:'#c84020',elem:'Fire',wing:'great crimson wings',scale:'jewel-colored scales',breath:'roaring magical fire'};
  var prompt='A breathtaking Pre-Raphaelite fantasy painting of a magnificent '
    +sign+' dragon. The dragon has '+dt.scale+', '+dt.wing
    +', and breathes '+dt.breath
    +'. It is majestic, powerful, and beautiful — a guardian and ancient protector, not a monster. '
    +'Style: Victorian fantasy illustration meets Pre-Raphaelite mastery. Rich jewel colors, luminous magical light. '
    +'Full dragon visible, regal pose, dramatic backdrop of mountains and sky, stars and nebula visible. No text anywhere in the image. Gallery quality fantasy art.';

  callRelay({kind:'image',prompt:prompt}).then(function(result){
    if(!result||!result.image) throw new Error('No image');
    var binary=atob(result.image);
    var bytes=new Uint8Array(binary.length);
    for(var i=0;i<binary.length;i++) bytes[i]=binary.charCodeAt(i);
    var blob=new Blob([bytes],{type:result.mimeType||'image/png'});
    var imgUrl=URL.createObjectURL(blob);
    window._dragonImgUrl=imgUrl;
    window._dragonName=name;
    window._dragonSign=sign;
    if(img){img.src=imgUrl;img.alt=name+'\'s dragon';img.style.display='block';}
    if(loading) loading.textContent='';
    if(label) label.textContent='🐉 '+name+'\'s '+sign+' Dragon 🐉';
    if(traitBox) traitBox.style.display='block';
    if(traitText){
      traitText.innerHTML='<strong style="color:#f0c060">'+sign+' Dragon</strong> &middot; Element: '+dt.elem
        +'<br>'+dt.wing.charAt(0).toUpperCase()+dt.wing.slice(1)
        +' &middot; '+dt.scale.charAt(0).toUpperCase()+dt.scale.slice(1)
        +'<br><em style="color:#a080c0">Breathes '+dt.breath+'</em>';
    }
    if(wish.trim()&&wishDisplay){
      wishDisplay.style.display='block';
      wishDisplay.innerHTML='"'+wish.trim()+'" — <em>sealed with dragon fire, carried to the realm of wishes</em>';
    }
    if(saveBtn){
      saveBtn.innerHTML='<a href="'+imgUrl+'" download="'+name.replace(/\s+/g,'-').toLowerCase()+'-'+sign.toLowerCase()+'-dragon.png" style="padding:.55rem 1.1rem;background:rgba(80,40,10,.7);color:#ffd080;border:1px solid rgba(160,80,20,.5);border-radius:20px;font-size:.82rem;font-family:Georgia,serif;cursor:pointer;text-decoration:none;display:inline-block">⬇ Save Dragon</a>';
    }
    if(actionBtns) actionBtns.style.display='flex';
    sprayFairyDust();
  }).catch(function(err){
    if(loading) loading.textContent='The dragon retreated into the mist. Try again — they are shy sometimes.';
    if(actionBtns) actionBtns.style.display='flex';
  });
}

function shareDragon(){
  var name=window._dragonName||'Your';
