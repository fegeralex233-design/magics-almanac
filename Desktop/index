      d.style.background = i === _carouselIdx ? '#c9a227' : 'rgba(201,162,39,.25)';
    });
  }
  function carouselNext() { carouselGo(_carouselIdx + 1); }
  function carouselInit() {
    var el = document.getElementById('featuredCarousel');
    if (!el) return;
    var startX = 0;
    el.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; }, {passive:true});
    el.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { if (dx < 0) carouselGo(_carouselIdx+1); else carouselGo(_carouselIdx-1); }
    }, {passive:true});
    if (_carouselTimer) clearInterval(_carouselTimer);
    _carouselTimer = setInterval(carouselNext, 4200);
  }

