        y: SH * 0.44 + (si / NSPK - 0.5) * SH * 0.8,
        rotSpeed: 0.018 + Math.random() * 0.01,
        vertSpeed: -(0.5 + Math.random() * 0.7),
        size: 1.2 + Math.random() * 2.5,
        op: 0.5 + Math.random() * 0.5,
        color: ["255,255,255","230,200,255","200,230,255","255,250,200"][Math.floor(Math.random()*4)],
        phase: Math.random() * Math.PI * 2,
        twinkle: 2 + Math.random() * 3
      });
      // DOWN spiral: orbits clockwise, drifts downward
      spirals.push({
        angle: (si / NSPK) * Math.PI * 2 + Math.PI,
        radius: 90 + Math.random() * 200,
        y: SH * 0.44 + (si / NSPK - 0.5) * SH * 0.8,
        rotSpeed: -(0.016 + Math.random() * 0.01),
        vertSpeed: (0.5 + Math.random() * 0.7),
        size: 1.2 + Math.random() * 2.5,
        op: 0.5 + Math.random() * 0.5,
        color: ["255,255,255","255,220,180","180,255,220","220,180,255"][Math.floor(Math.random()*4)],
        phase: Math.random() * Math.PI * 2,
        twinkle: 2 + Math.random() * 3
      });
    }
    var sparkT = 0;
    var cx = SW * 0.5, cy = SH * 0.44;
    function drawSwirl() {
      sparkT += 0.016;
      sctx.clearRect(0, 0, SW, SH);
      for (var si = 0; si < spirals.length; si++) {
        var sp = spirals[si];
        sp.angle += sp.rotSpeed;
        sp.y += sp.vertSpeed;
        // wrap vertically around fairy center
        if (sp.y < cy - SH * 0.55) sp.y = cy + SH * 0.55;
        if (sp.y > cy + SH * 0.55) sp.y = cy - SH * 0.55;
        var x = cx + Math.cos(sp.angle) * sp.radius;
        var tw = Math.sin(sparkT * sp.twinkle + sp.phase) * 0.35 + 0.65;
        var sz = sp.size * tw;
        sctx.beginPath();
        sctx.arc(x, sp.y, sz, 0, Math.PI * 2);
        sctx.fillStyle = "rgba(" + sp.color + "," + (sp.op * tw) + ")";
        sctx.fill();
        if (sp.size > 2) {
          sctx.strokeStyle = "rgba(" + sp.color + "," + (sp.op * tw * 0.5) + ")";
          sctx.lineWidth = 0.7;
          sctx.beginPath();
          sctx.moveTo(x - sz*2.5, sp.y); sctx.lineTo(x + sz*2.5, sp.y);
          sctx.moveTo(x, sp.y - sz*2.5); sctx.lineTo(x, sp.y + sz*2.5);
          sctx.stroke();
        }
      }
      sparkRaf = requestAnimationFrame(drawSwirl);
    }
    sparkRaf = requestAnimationFrame(drawSwirl);

    document.body.appendChild(ov);

    // Fade overlay in
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        ov.style.opacity = "1";
        // After overlay fades in (1s), fade in image and text
        setTimeout(function(){
          img.style.opacity = "1";
          txt.style.opacity = "1";
        }, 1000);
      });
    });

    // After 3.5s hold, do sparkle exit
    setTimeout(function(){
      // Create 25 sparkles
      var sparkChars = ["\u2726","\u2727","\u22c6"];
      for(var i = 0; i < 120; i++){
        (function(idx){
          var sp = document.createElement("span");
          sp.textContent = sparkChars[idx % sparkChars.length];
          var sx = Math.random() * 96 + 2;
          var sy = Math.random() * 96 + 2;
          var fsize = Math.round(Math.random() * 14 + 10);
          var delay = Math.random() * 0.3;
          var dx = (Math.random() - 0.5) * 40;
          var dy = (Math.random() - 0.5) * 40;
          sp.style.cssText = "position:absolute;left:" + sx + "%;top:" + sy + "%;font-size:" + fsize + "px;color:" + (idx % 3 === 0 ? "#ffe066" : "#ffffff") + ";opacity:0;pointer-events:none;transition:opacity 0.6s ease " + delay.toFixed(2) + "s, transform 0.6s ease " + delay.toFixed(2) + "s;transform:translate(0,0)";
          ov.appendChild(sp);
          requestAnimationFrame(function(){
            requestAnimationFrame(function(){
              sp.style.opacity = "1";
              sp.style.transform = "translate(" + dx + "px," + dy + "px)";
              setTimeout(function(){
                sp.style.opacity = "0";
              }, 300 + delay * 1000);
            });
          });
        })(i);
      }

      // Fade overlay out
      ov.style.transition = "opacity 0.8s ease";
      ov.style.opacity = "0";

      // Remove from DOM
      setTimeout(function(){
        cancelAnimationFrame(sparkRaf); if(ov.parentNode) ov.parentNode.removeChild(ov);
      }, 900);
    }, 7000);
  }, 1500);
})();
