function getBirthStars(dateStr){
  let seed=0;
  for(let i=0;i<dateStr.length;i++) seed=(seed*31+dateStr.charCodeAt(i))&0xffffffff;
  const rng=()=>{seed=(seed*1664525+1013904223)&0xffffffff;return(seed>>>0)/0xffffffff;};
  const constellationNames=['Orion','Cassiopeia','Ursa Major','Scorpius','Leo','Perseus',
    'Gemini','Aquarius','Sagittarius','Virgo','Pisces','Lyra','Taurus','Cygnus'];
  const [yr,mo,dy]=dateStr.split('-').map(Number);
  const dominant=constellationNames[(mo+2)%14];
  const secondary=constellationNames[(mo+8)%14];
  // Background field stars (random but seeded)
  const bgStars=Array.from({length:80},()=>({
    x:rng(),y:rng(),r:rng()*1.4+.3,
    bright:rng()>.82,
    col:['#ffd76a','#b0c8ff','#ffffff','#ffa8b0','#c0e8ff','#e0d0ff'][Math.floor(rng()*6)]
  }));
  return{bgStars,dominant,secondary};
}

// ── ANIMATED BIRTH SKY ──────────────────────────────────────────────
// Instead of a static canvas snapshot we render a live animated canvas:
// twinkling stars, periodic shooting stars, and the face gently pulsing
// in opacity so it feels like it's breathing inside the constellation.

let mirrorAnimRAF = null; // so we can stop the loop when navigating away

function startMirrorAnimation(canvasEl, img, birthStars, zodiacSign){
  // Stop any previous loop
  if(mirrorAnimRAF){ cancelAnimationFrame(mirrorAnimRAF); mirrorAnimRAF=null; }

  const W = canvasEl.width  = canvasEl.offsetWidth  || 480;
  const H = canvasEl.height = canvasEl.offsetHeight || 480;
  const ctx = canvasEl.getContext('2d');
  const DPR = Math.min(window.devicePixelRatio||1, 2);
  canvasEl.width  = W * DPR;
  canvasEl.height = H * DPR;
  canvasEl.style.width  = W + 'px';
  canvasEl.style.height = H + 'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);

  // ── Constellation geometry ──────────────────────────────────────
  const signKey = zodiacSign.charAt(0).toUpperCase() + zodiacSign.slice(1).toLowerCase();
  const constData = ZODIAC_CONSTELLATIONS[signKey] || ZODIAC_CONSTELLATIONS['Leo'];
  const pad = 0.12;
  const xs = constData.stars.map(p=>p[0]), ys = constData.stars.map(p=>p[1]);
  const minX=Math.min(...xs), maxX=Math.max(...xs), minY=Math.min(...ys), maxY=Math.max(...ys);
  const sc = Math.min((W*(1-pad*2))/(maxX-minX||1),(H*(1-pad*2))/(maxY-minY||1)) * 0.88;
  const offX=(W-(maxX-minX)*sc)/2 - minX*sc;
  const offY=(H-(maxY-minY)*sc)/2 - minY*sc;
  const toX = px => px*sc + offX;
  const toY = py => py*sc + offY;

  // ── Star field state (seeded, stable positions) ─────────────────
  const bgStars = birthStars.bgStars.map(s=>({
    x:s.x*W, y:s.y*H, r:s.r,
    bright:s.bright, col:s.col,
    phase: Math.random()*Math.PI*2,
    speed: 0.012 + Math.random()*0.025,
  }));

  // ── Shooting star state ─────────────────────────────────────────
  const makeShooter = () => {
    const side = Math.random() < 0.6; // mostly top-left to bottom-right
    const x1 = side ? Math.random()*W*0.5 : Math.random()*W;
    const y1 = side ? Math.random()*H*0.3 : Math.random()*H*0.2;
    const angle = (0.3 + Math.random()*0.5); // radians, roughly diagonal
    const len = 0.15 + Math.random()*0.2;
    return {
      x:x1, y:y1,
      dx: Math.cos(angle)*W*len,
      dy: Math.sin(angle)*H*len,
      life:0, maxLife: 55 + Math.floor(Math.random()*40),
      col: ['#ffffff','#e8e0ff','#ffe9b0'][Math.floor(Math.random()*3)],
      active: true,
    };
  };
  let shooters = [];
  let nextShooter = 60 + Math.floor(Math.random()*80); // frames until first shooter

  // ── Face pulse ──────────────────────────────────────────────────
  let facePhase = 0;

  let frame = 0;

  function draw(){
    ctx.clearRect(0,0,W,H);

    // 1. Night sky gradient
    const sky = ctx.createRadialGradient(W/2,H*0.28,0, W/2,H/2,Math.max(W,H)*0.9);
    sky.addColorStop(0,'#0e0535'); sky.addColorStop(0.45,'#06021c'); sky.addColorStop(1,'#010009');
    ctx.fillStyle=sky; ctx.fillRect(0,0,W,H);

    // 2. Twinkling background stars
    bgStars.forEach(s=>{
      s.phase += s.speed;
      const twinkle = 0.45 + 0.55*(0.5+0.5*Math.sin(s.phase));
      const r = s.r * 0.72;
      // Glow halo
      const gr = ctx.createRadialGradient(s.x,s.y,0,s.x,s.y,r*6);
      gr.addColorStop(0,s.col); gr.addColorStop(1,'rgba(0,0,0,0)');
      ctx.globalAlpha = (s.bright?0.5:0.22)*twinkle;
      ctx.beginPath(); ctx.arc(s.x,s.y,r*6,0,Math.PI*2);
      ctx.fillStyle=gr; ctx.fill();
      // Core
      ctx.globalAlpha = (s.bright?0.95:0.65)*twinkle;
      ctx.beginPath(); ctx.arc(s.x,s.y,r*(s.bright?1.1:0.7),0,Math.PI*2);
      ctx.fillStyle = s.bright?'#ffffff':s.col; ctx.fill();
    });
    // Extra hero star blooms
    bgStars.filter(s=>s.bright).forEach(s=>{
      const twinkle = 0.5+0.5*(0.5+0.5*Math.sin(s.phase*0.7+1.2));
      const r = s.r*2.2;
      const gr = ctx.createRadialGradient(s.x,s.y,0,s.x,s.y,r*8);
      gr.addColorStop(0,'rgba(255,248,220,0.8)');
      gr.addColorStop(0.15,'rgba(200,180,255,0.4)');
      gr.addColorStop(1,'rgba(120,80,255,0)');
      ctx.globalAlpha=0.8*twinkle;
      ctx.beginPath();ctx.arc(s.x,s.y,r*8,0,Math.PI*2);
      ctx.fillStyle=gr;ctx.fill();
    });
    ctx.globalAlpha=1;

    // 3. Zodiac constellation lines + stars
    ctx.save(); ctx.lineCap='round';
    constData.lines.forEach(([a,b])=>{
      const x1=toX(constData.stars[a][0]),y1=toY(constData.stars[a][1]);
      const x2=toX(constData.stars[b][0]),y2=toY(constData.stars[b][1]);
      // Outer glow
      ctx.strokeStyle='rgba(160,130,255,0.16)'; ctx.lineWidth=Math.max(W,H)*.022;
      ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
      // Mid
      ctx.strokeStyle='rgba(200,180,255,0.26)'; ctx.lineWidth=Math.max(W,H)*.009;
      ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
      // Core
      ctx.strokeStyle='rgba(230,215,255,0.52)'; ctx.lineWidth=Math.max(W,H)*.003;
      ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
    });
    constData.stars.forEach(p=>{
      const x=toX(p[0]),y=toY(p[1]);
      const pulse = 0.82+0.18*Math.sin(frame*0.04+p[0]*0.1);
      const sr=Math.max(W,H)*.038*pulse;
      const gr=ctx.createRadialGradient(x,y,0,x,y,sr);
      gr.addColorStop(0,'rgba(220,200,255,0.72)');
      gr.addColorStop(0.25,'rgba(180,150,255,0.32)');
      gr.addColorStop(0.6,'rgba(140,100,255,0.1)');
      gr.addColorStop(1,'rgba(100,60,255,0)');
      ctx.fillStyle=gr;ctx.beginPath();ctx.arc(x,y,sr,0,Math.PI*2);ctx.fill();
      const coreSr=Math.max(W,H)*.009*pulse;
      const gr2=ctx.createRadialGradient(x,y,0,x,y,coreSr*2);
      gr2.addColorStop(0,'rgba(255,252,240,1)');
      gr2.addColorStop(0.5,'rgba(220,200,255,0.8)');
      gr2.addColorStop(1,'rgba(180,140,255,0)');
      ctx.fillStyle=gr2;ctx.beginPath();ctx.arc(x,y,coreSr*2,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='#ffffff';ctx.beginPath();ctx.arc(x,y,coreSr*.5,0,Math.PI*2);ctx.fill();
    });
    ctx.restore();

    // 4. Ghost face — breathes in and out of the darkness
    facePhase += 0.008;
    const faceAlpha = 0.16 + 0.10*(0.5+0.5*Math.sin(facePhase));
    ctx.save();
    ctx.globalAlpha = faceAlpha;
    ctx.globalCompositeOperation = 'screen';
    ctx.drawImage(img,0,0,W,H);
    ctx.restore();

    // Vignette over the face blend
    const vig=ctx.createRadialGradient(W/2,H*.4,H*.06,W/2,H/2,H*.66);
    vig.addColorStop(0,'rgba(6,1,22,0)');
    vig.addColorStop(0.48,'rgba(6,1,22,0.08)');
    vig.addColorStop(1,'rgba(2,0,10,0.88)');
    ctx.fillStyle=vig;ctx.fillRect(0,0,W,H);

    // 5. Shooting stars
    frame++;
    nextShooter--;
    if(nextShooter<=0){
      shooters.push(makeShooter());
      nextShooter = 90 + Math.floor(Math.random()*120);
    }
    shooters = shooters.filter(m=>m.active);
    shooters.forEach(m=>{
      m.life++;
      const t = m.life/m.maxLife;
      if(t>=1){m.active=false;return;}
      // Head position
      const hx=m.x+m.dx*t, hy=m.y+m.dy*t;
      // Tail starts further behind
      const tailT=Math.max(0,t-0.35);
      const tx=m.x+m.dx*tailT, ty=m.y+m.dy*tailT;
      // Fade in then out
      const alpha = t<0.15?t/0.15 : t>0.75?(1-t)/0.25 : 1;
      ctx.save();
      // Trail gradient
      const trail=ctx.createLinearGradient(tx,ty,hx,hy);
      trail.addColorStop(0,'rgba(255,255,255,0)');
      trail.addColorStop(0.4,'rgba(255,255,255,'+(0.15*alpha)+')');
      trail.addColorStop(1,'rgba(255,255,255,'+(0.92*alpha)+')');
      ctx.strokeStyle=trail;
      ctx.lineWidth=Math.max(W,H)*.0038;
      ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(tx,ty);ctx.lineTo(hx,hy);ctx.stroke();
      // Sparkle trail dots
      for(let i=0;i<6;i++){
        const f=0.3+i*0.12;
        const sx=m.x+m.dx*(tailT+(t-tailT)*f);
        const sy=m.y+m.dy*(tailT+(t-tailT)*f);
        const drift=(i%3-1)*Math.max(W,H)*.006;
        ctx.globalAlpha=(1-f)*0.6*alpha;
        ctx.beginPath();ctx.arc(sx+drift,sy+drift,Math.max(W,H)*.003*(1-f*0.5),0,Math.PI*2);
        ctx.fillStyle='#ffffff';ctx.fill();
      }
      // Head glow
      const headGr=ctx.createRadialGradient(hx,hy,0,hx,hy,Math.max(W,H)*.02);
      headGr.addColorStop(0,'rgba(255,255,255,'+(0.95*alpha)+')');
      headGr.addColorStop(0.3,'rgba(220,200,255,'+(0.6*alpha)+')');
      headGr.addColorStop(1,'rgba(160,120,255,0)');
      ctx.globalAlpha=1;
      ctx.beginPath();ctx.arc(hx,hy,Math.max(W,H)*.02,0,Math.PI*2);
      ctx.fillStyle=headGr;ctx.fill();
      ctx.fillStyle='#ffffff';ctx.beginPath();ctx.arc(hx,hy,Math.max(W,H)*.004,0,Math.PI*2);ctx.fill();
      ctx.restore();
    });

    if(!document.hidden) mirrorAnimRAF=requestAnimationFrame(draw);
  }

  draw();
}

