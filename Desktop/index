    +'<ellipse cx="50" cy="74" rx="18" ry="13" fill="#2a8c60" />'
    +'<ellipse cx="50" cy="74" rx="16" ry="11" fill="#3ab87c" />'
    +'<ellipse cx="50" cy="76" rx="10" ry="7" fill="#4ed491" opacity=".35" />'
    +'<path d="M60 82 Q76 88 78 80 Q80 72 68 74" stroke="#2a8c60" stroke-width="8" fill="none" stroke-linecap="round"/>'
