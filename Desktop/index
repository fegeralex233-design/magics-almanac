function toggleSymbol(sym,btn){
  if(symbolSel.includes(sym)){
    symbolSel=symbolSel.filter(s=>s!==sym);
    btn.style.background='#120228';btn.style.color='#ffffff';btn.style.borderColor='#4a2080';
  } else {
    if(symbolSel.length>=2){alert('Choose up to 2 symbols to combine.');return;}
    symbolSel.push(sym);
    btn.style.background='#2a0a50';btn.style.color='var(--gold)';btn.style.borderColor='var(--gold)';
  }
  const sel=document.getElementById('comboSelected');
  if(sel) sel.textContent=symbolSel.join(' + ')||'—';
}

