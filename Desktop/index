function wzSpellBuildKeyboard(targetWord,t){
  var kb=document.getElementById('wz-spl-keyboard');
  if(!kb)return;
  kb.innerHTML='';
  var needed=targetWord.split('');
  var all='ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
  var extras=all.filter(function(c){return needed.indexOf(c)===-1;});
  extras.sort(function(){return Math.random()-0.5;});
  var poolSize=Math.max(14,needed.length+8);
  var pool=needed.concat(extras.slice(0,poolSize-needed.length));
  pool.sort(function(){return Math.random()-0.5;});
  pool.forEach(function(lt){
    var bt=document.createElement('button');
    bt.textContent=lt;
    bt.dataset.letter=lt;
    bt.style.cssText='background:rgba(0,0,0,.35);border:1px solid '+t.border+';border-radius:6px;padding:.4rem;color:'+t.textColor+';font-size:.85rem;cursor:pointer;font-family:Georgia,serif;font-weight:bold;transition:all .2s';
    bt.onclick=function(){wzSpellTap(lt,bt);};
    kb.appendChild(bt);
  });
}

function wzSpellTap(letter,btn){
  var t=wzGetTheme(wzSpellRound);
  var entry=wzSpellList[wzSpellIdx];
  var target=entry.word;
  var pos=wzSpellTyped.length;
  if(pos>=target.length)return;
  if(letter===target[pos]){
    wzSpellTyped.push(letter);
    var box=document.getElementById('spl-box-'+pos);
    if(box){box.textContent=letter;box.style.borderColor='#40d080';box.style.color='#7DF9A0';}
    if(btn){btn.style.background='#0a4020';btn.disabled=true;}
    if(wzSpellTyped.length===target.length){
      wzSpellScore++;
      var msg=document.getElementById('wz-spl-msg');
      var sc=document.getElementById('wz-spl-score');
      var praises=['✨ Incredible!','🌟 You spelled it!','📜 Perfect cast!','⭐ Magical!','💫 Brilliant!'];
      var p=praises[Math.floor(Math.random()*praises.length)];
      if(msg)msg.innerHTML='<span style="color:#7DF9A0">'+p+' '+target+' is correct!</span>';
      if(sc)sc.textContent='Score: '+wzSpellScore+' · Word: '+wzSpellRound+' of 8';
      var kb=document.getElementById('wz-spl-keyboard');
      if(kb)kb.querySelectorAll('button').forEach(function(b){b.disabled=true;});
      wzSparkle('wz-spl-card');
      setTimeout(wzSpellNextWord,1500);
    }
  } else {
    var box=document.getElementById('spl-box-'+pos);
    if(box){
      var origColor=box.style.color;
      var origBorder=box.style.borderColor;
      box.textContent=letter;
      box.style.borderColor='#d04040';
      box.style.color='#ff8080';
      setTimeout(function(){
        box.textContent='_';
        box.style.borderColor=t.border;
        box.style.color=t.textColor;
      },550);
    }
    if(btn){
      btn.style.background='#4a0a0a';
      setTimeout(function(){btn.style.background='rgba(0,0,0,.35)';},500);
    }
  }
}

