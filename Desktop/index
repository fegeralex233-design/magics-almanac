// Realm color map
var REALM_COLORS={circle:'#00ffc8',triangle:'#ff8080',pentagon:'#90a8ff'};
var REALM_ANIMS={circle:'realm-flashing-circle',triangle:'realm-flashing-triangle',pentagon:'realm-flashing-pentagon'};

function realmFlash(realm,e){
  if(e)e.stopPropagation();
  var el=document.getElementById('realmCircle');
  if(realm==='triangle')el=document.getElementById('realmTriangle');
  if(realm==='pentagon')el=document.getElementById('realmPentagon');
  if(!el)return;
  el.classList.remove('realm-flashing-circle','realm-flashing-triangle','realm-flashing-pentagon');
  void el.offsetWidth;
  el.classList.add(REALM_ANIMS[realm]);
  // Shoot sparks
  var sparkChars=['✦','✧','⋆','★','·','✶','⁕','✵'];
  for(var i=0;i<10;i++){
    (function(i){
      setTimeout(function(){
        var sp=document.createElement('span');
        sp.className='realm-spark';
        sp.textContent=sparkChars[Math.floor(Math.random()*sparkChars.length)];
        sp.style.color=REALM_COLORS[realm];
        sp.style.left=(10+Math.random()*80)+'%';
        sp.style.top=(10+Math.random()*80)+'%';
        var angle=Math.random()*Math.PI*2;
        var dist=30+Math.random()*50;
        sp.style.setProperty('--dx',(Math.cos(angle)*dist)+'px');
        sp.style.setProperty('--dy',(Math.sin(angle)*dist)+'px');
        el.appendChild(sp);
        setTimeout(function(){sp.remove();},900);
      },i*60);
    })(i);
  }
  // Also pulse the icon
  var icon=document.getElementById('realmCircleIcon');
  if(realm==='triangle')icon=document.getElementById('realmTriangleIcon');
  if(realm==='pentagon')icon=document.getElementById('realmPentagonIcon');
  if(icon){
    icon.style.transform='scale(1.5) rotate(20deg)';
    icon.style.filter='drop-shadow(0 0 8px '+REALM_COLORS[realm]+')';
    setTimeout(function(){icon.style.transform='';icon.style.filter='';},900);
  }
  setTimeout(function(){el.classList.remove(REALM_ANIMS[realm]);},950);
}

