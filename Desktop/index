      vx: (Math.random()-0.5)*0.3, vy: -(0.12+Math.random()*0.22),
      alpha: 0, targetAlpha: 0.18+Math.random()*0.32,
      size: isSpell ? 14+Math.random()*10 : 18+Math.random()*32,
      rot: (Math.random()-0.5)*0.4, rotSpeed: (Math.random()-0.5)*0.004,
      col: randCol(1),
      isSpell,
      life: 0, maxLife: 280+Math.random()*200,
    };
  }

  function spawnShooter(){
    const x1 = Math.random()*W*0.7;
    const y1 = Math.random()*H*0.4;
    const angle = 0.3+Math.random()*0.5;
    return {
      x:x1, y:y1, vx:Math.cos(angle)*1.8, vy:Math.sin(angle)*1.8,
      trail:[], life:0, maxLife:55+Math.random()*40,
      bright:Math.random()<0.3,
    };
  }

  function init(){
    W=canvas.width=window.innerWidth;
    H=canvas.height=window.innerHeight;
    const dpr=Math.min(window.devicePixelRatio||1,2);
    canvas.width=Math.round(W*dpr); canvas.height=Math.round(H*dpr);
    canvas.style.width=W+'px'; canvas.style.height=H+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
    // Seed particles
    particles=Array.from({length:120},spawnParticle);
    // Seed a handful of symbols already on screen
    symbols=Array.from({length:22},()=>{
      const s=spawnSymbol();
      s.x=Math.random()*W; s.y=Math.random()*H;
      s.alpha=s.targetAlpha*Math.random();
      return s;
    });
    shooters=[];
  }

  let frame=0;
  function draw(){
    if(!active)return;
    frame++;
    ctx.clearRect(0,0,W,H);

    // ── Deep magic background ──
    const bg=ctx.createLinearGradient(0,0,0,H);
    bg.addColorStop(0,'#04000e');
    bg.addColorStop(0.5,'#080120');
    bg.addColorStop(1,'#0c0428');
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

    // ── Star particles ──
    for(const p of particles){
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<-4)p.x=W+4; if(p.x>W+4)p.x=-4;
      if(p.y<-4)p.y=H+4; if(p.y>H+4)p.y=-4;
      p.twinkle+=p.twinkleSpeed;
      const a=p.alpha*(0.55+0.45*Math.sin(p.twinkle));
      ctx.save();
      ctx.globalAlpha=a;
      ctx.shadowBlur=p.r*4; ctx.shadowColor=p.col;
      ctx.fillStyle=p.col;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }

    // ── Floating arcane symbols & spell words ──
    // Occasionally spawn a new one
    if(frame%90===0 && symbols.length<28) symbols.push(spawnSymbol());

    for(let i=symbols.length-1;i>=0;i--){
      const s=symbols[i];
      s.life++;
      s.x+=s.vx; s.y+=s.vy;
      s.rot+=s.rotSpeed;
      // Fade in / out
      if(s.life<40) s.alpha=Math.min(s.targetAlpha,s.alpha+s.targetAlpha/40);
      else if(s.life>s.maxLife-50) s.alpha=Math.max(0,s.alpha-s.targetAlpha/50);
      if(s.life>=s.maxLife || s.y<-60){ symbols.splice(i,1); continue; }
      ctx.save();
      ctx.globalAlpha=s.alpha;
      ctx.translate(s.x,s.y); ctx.rotate(s.rot);
      ctx.shadowBlur=s.isSpell?8:14; ctx.shadowColor=s.col;
      ctx.fillStyle=s.col;
      ctx.font=s.isSpell
        ? `italic ${s.size}px Georgia,serif`
        : `${s.size}px serif`;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText(s.text,0,0);
      ctx.restore();
    }

    // ── Shooting stars ──
    const sec=Date.now()/1000;
    if(sec-lastShoot>90+Math.random()*90 && shooters.length<2){
      lastShoot=sec; shooters.push(spawnShooter());
    }
    for(let i=shooters.length-1;i>=0;i--){
      const s=shooters[i];
      s.life++; s.trail.push({x:s.x,y:s.y});
      if(s.trail.length>16)s.trail.shift();
      s.x+=s.vx; s.y+=s.vy;
      const pr=s.life/s.maxLife;
      const a=pr<0.2?pr/0.2:pr>0.65?(1-pr)/0.35:1;
      if(s.trail.length>1){
        ctx.save();
        const g=ctx.createLinearGradient(s.trail[0].x,s.trail[0].y,s.x,s.y);
        g.addColorStop(0,'rgba(255,255,255,0)');
        g.addColorStop(0.6,`rgba(220,225,255,${a*0.3})`);
        g.addColorStop(1,`rgba(240,248,255,${a*0.85})`);
        ctx.strokeStyle=g; ctx.lineWidth=s.bright?1.6:0.9;
        ctx.shadowBlur=s.bright?10:5; ctx.shadowColor='rgba(200,215,255,0.8)';
        ctx.beginPath(); ctx.moveTo(s.trail[0].x,s.trail[0].y);
        for(const t of s.trail)ctx.lineTo(t.x,t.y);
        ctx.lineTo(s.x,s.y); ctx.stroke(); ctx.restore();
      }
      if(s.life>=s.maxLife||s.x>W+20||s.y>H+20)shooters.splice(i,1);
    }

    if(active&&!document.hidden)raf=requestAnimationFrame(draw);
  }

  function start(){
    if(active)return; // already running
    canvas=document.getElementById('magicBg');
    if(!canvas)return;
    ctx=canvas.getContext('2d');
    active=true;
    init();
    if(raf===null)raf=requestAnimationFrame(draw);
  }

  function stop(){
    // keep running — it's a persistent background
  }

  window.addEventListener('resize',()=>{if(active)init();});

  return{start,stop};
})();

