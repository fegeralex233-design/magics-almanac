  const recipient=document.getElementById('wishRecipient').value.trim()||'someone special';
  const message=document.getElementById('wishMessage').value.trim();
  wishBuilding=true;
  const loadEl=document.getElementById('wishLoading');
  const loadMsg=document.getElementById('wishLoadMsg');
  const resEl=document.getElementById('wishResult');
  loadEl.style.display='block';resEl.innerHTML='';

  const wi=wishIntentions.find(w=>w.label===wishIntention)||wishIntentions[0];

  // Get AI text portrait
  if(loadMsg) loadMsg.textContent='The fairy is forming from your wish…';
  let fairyName='',paintingTitle='',appearance='',wishText='',signature='';
