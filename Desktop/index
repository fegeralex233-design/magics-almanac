var _elfTimer=null, _elfActive=false, _elfFound=0, _elfElapsed=0, _elfEX=0, _elfEY=0, _elfSeed=0;

function elfDrawScene(showElf, ex, ey){
  var cv=document.getElementById('elf-canvas');
  if(!cv)return;
  var ctx=cv.getContext('2d');
  var W=cv.width, H=cv.height;
  // Sky
  var sky=ctx.createLinearGradient(0,0,0,H*0.38);
  sky.addColorStop(0,'#0a1f05');
  sky.addColorStop(1,'#143a0c');
  ctx.fillStyle=sky; ctx.fillRect(0,0,W,H*0.38);
  // Ground
  var gnd=ctx.createLinearGradient(0,H*0.38,0,H);
  gnd.addColorStop(0,'#0d2a08');
  gnd.addColorStop(1,'#06180a');
  ctx.fillStyle=gnd; ctx.fillRect(0,H*0.38,W,H*0.62);
  // Stars
  var stars=[[20,12],[60,8],[110,18],[160,6],[220,14],[280,9],[320,16],[50,25],[140,22],[240,20],[300,24]];
  stars.forEach(function(s){
    ctx.fillStyle='rgba(200,255,180,'+(0.15+Math.random()*0.2)+')';
    ctx.beginPath(); ctx.arc(s[0],s[1],0.8,0,Math.PI*2); ctx.fill();
  });
  // Moon
  ctx.fillStyle='rgba(220,255,200,0.18)';
  ctx.beginPath(); ctx.arc(W-36,22,14,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='rgba(10,30,8,0.85)';
  ctx.beginPath(); ctx.arc(W-30,20,12,0,Math.PI*2); ctx.fill();
  // Draw trees
  function drawTree(x, h, w, dark){
    var col=dark?'#0a2208':'#0e3010';
    var col2=dark?'#061505':'#091f07';
    // trunk
    ctx.fillStyle='#1a0e05';
    ctx.fillRect(x-4,H*0.35+h*0.7,8,H*0.65-h*0.7);
    // layers
    for(var i=0;i<4;i++){
      var ly=H*0.35+h*(i/4);
      var lw=w*(1-(i*0.15));
      ctx.fillStyle=i%2===0?col:col2;
      ctx.beginPath();
      ctx.moveTo(x-lw/2,ly+h/4);
      ctx.lineTo(x,ly);
      ctx.lineTo(x+lw/2,ly+h/4);
      ctx.closePath(); ctx.fill();
    }
  }
  // background trees (dark)
  [[20,80,55,true],[70,100,65,true],[130,90,60,true],[190,105,70,true],[250,85,58,true],[305,95,62,true]].forEach(function(t){drawTree(t[0],t[1],t[2],t[3]);});
  // foreground trees (slightly lighter)
  [[0,130,80,false],[85,140,90,false],[170,125,78,false],[255,138,85,false],[335,132,82,false]].forEach(function(t){drawTree(t[0],t[1],t[2],t[3]);});
  // Grass tufts
  ctx.fillStyle='#0d2a0a';
  ctx.fillRect(0,H*0.62,W,H*0.38);
  for(var g=0;g<W;g+=6){
    var gh=4+Math.floor(((g*7+13)%5));
    ctx.fillStyle=g%12===0?'#1a4a10':'#123808';
    ctx.fillRect(g,H*0.62-gh,3,gh+2);
  }
  // Mushrooms
  function drawMushroom(mx,my){
    ctx.fillStyle='#8a1010'; ctx.beginPath(); ctx.ellipse(mx,my-6,8,6,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#fff'; ctx.beginPath(); ctx.ellipse(mx-2,my-8,1.5,1.5,0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(mx+2,my-6,1,1,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#e8d0b0'; ctx.fillRect(mx-3,my-2,6,8);
  }
  [[40,H*0.70],[100,H*0.74],[200,H*0.68],[290,H*0.72],[180,H*0.78]].forEach(function(m){drawMushroom(m[0],m[1]);});
  // Fireflies
  for(var f=0;f<8;f++){
    var fx=30+f*38+((Date.now()/400+f*17)%20)-10;
    var fy=H*0.42+f*10+(Math.sin(Date.now()/600+f)*8);
    ctx.fillStyle='rgba(200,255,100,0.6)';
    ctx.beginPath(); ctx.arc(fx,fy,1.5,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='rgba(200,255,100,0.15)';
    ctx.beginPath(); ctx.arc(fx,fy,4,0,Math.PI*2); ctx.fill();
  }
  // Draw elf — hidden in foliage with low opacity unless found
  if(showElf){
    ctx.save();
    ctx.globalAlpha=0.18; // very hard to see
    elfDrawElf(ctx,ex,ey,0.9);
    ctx.restore();
  }
}

function elfDrawElf(ctx,x,y,scale){
  scale=scale||1;
  // tiny green elf figure
  var s=scale;
  // hat (pointy green)
  ctx.fillStyle='#2a7a20';
  ctx.beginPath();
  ctx.moveTo(x,y-22*s); ctx.lineTo(x-7*s,y-8*s); ctx.lineTo(x+7*s,y-8*s);
  ctx.closePath(); ctx.fill();
  ctx.fillStyle='#1a5a10';
  ctx.fillRect(x-8*s,y-9*s,16*s,3*s);
  // face
  ctx.fillStyle='#d4a870';
  ctx.beginPath(); ctx.arc(x,y-3*s,7*s,0,Math.PI*2); ctx.fill();
  // eyes
  ctx.fillStyle='#1a0a00';
  ctx.beginPath(); ctx.arc(x-2.5*s,y-4*s,1.2*s,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x+2.5*s,y-4*s,1.2*s,0,Math.PI*2); ctx.fill();
  // smile
  ctx.strokeStyle='#8a3a00'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.arc(x,y-2*s,3*s,0.2,Math.PI-0.2); ctx.stroke();
  // ears (pointy)
  ctx.fillStyle='#d4a870';
  ctx.beginPath(); ctx.moveTo(x-7*s,y-3*s); ctx.lineTo(x-12*s,y-7*s); ctx.lineTo(x-6*s,y+1*s); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(x+7*s,y-3*s); ctx.lineTo(x+12*s,y-7*s); ctx.lineTo(x+6*s,y+1*s); ctx.closePath(); ctx.fill();
  // body (green tunic)
  ctx.fillStyle='#2a6a18';
  ctx.beginPath(); ctx.moveTo(x-8*s,y+4*s); ctx.lineTo(x-10*s,y+24*s); ctx.lineTo(x+10*s,y+24*s); ctx.lineTo(x+8*s,y+4*s); ctx.closePath(); ctx.fill();
  // belt
  ctx.fillStyle='#5a3a10';
  ctx.fillRect(x-10*s,y+17*s,20*s,3*s);
  // legs
  ctx.fillStyle='#1a4a10';
  ctx.fillRect(x-8*s,y+24*s,6*s,12*s);
  ctx.fillRect(x+2*s,y+24*s,6*s,12*s);
  // shoes (curled)
  ctx.fillStyle='#8a3a00';
  ctx.beginPath(); ctx.ellipse(x-5*s,y+37*s,5*s,3*s,0,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(x+5*s,y+37*s,5*s,3*s,0,0,Math.PI*2); ctx.fill();
  // arms
  ctx.fillStyle='#2a6a18';
  ctx.fillRect(x-18*s,y+6*s,10*s,4*s);
  ctx.fillRect(x+8*s,y+6*s,10*s,4*s);
}

function elfStart(){
  var btn=document.getElementById('elf-start-btn');
  if(btn)btn.style.display='none';
  var hint=document.getElementById('elf-hint');
  if(hint)hint.textContent='He is hiding somewhere in the forest...';
  _elfFound=0; _elfElapsed=0; _elfActive=true;
  _elfSeed=Math.floor(Math.random()*10000);
  elfPlaceElf();
  if(_elfTimer)clearInterval(_elfTimer);
  _elfTimer=setInterval(function(){
    if(!_elfActive)return;
    _elfElapsed++;
    var t=document.getElementById('elf-time');
    if(t)t.textContent=Math.max(0,40-_elfElapsed);
    elfDrawScene(true,_elfEX,_elfEY);
    if(_elfElapsed>=40){
      clearInterval(_elfTimer); _elfActive=false;
      var msg=document.getElementById('elf-msg');
      if(msg)msg.innerHTML='<span style="color:#80e890">Time\'s up! You found <strong>'+_elfFound+'</strong> elf'+(+_elfFound===1?'':'s')+'! He is a sneaky one.</span>';
      var cv=document.getElementById('elf-canvas');
      if(cv){var ctx=cv.getContext('2d');ctx.save();ctx.globalAlpha=1;elfDrawElf(ctx,_elfEX,_elfEY,0.9);ctx.restore();}
      var hint2=document.getElementById('elf-hint');
      if(hint2)hint2.style.display='none';
      // show play again
      var btn2=document.getElementById('elf-start-btn');
      if(btn2){btn2.style.display='inline-block';btn2.textContent='Play Again!';}
    }
  },1000);
  var cv=document.getElementById('elf-canvas');
  if(cv){
    cv.onclick=null;
    cv.addEventListener('click',elfTap,{once:false});
  }
  elfAnimLoop();
}

function elfPlaceElf(){
  // Place elf in foliage area — varies each round
  var zones=[[30,80,H_ELF(0.38),H_ELF(0.62)],[90,150,H_ELF(0.38),H_ELF(0.62)],[160,220,H_ELF(0.40),H_ELF(0.60)],[230,290,H_ELF(0.38),H_ELF(0.58)],[295,340,H_ELF(0.38),H_ELF(0.62)]];
  var z=zones[Math.floor(Math.random()*zones.length)];
  _elfEX=z[0]+Math.floor(Math.random()*(z[1]-z[0]));
  _elfEY=z[2]+Math.floor(Math.random()*(z[3]-z[2]));
}
function H_ELF(p){return Math.floor(260*p);}

var _elfAnimId=null;
function elfAnimLoop(){
  if(!_elfActive)return;
  elfDrawScene(true,_elfEX,_elfEY);
  _elfAnimId=requestAnimationFrame(elfAnimLoop);
}

function elfTap(e){
  if(!_elfActive)return;
  var cv=document.getElementById('elf-canvas');
  if(!cv)return;
  var rect=cv.getBoundingClientRect();
  var scaleX=cv.width/rect.width;
  var scaleY=cv.height/rect.height;
  var cx=(e.clientX-rect.left)*scaleX;
  var cy=(e.clientY-rect.top)*scaleY;
  var dist=Math.sqrt((cx-_elfEX)*(cx-_elfEX)+(cy-_elfEY)*(cy-_elfEY));
  if(dist<28){
    // Found it!
    _elfFound++;
    var sc=document.getElementById('elf-score');
    if(sc)sc.textContent=_elfFound;
    var msg=document.getElementById('elf-msg');
    if(msg)msg.innerHTML='<span style="color:#c8ffa0">You found him! &#9733;</span>';
    // Flash elf
    var ctx2=cv.getContext('2d');
    ctx2.save(); ctx2.globalAlpha=1; elfDrawElf(ctx2,_elfEX,_elfEY,0.9); ctx2.restore();
    setTimeout(function(){
      if(_elfActive){
        var msg2=document.getElementById('elf-msg');
        if(msg2)msg2.innerHTML='';
        elfPlaceElf();
      }
    },900);
  } else {
    var msg3=document.getElementById('elf-msg');
    if(msg3){msg3.innerHTML='<span style="color:rgba(160,255,140,.5)">Not there... look in the shadows!</span>';}
  }
}

