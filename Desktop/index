function summonSeaCreature(depthId){
  var depths=window._seaDepths||[];
  var depth=null;
  for(var i=0;i<depths.length;i++){if(depths[i].id===depthId){depth=depths[i];break;}}
  if(!depth)return;
  window._lastSeaDepth=depthId;
  var result=document.getElementById('seaCreatureResult');
  var loading=document.getElementById('seaCreatureLoading');
  var img=document.getElementById('seaCreatureImg');
  var label=document.getElementById('seaCreatureLabel');
  var actions=document.getElementById('seaCreatureActions');
  var save=document.getElementById('seaCreatureSave');
  if(result) result.style.display='block';
  if(img){img.style.display='none';img.src='';}
  if(actions) actions.style.display='none';
  if(loading) loading.textContent='Diving into the '+depth.label+'... '+depth.emoji;
  if(label) label.textContent='';
  result.scrollIntoView({behavior:'smooth',block:'start'});

  callRelay({kind:'image',prompt:depth.prompt}).then(function(res){
    if(!res||!res.image) throw new Error('No image');
    var binary=atob(res.image);
    var bytes=new Uint8Array(binary.length);
    for(var i=0;i<binary.length;i++) bytes[i]=binary.charCodeAt(i);
    var blob=new Blob([bytes],{type:res.mimeType||'image/png'});
    var url=URL.createObjectURL(blob);
    window._lastSeaImgUrl=url;
    if(img){img.src=url;img.alt='Deep sea creature from '+depth.label;img.style.display='block';}
    if(loading) loading.textContent='';
    if(label) label.textContent=depth.emoji+' Creature from the '+depth.label+' ('+depth.depth+')';
    if(save) save.innerHTML='<a href="'+url+'" download="deep-sea-'+depthId+'.png" style="padding:.45rem 1rem;background:rgba(0,20,50,.7);color:#60c0e0;border:1px solid rgba(40,100,160,.4);border-radius:20px;font-size:.78rem;font-family:Georgia,serif;text-decoration:none;display:inline-block">⬇ Save</a>';
    if(actions) actions.style.display='block';
    sprayFairyDust();
  }).catch(function(){
    if(loading) loading.textContent='The creature retreated into the deep. Try diving again.';
    if(actions) actions.style.display='block';
  });
}


