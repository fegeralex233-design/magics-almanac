function calSaveEntry(){
  const name=(document.getElementById('calAddName')||{}).value||'';
  const date=(document.getElementById('calAddDate')||{}).value||'';
  const note=(document.getElementById('calAddNote')||{}).value||'';
  const recurring=(document.getElementById('calAddRecurring')||{}).checked||false;
  const type=window._calSelType||'card';
  if(!name.trim()||!date){alert('Please enter a name and date.');return;}
  const typeIcons={birthday:'🎂',seance:'🕯️',grimoire:'📖',amulet:'⊕',card:'✦'};
  const entries=calLoad();
  entries.push({id:Date.now().toString(),name:name.trim(),date,note:note.trim(),type,recurring,icon:typeIcons[type]||'✦'});
  calSave(entries);
  document.getElementById('calAddForm').style.display='none';
  renderMagicCalendar();
}
function calDeleteEntry(id){
  if(!id)return;
  const entries=calLoad().filter(e=>e.id!==id);
  calSave(entries);
  renderMagicCalendar();
}
function calSendGreeting(ev){
  const type=ev.type||'card';
  const tmpl=CAL_GREETINGS[type]||CAL_GREETINGS.card;
  const subject=encodeURIComponent(tmpl.subject);
  const body=encodeURIComponent(tmpl.body(ev.name,ev.note));
  window.location.href=`mailto:?subject=${subject}&body=${body}`;
}
function calSendMagicGreeting(ev){
  const typeMap={sabbat:'seance',solar:'seance',holiday:'card',musician:'card',mystic:'seance',legend:'card',numbers:'card'};
  const type=typeMap[ev.type]||'card';
  const tmpl=CAL_GREETINGS[type]||CAL_GREETINGS.card;
  const subject=encodeURIComponent(`${ev.icon||'✦'} ${ev.name} — A Magical Invitation`);
  const body=encodeURIComponent(`You are invited to join in the celebration of ${ev.name}.\n\n${ev.note||''}\n\n${tmpl.body('Friend','').split('\n').slice(2).join('\n')}`);
  window.location.href=`mailto:?subject=${subject}&body=${body}`;
}

