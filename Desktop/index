function calNav(dir){
  let mo=calMagicState.month+dir;
  let yr=calMagicState.year;
  if(mo<0){mo=11;yr--;}
  if(mo>11){mo=0;yr++;}
  calMagicState.month=mo;calMagicState.year=yr;
  renderMagicCalendar();
}
function calNavToToday(){calMagicState.month=new Date().getMonth();calMagicState.year=new Date().getFullYear();renderMagicCalendar();}
function calShowDay(d){
  const mo=calMagicState.month,yr=calMagicState.year;
  const entries=calLoad();
  const evs=[];
  MAGIC_DATES.forEach(md=>{if(md.mo===mo+1&&md.dy===d)evs.push({...md,kind:'magic'});});
