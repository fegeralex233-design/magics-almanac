// Shared sparkle burst utility
function wzSparkle(containerId){
  var c=document.getElementById(containerId);
  if(!c)return;
  var sparks=['✨','⭐','💫','🌟','✦','🔮','🌙','⚡'];
  for(var i=0;i<18;i++){
    (function(delay){
      setTimeout(function(){
        var s=document.createElement('div');
        s.textContent=sparks[Math.floor(Math.random()*sparks.length)];
        var size=(0.6+Math.random()*1.1)+'rem';
        s.style.cssText='position:absolute;font-size:'+size+';left:'+(5+Math.random()*90)+'%;'
          +'top:'+(5+Math.random()*90)+'%;opacity:0;pointer-events:none;transition:opacity .3s,transform 1.1s ease-out;will-change:transform,opacity;z-index:10';
        c.style.position='relative';
        c.appendChild(s);
        requestAnimationFrame(function(){
          requestAnimationFrame(function(){
            s.style.opacity='1';
            s.style.transform='translateY(-'+(20+Math.random()*50)+'px) rotate('+(Math.random()*360)+'deg)';
            setTimeout(function(){s.style.opacity='0';setTimeout(function(){if(s.parentNode)s.parentNode.removeChild(s);},400);},900);
          });
        });
      },delay);
    })(i*60);
  }
}

