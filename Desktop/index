  else if(day.ruler==='The Moon'&&newm) goodFor='Moon rules Monday and tonight is New Moon — rare double power for new intentions.';
  else if(day.ruler==='Saturn'&&waning) goodFor='Saturn and the waning moon together: release debt, old habits, or anything holding you back.';
  else if(day.ruler==='Mercury') goodFor='Strong day for communication, contracts, and decisions. Your words carry weight.';
  else if(day.ruler==='Mars') goodFor='Act boldly today. Energy is high for anything requiring courage or physical effort.';
  else if(full) goodFor='Full Moon amplifies everything. Celebrate, complete, or let something reach its peak.';
  else if(newm) goodFor='New Moon: plant a seed. Write your intention and set it somewhere meaningful.';
  else if(num===8) goodFor='The 8 day brings momentum — whatever you put energy into now can compound.';
  else if(num===1) goodFor='Day 1: a natural launch day. If you have been waiting, today says begin.';
  else goodFor='A day of quiet, steady magic. '+(rising?'Energy is building — stay the course.':waning?'Let go of what no longer serves.':'Trust the rhythm.');;
  return goodFor+' &nbsp;&mdash;&nbsp; So mote it be.';
}

