    almanactown:   'videos/town-bg.mp4',
    halloween:     'videos/halloween-bg.mp4',
    solstice:      'videos/solstice-bg.mp4',
    // Add more: 'sectionName': 'videos/filename.mp4'
  };

  // ── VIDEO PLAYER STATE ────────────────────────────────────────
  var bgVid = document.getElementById('bgVideo');
  var bgSrc = document.getElementById('bgVideoSrc');
  var currentSrc = null;
  var fadeTimer = null;

  // ── CORE: setBackground(key) ──────────────────────────────────
  // Called automatically by go() for each section.
  // Also callable manually: setBackground('home')
  window.setBackground = function(key) {
    var path = SECTION_VIDEOS[key];
    if (!path || path === currentSrc) return; // no video = dark bg; same = no change
    if (fadeTimer) clearTimeout(fadeTimer);

    // Fade out current
    bgVid.style.opacity = '0';
    fadeTimer = setTimeout(function() {
      bgSrc.src = path;
      bgVid.load();
      bgVid.play().catch(function(){});   // autoplay may be blocked — silent fail
      bgVid.style.opacity = '0.35';      // dim so app content stays readable
      currentSrc = path;
    }, 600); // wait for fade-out before swapping
  };

  // ── ZODIAC AUTO-BACKGROUND ────────────────────────────────────
  // Reads birthday from localStorage (set when user enters birthday)
  // and loads the matching zodiac background on home screen
  function signFromBirthday(month, day) {
    if ((month===3&&day>=21)||(month===4&&day<=19)) return 'aries';
    if ((month===4&&day>=20)||(month===5&&day<=20)) return 'taurus';
    if ((month===5&&day>=21)||(month===6&&day<=20)) return 'gemini';
    if ((month===6&&day>=21)||(month===7&&day<=22)) return 'cancer';
    if ((month===7&&day>=23)||(month===8&&day<=22)) return 'leo';
    if ((month===8&&day>=23)||(month===9&&day<=22)) return 'virgo';
    if ((month===9&&day>=23)||(month===10&&day<=22)) return 'libra';
    if ((month===10&&day>=23)||(month===11&&day<=21)) return 'scorpio';
    if ((month===11&&day>=22)||(month===12&&day<=21)) return 'sagittarius';
    if ((month===12&&day>=22)||(month===1&&day<=19)) return 'capricorn';
    if ((month===1&&day>=20)||(month===2&&day<=18)) return 'aquarius';
    return 'pisces';
  }

  window.setZodiacBackground = function() {
    try {
      var bd = localStorage.getItem('userBirthday'); // format: MM/DD or MM/DD/YYYY
      if (!bd) return;
      var parts = bd.split('/');
      var m = parseInt(parts[0]), d = parseInt(parts[1]);
      if (!m || !d) return;
      var sign = signFromBirthday(m, d);
      setBackground('zodiac_' + sign);
    } catch(e) {}
  };

  // ── HOOK INTO go() ───────────────────────────────────────────
  // Wrap go() so every navigation auto-triggers background swap
  var _origGo = window.go;
  window.go = function(name) {
    if (_origGo) _origGo(name);
    // Fire background after render (slight delay to not compete with render)
    setTimeout(function() {
      if (name === 'home') {
        setZodiacBackground();           // zodiac bg on home
        if (!SECTION_VIDEOS['zodiac_'+''+'']) {
          setBackground('home');         // fallback if no zodiac video
        }
      } else {
        setBackground(name);             // section-specific bg
      }
    }, 100);
  };

  // ── VIDEO FILE CHECK (dev helper) ────────────────────────────
  // In console: checkVideoFiles() to see which videos exist vs missing
  window.checkVideoFiles = function() {
    console.group('📹 Video Background Status');
    Object.entries(SECTION_VIDEOS).forEach(function(pair) {
      var key = pair[0], path = pair[1];
      fetch(path, {method:'HEAD'}).then(function(r) {
        console.log((r.ok ? '✅' : '❌') + ' ' + key + ' → ' + path);
      }).catch(function() {
        console.log('❌ ' + key + ' → ' + path + ' (not found)');
      });
    });
    console.groupEnd();
  };

})();
</script>

