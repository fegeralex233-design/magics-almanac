}
function nessieTaunt(stage){
  var t1=['Catch me if you can!','Tee hee!','Peek-a-boo!','Too slow!','Over here!'];
  var t2=['I am rising!','Watch out!','Here I come!','Splash!','Coming up!'];
  if(stage===1)return t1[Math.floor(Math.random()*t1.length)];
  if(stage===2)return t2[Math.floor(Math.random()*t2.length)];
  return ''; // stage 3: no taunt — spell prompt takes over
}

