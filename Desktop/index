function downloadCauldronCard(recipientName){
  const card=document.getElementById('cCard');
  if(!card){alert('Brew a card first.');return;}
  // Render the card div to a canvas using html2canvas approach —
  // since we don't have html2canvas, we build a pixel-perfect canvas manually
  // using the stored print text + fairy image if present
  const W=800, H=1200;
  const pc=document.createElement('canvas');
  pc.width=W; pc.height=H;
  const ctx=pc.getContext('2d');

  // Background
  const bg=ctx.createLinearGradient(0,0,W,H);
  bg.addColorStop(0,'#060010'); bg.addColorStop(0.5,'#140330'); bg.addColorStop(1,'#0a0018');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

  // Star field
  for(let i=0;i<180;i++){
    ctx.fillStyle=`rgba(255,255,255,${0.04+Math.random()*0.22})`;
    ctx.fillRect(Math.random()*W,Math.random()*H,Math.random()<0.12?1.5:0.7,Math.random()<0.12?1.5:0.7);
  }

  // Gold border
  ctx.strokeStyle='rgba(201,162,39,0.7)'; ctx.lineWidth=2.5;
  ctx.strokeRect(10,10,W-20,H-20);
  ctx.strokeStyle='rgba(201,162,39,0.2)'; ctx.lineWidth=1;
  ctx.strokeRect(18,18,W-36,H-36);

  // Corner ornaments
  [[22,22,1,1],[W-22,22,-1,1],[W-22,H-22,-1,-1],[22,H-22,1,-1]].forEach(([x,y,sx,sy])=>{
    ctx.save(); ctx.translate(x,y); ctx.scale(sx,sy);
    ctx.strokeStyle='rgba(201,162,39,0.6)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(0,24); ctx.moveTo(0,0); ctx.lineTo(24,0); ctx.stroke();
    ctx.font='14px serif'; ctx.fillStyle='rgba(201,162,39,0.8)'; ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('✦',8,8); ctx.restore();
  });

  // Header ornament
  ctx.textAlign='center'; ctx.fillStyle='rgba(201,162,39,0.45)';
  ctx.font='13px Georgia,serif'; ctx.fillText('· · · ✦ · · ·',W/2,56);

  // Occasion emoji + title
  const txt=window._cauldronPrintText||'';
  const lines=txt.split('\n');
  const recipName=lines[0]||recipientName||'';
  const occasion=lines[1]||'';

  ctx.font='bold 48px serif';
  ctx.fillText((occasion.match(/^\S+/)||['✦'])[0],W/2,110);

  ctx.font='bold 28px Georgia,serif';
  ctx.fillStyle='rgba(201,162,39,0.95)';
  ctx.shadowColor='rgba(201,162,39,0.4)'; ctx.shadowBlur=16;
  ctx.fillText(occasion.replace(/^\S+\s*/,''),W/2,155);
  ctx.shadowBlur=0;

  ctx.font='13px Georgia,serif';
  ctx.fillStyle='rgba(201,162,39,0.45)';
  ctx.fillText('· · · ✦ · · ·',W/2,180);

  // Fairy image if present
  const fairyImg=document.getElementById('cFairyImg');
  let bodyStartY=210;
  if(fairyImg&&fairyImg.src&&document.getElementById('cFairySlot').style.display!=='none'){
    try{
      const fH=260;
      ctx.save();
      const grad=ctx.createLinearGradient(0,210+fH*0.55,0,210+fH);
      grad.addColorStop(0,'rgba(6,0,16,0)'); grad.addColorStop(1,'rgba(6,0,16,1)');
      ctx.drawImage(fairyImg,(W-fH)/2,210,fH,fH);
      ctx.fillStyle=grad; ctx.fillRect(0,210,W,fH);
      ctx.restore();
      bodyStartY=210+fH-40;
    }catch(e){}
  }

  // Name
  ctx.font='italic 42px "Palatino Linotype",Palatino,Georgia,serif';
  ctx.fillStyle='rgba(208,160,255,0.95)';
  ctx.shadowColor='rgba(180,120,255,0.5)'; ctx.shadowBlur=14;
  ctx.fillText(recipName,W/2,bodyStartY+50);
  ctx.shadowBlur=0;

  // Body text — wrap each section
  function wrapText(text,x,y,maxW,lineH,style,color){
    ctx.font=style; ctx.fillStyle=color; ctx.textAlign='center';
    const words=text.split(' '); let line='';
    words.forEach((w,i)=>{
      const test=line+(line?' ':'')+w;
      if(ctx.measureText(test).width>maxW&&i>0){
        ctx.fillText(line,x,y); y+=lineH; line=w;
      } else line=test;
    });
    if(line) ctx.fillText(line,x,y);
    return y+lineH;
  }

  let y=bodyStartY+90;
  const PAD=70;
  const MW=W-PAD*2;

  // Parse sections from print text
  const sections=txt.split('\n\n').slice(2); // skip name+occasion
  sections.forEach((sec,i)=>{
    if(!sec.trim()) return;
    if(i===0){ // greeting
      ctx.fillStyle='rgba(201,162,39,0.35)'; ctx.font='11px Georgia,serif';
      ctx.fillText('· · ✦ · ·',W/2,y); y+=22;
      y=wrapText(sec,'center'===ctx.textAlign?W/2:W/2,y,MW,'italic 17px Georgia,serif','rgba(240,232,255,0.9)');
      y+=8;
    } else if(i===1){ // blessing
      ctx.fillStyle='rgba(201,162,39,0.5)'; ctx.font='10px Georgia,serif';
      ctx.letterSpacing='0.18em';
      ctx.fillText('✦  YOUR BLESSING  ✦',W/2,y); y+=20;
      ctx.letterSpacing='0';
      // box
      const bStart=y;
      y=wrapText(sec,W/2,y+14,MW-40,'16px Georgia,serif','rgba(240,232,255,0.88)');
      y+=14;
      ctx.strokeStyle='rgba(201,162,39,0.18)'; ctx.lineWidth=1;
      ctx.strokeRect(PAD+10,bStart-4,MW-20,y-bStart+8);
      y+=10;
    } else if(i===2){ // spell
      const spLines=sec.split('\n');
      ctx.fillStyle='rgba(201,162,39,0.65)'; ctx.font='bold 11px Georgia,serif';
      ctx.fillText((spLines[0]||'').toUpperCase(),W/2,y); y+=20;
      y=wrapText(spLines.slice(1).join(' '),W/2,y,MW,'italic 15px Georgia,serif','rgba(240,232,216,0.9)');
      y+=12;
    } else {
      y=wrapText(sec,W/2,y,MW,'italic 15px Georgia,serif','rgba(180,160,216,0.8)');
      y+=8;
    }
  });

  // Footer
  y=Math.max(y+20, H-80);
  ctx.font='11px Georgia,serif'; ctx.fillStyle='rgba(201,162,39,0.3)';
  ctx.fillText('✦ · · · ✦ · · · ✦',W/2,y); y+=22;
  ctx.font='10px Georgia,serif'; ctx.fillStyle='rgba(120,100,160,0.5)';
  ctx.fillText('MAGICS · A Magician\'s Almanac',W/2,y);

  // Download
  const a=document.createElement('a');
  a.download=`magics-card-for-${(recipientName||'them').toLowerCase().replace(/\s+/g,'-')}.png`;
  a.href=pc.toDataURL('image/png',1.0);
  a.click();
}

function shareCauldronCard(recipientName, occasion){
  const txt=window._cauldronPrintText||'';
  if(!txt){alert('Brew a card first.');return;}
  const shareText=`✦ A magical card brewed for ${recipientName} — ${occasion}\n\n${txt.split('\n\n').slice(2,4).join('\n\n')}\n\n— sent through MAGICS · A Magician's Almanac`;
  if(navigator.share){
    navigator.share({title:`A magical card for ${recipientName}`,text:shareText})
      .catch(()=>navigator.clipboard?.writeText(shareText).then(()=>alert('Copied to clipboard — paste into a message, email, or post to share!')));
  } else {
    navigator.clipboard?.writeText(shareText)
      .then(()=>alert('Card copied to clipboard ✓\n\nPaste it into a text, email, WhatsApp, or anywhere to send it to '+recipientName+'.'))
      .catch(()=>alert('Share this card:\n\n'+shareText));
  }
}

async function addFairyToCauldron(name, zodiacSign){
  const slot=document.getElementById('cFairySlot');
  const fairyBtn=document.querySelector('#cCard button[onclick*="addFairyToCauldron"]');
  if(!slot) return;

  // Show loading state on button
  if(fairyBtn){ fairyBtn.textContent='🧚 Painting the fairy…'; fairyBtn.disabled=true; }

  const ft=fairyTypes.find(f=>f.sign===zodiacSign)||fairyTypes[Math.floor(Math.random()*fairyTypes.length)];
  const prompt='A beautiful detailed watercolor illustration of a magical fairy portrait. '+
    'Fairy type: '+ft.type+'. Wings: '+ft.wings+'. Colors: '+ft.colors+'. '+
    'Setting: enchanted garden at twilight, fireflies, soft glowing light. '+
    'Style: whimsical fine art, gentle and magical, suitable for a gift card. '+
    'Full figure centered, warm glow, dreamy atmosphere, no text, no words.';

  try{
    const result=await callRelay({kind:'image',prompt});
    if(!result.image) throw new Error('No image');
    const binary=atob(result.image);
    const bytes=new Uint8Array(binary.length);
    for(let i=0;i<binary.length;i++) bytes[i]=binary.charCodeAt(i);
    const blob=new Blob([bytes],{type:result.mimeType||'image/png'});
    const imgUrl=URL.createObjectURL(blob);

    // Inject into the card's fairy slot
    const img=document.getElementById('cFairyImg');
    const label=document.getElementById('cFairyLabel');
    if(img){ img.src=imgUrl; img.alt='Your fairy'; }
    if(label) label.textContent='✨ '+name+'\'s fairy ✨';
    slot.style.display='block';

    // Swap button to save link
    if(fairyBtn){
      fairyBtn.outerHTML=`<a href="${imgUrl}" download="fairy-for-${name.replace(/\s+/g,'-').toLowerCase()}.png" style="flex:1;min-width:120px;padding:.65rem;background:none;color:#d0a0ff;border:.5px solid #6040a0;border-radius:10px;font-size:.9rem;cursor:pointer;font-family:Georgia,serif;text-align:center;text-decoration:none;display:inline-block">⬇ Save fairy</a>`;
    }
  }catch(e){
    if(fairyBtn){ fairyBtn.textContent='🧚 Try fairy again'; fairyBtn.disabled=false; }
  }
}

