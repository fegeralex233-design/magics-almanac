  }
  var homeBtn=document.getElementById('navHomeBtn2');
  if(homeBtn)homeBtn.dataset.tab='home';
}

// ═══ LIVING GALAXY SPIRAL NAV ═════════════════════════════════════════════════
var _gRaf=null;
var _gStart=null;
var _gW=0,_gH=0;
var _gTabs=[];
var _gCtx=null;
var _gCanvas=null;
var _gTooltip=null;
var _gHover=-1;
var _gPeriod=15000; // 15 second full loop

var REALM_COL={
  circle:{r:0,g:230,b:160},
  triangle:{r:255,g:90,b:90},
  pentagon:{r:90,g:140,b:255},
  home:{r:240,g:192,b:64}
};

function galaxyRgb(realm,a){
  var c=REALM_COL[realm]||REALM_COL.pentagon;
  return 'rgba('+c.r+','+c.g+','+c.b+','+a+')';
}

// Spiral math: Archimedean spiral
// angle goes from maxAngle down to minAngle
// t=0..1 maps planet position along spiral over time (looping)
var G_TURNS=2.5;
var G_MIN_A=Math.PI*0.6;
var G_MAX_A=Math.PI*2*G_TURNS;

function spiralXY(angle,cx,cy,W,H){
  // r grows linearly with angle
  var maxR=Math.min(W,H)*0.46;
  var minR=maxR*0.06;
  var frac=(angle-G_MIN_A)/(G_MAX_A-G_MIN_A);
  var r=minR+frac*(maxR-minR);
  return {
    x:cx+r*Math.cos(angle),
    y:cy+r*Math.sin(angle)*0.58,
    r:r,
    frac:frac
  };
}

function buildGalaxy(){
  var nav=document.getElementById('galaxyNav');
  var canvas=document.getElementById('galaxyCanvas');
  _gTooltip=document.getElementById('galaxyTooltip');
  if(!nav||!canvas)return;

  _gW=nav.offsetWidth||320;
  _gH=Math.min(Math.max(_gW*0.65,220),400);
  nav.style.height=_gH+'px';

  var dpr=window.devicePixelRatio||1;
  canvas.width=Math.round(_gW*dpr);
  canvas.height=Math.round(_gH*dpr);
  canvas.style.width=_gW+'px';
  canvas.style.height=_gH+'px';
  _gCtx=canvas.getContext('2d');
  _gCtx.scale(dpr,dpr);
  _gCanvas=canvas;

  // Remove old click handler, set new one
  canvas.onclick=galaxyClick;
  canvas.onmousemove=galaxyMouseMove;
  canvas.onmouseleave=function(){_gHover=-1;if(_gTooltip)_gTooltip.style.display='none';};
  canvas.addEventListener('touchstart',galaxyTouch,{passive:false});
  canvas.addEventListener('touchend',galaxyTouchEnd,{passive:false});

  _gTabs=NAV_TABS.filter(function(t){return t.tab!=='home';});

  // Remove planet divs — we draw everything on canvas now
  var pd=document.getElementById('galaxyPlanets');
  if(pd)pd.innerHTML='';

  if(_gRaf)cancelAnimationFrame(_gRaf);
  _gStart=null;
  _gRaf=requestAnimationFrame(galaxyFrame);
}

function galaxyFrame(ts){
  if(!_gStart)_gStart=ts;
  var elapsed=(ts-_gStart)%_gPeriod;
  var progress=elapsed/_gPeriod; // 0..1

  var ctx=_gCtx;
  var W=_gW,H=_gH;
  var cx=W/2, cy=H/2;

  ctx.clearRect(0,0,W,H);

  // 1. Starfield (static — draw once would be better but clearRect wipes it)
  drawGStars(ctx,W,H);

  // 2. Spiral arms (faint, rotating slowly)
  drawGSpiral(ctx,W,H,cx,cy,progress);

  // 3. Galactic core
  drawGCore(ctx,cx,cy);

  // 4. Planets along spiral
  var n=_gTabs.length;
  var planetHitboxes=[];

  for(var i=0;i<n;i++){
    // Each planet is offset evenly, plus the global progress offset
    var t=((i/n)+progress)%1.0;
    var angle=G_MIN_A+t*(G_MAX_A-G_MIN_A);
    var pos=spiralXY(angle,cx,cy,W,H);

    // Size: big on outside, tiny near core
    var sz=Math.max(8, 8+pos.frac*30);
    // Opacity: fade near core
    var op=Math.max(0.2, pos.frac*0.9+0.1);
    // Speed label visibility: only show icon when big enough
    var showIcon=sz>14;

    var tab=_gTabs[i];
    var realm=tab.realm||'pentagon';
    var col=REALM_COL[realm]||REALM_COL.pentagon;
    var isHover=(i===_gHover);

    var drawSz=isHover?sz*1.4:sz;

    // Planet glow
    if(op>0.3){
      var grd=ctx.createRadialGradient(pos.x,pos.y,0,pos.x,pos.y,drawSz*2.2);
      grd.addColorStop(0,'rgba('+col.r+','+col.g+','+col.b+','+(op*0.5)+')');
      grd.addColorStop(1,'rgba('+col.r+','+col.g+','+col.b+',0)');
      ctx.beginPath();
      ctx.arc(pos.x,pos.y,drawSz*2.2,0,Math.PI*2);
      ctx.fillStyle=grd;
      ctx.fill();
    }

    // Planet body
    var bodyGrd=ctx.createRadialGradient(pos.x-drawSz*0.3,pos.y-drawSz*0.3,0,pos.x,pos.y,drawSz);
    bodyGrd.addColorStop(0,'rgba(255,255,255,'+(op*0.9)+')');
    bodyGrd.addColorStop(0.3,'rgba('+col.r+','+col.g+','+col.b+','+(op*0.95)+')');
    bodyGrd.addColorStop(1,'rgba('+(col.r>>1)+','+(col.g>>1)+','+(col.b>>1)+','+(op*0.8)+')');
    ctx.beginPath();
    ctx.arc(pos.x,pos.y,drawSz,0,Math.PI*2);
    ctx.fillStyle=bodyGrd;
    ctx.fill();
    // Ring
    ctx.beginPath();
    ctx.arc(pos.x,pos.y,drawSz,0,Math.PI*2);
    ctx.strokeStyle='rgba('+col.r+','+col.g+','+col.b+','+(op*0.8)+')';
    ctx.lineWidth=isHover?2:1;
    ctx.stroke();

    // Icon emoji (only when big enough)
    if(showIcon){
      ctx.save();
      ctx.globalAlpha=op;
      ctx.font=Math.round(drawSz*0.9)+'px serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(tab.label,pos.x,pos.y);
      ctx.restore();
    }

    // Store hitbox for click detection
    planetHitboxes.push({x:pos.x,y:pos.y,r:Math.max(drawSz+4,12),tab:tab,idx:i});
  }

  // Store hitboxes globally for click
  _gCanvas._hitboxes=planetHitboxes;

  _gRaf=requestAnimationFrame(galaxyFrame);
}

function drawGStars(ctx,W,H){
  // Use a seeded pattern so stars don't flicker
  var seed=42;
  function rng(){seed=(seed*16807+0)%2147483647;return seed/2147483647;}
  ctx.save();
  for(var i=0;i<300;i++){
    var x=rng()*W, y=rng()*H;
    var r=rng()*1.2+0.2;
    var a=rng()*0.7+0.15;
    ctx.beginPath();
    ctx.arc(x,y,r,0,Math.PI*2);
    ctx.fillStyle='rgba(255,255,255,'+a+')';
    ctx.fill();
  }
  ctx.restore();
}

function drawGSpiral(ctx,W,H,cx,cy,progress){
  ctx.save();
  // Slowly rotate the spiral arm lines
  var rot=progress*Math.PI*0.4;
  ctx.translate(cx,cy);
  ctx.rotate(rot);
  ctx.translate(-cx,-cy);

  // Draw 2 faint spiral arms
  for(var arm=0;arm<2;arm++){
    ctx.beginPath();
    var armOff=arm*Math.PI;
    var steps=120;
    for(var s=0;s<=steps;s++){
      var t2=s/steps;
      var angle=G_MIN_A+armOff+t2*(G_MAX_A-G_MIN_A);
      var maxR=Math.min(W,H)*0.46;
      var minR=maxR*0.06;
      var r=minR+t2*(maxR-minR);
      var x=cx+r*Math.cos(angle);
      var y=cy+r*Math.sin(angle)*0.58;
      if(s===0)ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    var grad=ctx.createLinearGradient(cx-100,cy,cx+100,cy);
    grad.addColorStop(0,'rgba(140,60,255,0.0)');
    grad.addColorStop(0.3,'rgba(160,80,255,0.35)');
    grad.addColorStop(0.7,'rgba(200,120,255,0.25)');
    grad.addColorStop(1,'rgba(100,60,255,0.0)');
    ctx.strokeStyle=grad;
    ctx.lineWidth=14;
    ctx.filter='blur(5px)';
    ctx.globalAlpha=0.7;
    ctx.stroke();
    ctx.filter='none';
    ctx.globalAlpha=1;
  }
  ctx.restore();
}

function drawGCore(ctx,cx,cy){
  var g=ctx.createRadialGradient(cx,cy,0,cx,cy,55);
  g.addColorStop(0,'rgba(255,250,200,1)');
  g.addColorStop(0.2,'rgba(255,200,80,0.8)');
  g.addColorStop(0.5,'rgba(180,80,255,0.4)');
  g.addColorStop(1,'rgba(0,0,0,0)');
  ctx.beginPath();
  ctx.arc(cx,cy,55,0,Math.PI*2);
  ctx.fillStyle=g;
  ctx.fill();
  // Bright dot
  var g2=ctx.createRadialGradient(cx,cy,0,cx,cy,10);
  g2.addColorStop(0,'rgba(255,255,255,1)');
  g2.addColorStop(1,'rgba(255,240,180,0)');
  ctx.beginPath();
  ctx.arc(cx,cy,10,0,Math.PI*2);
  ctx.fillStyle=g2;
  ctx.fill();
}

function galaxyGetHit(cx,cy){
  var boxes=_gCanvas&&_gCanvas._hitboxes;
  if(!boxes)return -1;
  for(var i=0;i<boxes.length;i++){
    var b=boxes[i];
    var dx=cx-b.x, dy=cy-b.y;
    if(dx*dx+dy*dy<=b.r*b.r)return i;
  }
  return -1;
}

function galaxyMouseMove(e){
  var rect=_gCanvas.getBoundingClientRect();
  var mx=e.clientX-rect.left, my=e.clientY-rect.top;
  var hit=galaxyGetHit(mx,my);
  _gHover=hit;
  if(hit>=0&&_gTooltip){
    var b=_gCanvas._hitboxes[hit];
    _gTooltip.textContent=_gTabs[hit].name;
    var col=REALM_COL[_gTabs[hit].realm||'pentagon']||REALM_COL.pentagon;
    var colStr='rgb('+col.r+','+col.g+','+col.b+')';
    _gTooltip.style.color=colStr;
    _gTooltip.style.borderColor=colStr;
    _gTooltip.style.left=b.x+'px';
