function lsCalc(){
  var alc=parseFloat(document.getElementById('ls-alcohol').value)||0;
  var smk=parseFloat(document.getElementById('ls-smoke').value)||0;
  var cof=parseFloat(document.getElementById('ls-coffee').value)||0;
  var snk=parseFloat(document.getElementById('ls-snacks').value)||0;
  var eat=parseFloat(document.getElementById('ls-eating').value)||0;
  var sav=parseFloat(document.getElementById('ls-save').value)||0;
  var totalSpend=(alc+smk+cof+snk+eat)*52;
  var totalSave=sav*52;
  var spend30=totalSpend*30;
  var save30=totalSave*30;
  // Life meter: needle position 0-100 (50=balanced)
  var total=totalSpend+totalSave;
  var needle=50;
  var redPct=0;
  var greenPct=0;
  if(total>0){
    var spendRatio=totalSpend/total;
    var saveRatio=totalSave/total;
    needle=Math.round(50-spendRatio*50+saveRatio*50);
    needle=Math.max(2,Math.min(98,needle));
    redPct=Math.round(spendRatio*70);
    greenPct=Math.round(saveRatio*70);
  }
  var barRed=document.getElementById('ls-bar-red');
  var barGreen=document.getElementById('ls-bar-green');
  var ndl=document.getElementById('ls-needle');
  if(barRed)barRed.style.width=redPct+'%';
  if(barGreen)barGreen.style.width=greenPct+'%';
  if(ndl)ndl.style.left=needle+'%';
  var out=document.getElementById('ls-output');
  if(total===0){if(out)out.style.display='none';return;}
  if(out)out.style.display='block';
  function fmt(n){return '$'+n.toLocaleString('en-US',{maximumFractionDigits:0});}
  var yrCost=document.getElementById('ls-yr-cost');
  var lifeCost=document.getElementById('ls-life-cost');
  var yrSave=document.getElementById('ls-yr-save');
  var lifeSave=document.getElementById('ls-life-save');
  var realVal=document.getElementById('ls-real-val');
  if(yrCost)yrCost.textContent=fmt(totalSpend);
  if(lifeCost)lifeCost.textContent=fmt(spend30);
  if(yrSave)yrSave.textContent=fmt(totalSave);
  if(lifeSave)lifeSave.textContent=fmt(save30);
  // Real value message
  var msgs=[];
  if(spend30>0){
    var vacations=Math.round(spend30/3000);
    msgs.push('Your habits cost you '+fmt(spend30)+' over 30 years — enough for '+vacations+' vacations.');
  }
  if(save30>0){
    var guitars=Math.round(save30/800);
    var freedom=Math.round(save30/40000);
    msgs.push('Your savings grow to '+fmt(save30)+' over 30 years — '+guitars+' fine instruments, or '+freedom+' years of freedom.');
  }
  if(spend30>0&&save30===0){
    msgs.push('The Oracle sees only the red. Add savings to see what the green can build.');
  }
  if(realVal)realVal.innerHTML=msgs.join('<br>');
}

