function spiritCopy(el,text,msgId){
  navigator.clipboard.writeText(text).then(()=>{
    const m=document.getElementById(msgId);
    if(m){const old=m.textContent;m.textContent='✓ copied!';m.style.color='#80e080';setTimeout(()=>{m.textContent=old;m.style.color='';},1800);}
  }).catch(()=>{
    const ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);
    const m=document.getElementById(msgId);if(m){const old=m.textContent;m.textContent='✓ copied!';m.style.color='#80e080';setTimeout(()=>{m.textContent=old;m.style.color='';},1800);}
  });
}
