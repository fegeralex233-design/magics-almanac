function getSolsticeData(){
  const now=new Date();
  const yr=now.getFullYear();
  // Approximate solstice dates (accurate to within a day)
  const solstices=[
    {type:'summer',date:new Date(yr,5,21,0,0,0),icon:'🌞',name:'Summer Solstice',sub:'Litha · Midsommar',color:'#c08010',bg:'#0e0a00',border:'#c08010',desc:'The peak of the sun — longest day, shortest night. The moment of maximum power before the retreat begins.'},
    {type:'winter',date:new Date(yr,11,21,0,0,0),icon:'🌑',name:'Winter Solstice',sub:'Yule · Midwinter',color:'#4878c0',bg:'#00050e',border:'#304878',desc:'The longest night of the year. Every light festival across every culture exists for this one moment — the sun must be coaxed back.'},
    {type:'summer',date:new Date(yr+1,5,21,0,0,0),icon:'🌞',name:'Summer Solstice',sub:'Litha · Midsommar',color:'#c08010',bg:'#0e0a00',border:'#c08010',desc:'The peak of the sun — longest day, shortest night. The moment of maximum power before the retreat begins.'},
    {type:'winter',date:new Date(yr+1,11,21,0,0,0),icon:'🌑',name:'Winter Solstice',sub:'Yule · Midwinter',color:'#4878c0',bg:'#00050e',border:'#304878',desc:'The longest night of the year. Every light festival across every culture exists for this one moment — the sun must be coaxed back.'},
  ];
  const upcoming=solstices.filter(s=>s.date>=now).sort((a,b)=>a.date-b.date);
  const next=upcoming[0];
  const after=upcoming[1];
  const diff=next.date-now;
  const days=Math.floor(diff/(1000*60*60*24));
  const hrs=Math.floor((diff%(1000*60*60*24))/(1000*60*60));
  const isToday=days===0;
  // Sun phase
  const lastWinter=now>=new Date(yr,11,21)?new Date(yr,11,21):new Date(yr-1,11,21);
  const lastSummer=now>=new Date(yr,5,21)?new Date(yr,5,21):new Date(yr-1,5,21);
  const waxing=lastWinter>lastSummer;
  const phase=waxing?'☀️ Sun is waxing — growing toward summer peak':'🌒 Sun is waning — retreating toward winter';
  return{next,after,days,hrs,isToday,phase};
}

