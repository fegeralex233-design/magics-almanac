  var html='';
  for(var j=0;j<section.spells.length;j++){
    var sp=section.spells[j];
    var idx=j;
    html+='<div style="background:linear-gradient(135deg,rgba(20,10,35,.9),rgba(10,5,20,.95));border:1px solid '+section.color+';border-radius:12px;padding:1.1rem 1rem;margin-bottom:.8rem;position:relative">';
