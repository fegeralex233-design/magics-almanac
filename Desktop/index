  // Place planets along Archimedean spiral
  container.innerHTML='';
  var tabs=NAV_TABS.filter(function(t){return t.tab!=='home';});
  var cx=W/2, cy=H/2;
  var a=0, b=H/(2*Math.PI*(tabs.length/6+2));
  var angleStep=(Math.PI*2*(tabs.length/6+2))/tabs.length;

  tabs.forEach(function(t,i){
    var angle=i*angleStep + Math.PI*0.15;
    var r=b*(angle);
    var x=cx+r*Math.cos(angle);
    var y=cy+r*Math.sin(angle)*0.7; // flatten vertically

    var realm=t.realm||'pentagon';
    var colors=PLANET_REALM_COLORS[realm]||PLANET_REALM_COLORS.pentagon;
    var size=Math.max(36, 50-i*0.4);

    var planet=document.createElement('div');
    planet.className='galaxy-planet';
    planet.dataset.tab=t.tab;
    planet.dataset.realm=realm;
    planet.style.cssText=[
      'position:absolute',
      'left:'+(x-size/2)+'px',
      'top:'+(y-size/2)+'px',
      'width:'+size+'px',
      'height:'+size+'px',
      'border-radius:50%',
      'background:radial-gradient(circle at 35% 35%,'+colors.core+','+colors.ring+' 50%,#060010 100%)',
      'border:1.5px solid '+colors.core,
      'box-shadow:0 0 '+Math.round(size*0.4)+'px '+colors.glow+'0.6),0 0 '+Math.round(size*0.8)+'px '+colors.glow+'0.2),inset 0 0 '+Math.round(size*0.2)+'px rgba(255,255,255,0.1)',
      'cursor:pointer',
      'display:flex',
      'align-items:center',
      'justify-content:center',
      'font-size:'+Math.round(size*0.4)+'px',
      'transition:transform .2s,box-shadow .2s',
      'transform-style:preserve-3d',
      'z-index:2',
      'user-select:none',
    ].join(';');
    planet.innerHTML=t.label;

    // Hover
    planet.addEventListener('mouseenter',function(){
      this.style.transform='scale(1.25) translateY(-3px)';
      this.style.boxShadow='0 0 '+Math.round(size*0.7)+'px '+colors.glow+'0.9),0 0 '+Math.round(size*1.4)+'px '+colors.glow+'0.4)';
      showGalaxyTooltip(t.name,x,y-size/2-4,colors.core);
    });
    planet.addEventListener('mouseleave',function(){
      this.style.transform='';
      this.style.boxShadow='';
      hideGalaxyTooltip();
    });
    planet.addEventListener('click',function(e){
      e.stopPropagation();
      hideGalaxyTooltip();
      galaxySupernova(this,colors,x,y,H);
      setTimeout(function(){go(t.tab);},480);
    });
    // Touch
    planet.addEventListener('touchstart',function(e){
      e.stopPropagation();
      showGalaxyTooltip(t.name,x,y-size/2-4,colors.core);
    },{passive:true});
    planet.addEventListener('touchend',function(e){
      e.preventDefault();
      hideGalaxyTooltip();
      galaxySupernova(planet,colors,x,y,H);
      setTimeout(function(){go(t.tab);},480);
    });

    container.appendChild(planet);
  });

  // Draw galaxy arms overlay on canvas
  drawGalaxyArms(ctx,W*2,H*2,tabs.length,b,cx*2,cy*2);
  drawGalacticCore(ctx,cx*2,cy*2);

  // Animate gentle drift
  if(_galaxyRAF)cancelAnimationFrame(_galaxyRAF);
  animateGalaxy();
  _galaxyInit=true;
}

function drawStarfield(ctx,W,H){
  ctx.clearRect(0,0,W,H);
  for(var i=0;i<400;i++){
    var x=Math.random()*W, y=Math.random()*H;
    var r=Math.random()*1.5+0.3;
    var a=Math.random()*0.8+0.2;
    ctx.beginPath();
    ctx.arc(x,y,r,0,Math.PI*2);
    ctx.fillStyle='rgba(255,255,255,'+a+')';
    ctx.fill();
  }
  // Nebula wisps
  for(var j=0;j<6;j++){
    var gx=Math.random()*W, gy=Math.random()*H;
    var grad=ctx.createRadialGradient(gx,gy,0,gx,gy,80+Math.random()*120);
    var colors2=['rgba(80,0,180,','rgba(0,60,120,','rgba(120,0,80,','rgba(0,80,60,'];
    var c=colors2[Math.floor(Math.random()*colors2.length)];
    grad.addColorStop(0,c+'0.12)');
    grad.addColorStop(1,c+'0)');
    ctx.fillStyle=grad;
    ctx.fillRect(0,0,W,H);
  }
}

function drawGalaxyArms(ctx,W,H,count,b,cx,cy){
  var angleStep=(Math.PI*2*(count/6+2))/count;
  ctx.save();
  ctx.globalAlpha=0.18;
  for(var arm=0;arm<3;arm++){
    ctx.beginPath();
    var armOffset=arm*(Math.PI*2/3);
    for(var i=0;i<=count;i++){
      var angle=i*angleStep+armOffset+Math.PI*0.15;
      var r=b*angle;
      var x=cx+r*Math.cos(angle);
      var y=cy+r*Math.sin(angle)*0.7;
      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    var grad=ctx.createLinearGradient(cx-200,cy,cx+200,cy);
    grad.addColorStop(0,'rgba(120,60,255,0.6)');
    grad.addColorStop(0.5,'rgba(200,100,255,0.4)');
    grad.addColorStop(1,'rgba(60,120,255,0.6)');
    ctx.strokeStyle=grad;
    ctx.lineWidth=18;
    ctx.filter='blur(8px)';
    ctx.stroke();
  }
  ctx.restore();
}

function drawGalacticCore(ctx,cx,cy){
  var grad=ctx.createRadialGradient(cx,cy,0,cx,cy,90);
  grad.addColorStop(0,'rgba(255,240,180,0.95)');
  grad.addColorStop(0.15,'rgba(255,200,100,0.6)');
  grad.addColorStop(0.4,'rgba(180,80,255,0.3)');
  grad.addColorStop(1,'rgba(0,0,0,0)');
  ctx.beginPath();
  ctx.arc(cx,cy,90,0,Math.PI*2);
  ctx.fillStyle=grad;
  ctx.fill();
  // Inner bright core
  var inner=ctx.createRadialGradient(cx,cy,0,cx,cy,22);
  inner.addColorStop(0,'rgba(255,255,255,1)');
  inner.addColorStop(0.5,'rgba(255,230,150,0.8)');
  inner.addColorStop(1,'rgba(255,200,100,0)');
  ctx.beginPath();
  ctx.arc(cx,cy,22,0,Math.PI*2);
  ctx.fillStyle=inner;
  ctx.fill();
}

function animateGalaxy(){
  var planets=document.querySelectorAll('.galaxy-planet');
  if(!planets.length){_galaxyRAF=null;return;}
  _galaxyAngle+=0.0015;
  planets.forEach(function(p,i){
    var wobble=Math.sin(_galaxyAngle*0.7+i*0.4)*1.2;
    var pulse=1+Math.sin(_galaxyAngle*1.1+i*0.9)*0.04;
    p.style.marginTop=wobble+'px';
    p.style.transform=p===document.querySelector('.galaxy-planet:hover')?'':('scale('+pulse+')');
  });
  _galaxyRAF=requestAnimationFrame(animateGalaxy);
}

