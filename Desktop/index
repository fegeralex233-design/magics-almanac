function buildDogProfile(){
  var name=(document.getElementById('dogName')||{}).value||'';
  var month=(document.getElementById('dogMonth')||{}).value||'Jan';
  if(!name.trim()){
    var inp=document.getElementById('dogName');
    if(inp){inp.style.borderColor='#ff8040';inp.focus();}
    return;
  }
  var signs=window._dogSigns||{};
  var data=signs[month]||{sign:'Leo',elem:'Fire',stone:'Sunstone',blessing:'A radiant spirit, loyal beyond all measure.'};
  var result=document.getElementById('dogProfileResult');
  var nameEl=document.getElementById('dogProfileName');
  var signEl=document.getElementById('dogProfileSign');
  var blessEl=document.getElementById('dogProfileBlessing');
  var stoneEl=document.getElementById('dogProfileStone');
  if(nameEl) nameEl.textContent='🐾 '+name.trim()+' 🐾';
  if(signEl) signEl.textContent=data.sign+' · Element: '+data.elem;
  if(blessEl) blessEl.textContent=data.blessing;
  if(stoneEl) stoneEl.innerHTML='Sacred stone: <strong style="color:#e0b870">'+data.stone+'</strong>';
  if(result){result.style.display='block';result.scrollIntoView({behavior:'smooth',block:'start'});}
  window._currentDogName=name.trim();
  window._currentDogData=data;
  sprayFairyDust();
}

function shareDogProfile(){
  var name=window._currentDogName||'My dog';
  var data=window._currentDogData||{sign:'Leo',elem:'Fire',blessing:''};
  var text=name+' is a '+data.sign+' '+data.elem+' spirit. '+data.blessing+' — Magic\'s Almanac, magicsalmanac.com';
  if(navigator.share){
    navigator.share({title:name+'\'s Magic Profile',text:text,url:'https://magicsalmanac.com'}).catch(function(){});
  } else if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(function(){alert('Copied! Share '+name+'\'s magic anywhere.');}).catch(function(){});
  }
}


