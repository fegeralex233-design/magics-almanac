          +'top:'+(Math.random()*100)+'vh;'
          +'color:'+cols[Math.floor(Math.random()*cols.length)]+';';
        p.textContent=gl[Math.floor(Math.random()*gl.length)];
        document.body.appendChild(p);
        var dx=(Math.random()-0.5)*180,dy=30+Math.random()*160,dur=700+Math.random()*900;
        if(p.animate){
          p.animate([
            {opacity:0,transform:'scale(0.1)'},
            {opacity:1,transform:'translate('+(dx/3)+'px,'+(-dy/2)+'px) scale(1.1)',offset:0.3},
            {opacity:0,transform:'translate('+dx+'px,'+dy+'px) scale(0.2)'}
          ],{duration:dur,easing:'ease-out'}).finished.then(function(){if(p.parentNode)p.parentNode.removeChild(p);});
        } else setTimeout(function(){if(p.parentNode)p.parentNode.removeChild(p);},dur);
      }
    },delay);
  });
}


