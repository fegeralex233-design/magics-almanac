var DAY_RULERS=[3,6,2,5,1,4,0]; // Sun,Moon,Mars,Mercury,Jupiter,Venus,Saturn indices in PLANETS

function getSunTimes(date, lat, lon){
  // Astronomical sunrise/sunset (degrees)
  var rad=Math.PI/180;
  var n=Math.floor(date/86400000)-Math.floor(new Date(date.getFullYear(),0,0)/86400000);
  var L=(280.460+0.9856474*n)%360;
  var g=(357.528+0.9856003*n)%360;
  var lambda=L+1.915*Math.sin(g*rad)+0.020*Math.sin(2*g*rad);
  var eps=23.439-0.0000004*n;
  var sinDec=Math.sin(eps*rad)*Math.sin(lambda*rad);
  var dec=Math.asin(sinDec)/rad;
  var cosH=(-Math.sin(-0.833*rad)-Math.sin(lat*rad)*Math.sin(dec*rad))/(Math.cos(lat*rad)*Math.cos(dec*rad));
  if(cosH<-1||cosH>1) return null; // polar day/night
  var H=Math.acos(cosH)/rad;
  var RA=(Math.atan2(Math.cos(eps*rad)*Math.sin(lambda*rad),Math.cos(lambda*rad))/rad+360)%360;
  var GMST=(6.697375+0.0657098242*n+12)%24;
  var LMST=(GMST+lon/15+24)%24;
  var transit=((RA/15-LMST+24)%24+12)%24; // solar noon in UTC hours
  // convert to local midnight-based hours using timezone offset
  var tzOff=date.getTimezoneOffset()/60;
  var noonLocal=transit-tzOff;
  var sunriseLocal=noonLocal-H/15;
  var sunsetLocal=noonLocal+H/15;
  return {sunrise:sunriseLocal, sunset:sunsetLocal};
}

function getPlanetaryHours(date){
  var lat=27.9; var lon=-82.5; // default: Clearwater FL — close enough for the hour grid
  // try geolocation from storage
  try{var ll=(localStorage.getItem('magics_ll')||'').split(',');if(ll.length===2){lat=parseFloat(ll[0]);lon=parseFloat(ll[1]);}}catch(e){}

  var st=getSunTimes(date,lat,lon);
  if(!st) st={sunrise:6,sunset:18};
  var sr=st.sunrise, ss=st.sunset;

  // day hours: sr→ss split into 12
  var dayLen=(ss-sr)/12;
  // night hours: ss→(sr+24) split into 12
  var nightLen=(sr+24-ss)/12;

  // First hour ruler = day ruler
  var dayIdx=date.getDay(); // 0=Sun
  var firstRulerIdx=DAY_RULERS[dayIdx];

  var hours=[];
  for(var i=0;i<24;i++){
    var start,end;
    if(i<12){start=sr+i*dayLen; end=sr+(i+1)*dayLen;}
    else{start=ss+(i-12)*nightLen; end=ss+(i-11)*nightLen;}
    var planetIdx=(firstRulerIdx+i)%7;
    hours.push({start:start,end:end,planet:PLANETS[planetIdx],idx:i,isDay:i<12});
  }
  return hours;
}

function getCurrentHourIdx(hours){
  var now=new Date();
  var h=now.getHours()+now.getMinutes()/60+now.getSeconds()/3600;
  for(var i=0;i<hours.length;i++){
    var s=hours[i].start, e=hours[i].end;
    // handle crossing midnight
    if(s<=e){if(h>=s&&h<e)return i;}
    else{if(h>=s||h<e)return i;}
  }
  return 0;
}

function fmtHour(h){
  // h is decimal hours (local)
  h=((h%24)+24)%24;
  var hh=Math.floor(h)%12||12;
  var mm=Math.floor((h%1)*60);
  var ampm=Math.floor(h%24)>=12?'PM':'AM';
  return hh+':'+(mm<10?'0':'')+mm+' '+ampm;
}

