// ─── iCal / Calendar export helpers ─────────────────────────────────────────
function icalDateStr(month,day,hour){
  // Returns a floating YYYYMMDDTHHMMSS (no Z) so it lands right in any timezone
  const yr=new Date().getFullYear();
  const d=new Date(yr,month-1,day,hour||9,0,0);
  // If the date already passed this year, bump to next year
  if(d<new Date()) d.setFullYear(yr+1);
  return d.toISOString().replace(/[-:]/g,'').split('.')[0];
}
function buildIcal(events){
  // events: [{name, dtstart, dtend, description, location}]
  const uid=()=>Math.random().toString(36).slice(2)+Date.now()+'@magicsalmanac';
  const lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//MAGICS Almanac//EN','CALSCALE:GREGORIAN','X-WR-CALNAME:MAGICS Festival Calendar'];
  events.forEach(ev=>{
    lines.push('BEGIN:VEVENT');
    lines.push('UID:'+uid());
    lines.push('DTSTART:'+ev.dtstart);
    lines.push('DTEND:'+ev.dtend);
    lines.push('SUMMARY:'+ev.name.replace(/,/g,'\\,'));
    if(ev.description) lines.push('DESCRIPTION:'+ev.description.replace(/\n/g,'\\n').replace(/,/g,'\\,').slice(0,500));
    if(ev.location)  lines.push('LOCATION:'+ev.location);
    lines.push('END:VEVENT');
  });
  lines.push('END:VCALENDAR');
  // iCal requires CRLF line endings and max 75 chars per line (fold longer)
  return lines.map(l=>{
    if(l.length<=75) return l;
    const chunks=[];let s=l;
    while(s.length>75){chunks.push(s.slice(0,75));s=' '+s.slice(75);}
    chunks.push(s);return chunks.join('\r\n');
  }).join('\r\n');
}
function downloadIcal(icalStr, filename){
  const blob=new Blob([icalStr],{type:'text/calendar;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=filename||'magic-festival.ics';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(a.href),3000);
}
function addFestivalToCalendar(name,month,day,description,location){
  const ds=icalDateStr(month,day,9);
  // All-day-ish: start at 09:00, end same day 22:00
  const de=icalDateStr(month,day,22);
  const ical=buildIcal([{name:'✦ '+name,dtstart:ds,dtend:de,description,location}]);
  downloadIcal(ical,'magics-'+name.toLowerCase().replace(/[^a-z0-9]+/g,'-')+'.ics');
}
