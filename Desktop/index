  // Kick off left-to-right arc
  setTimeout(function(){
    flyer.style.left=(W+20)+'px';
    flyer.style.top='15px';
  },30);

  // Midpoint: swoop down slightly
  setTimeout(function(){
    flyer.style.top='55px';
  },550);

  // After crossing: show splash back into loch
  setTimeout(function(){
    if(lake&&flyer.parentNode)lake.removeChild(flyer);
