<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#ffffff;--parch:#0a0118;--blood:#ff7070;--gold:#f0c040;
  --mist:#e0d0ff;--ember:#ff9050;--card:#100228;--border-c:#3a2060;
  --deep:#06000e;--violet:#4a2a7e;--lavender:#ffffff;
}
body{font-family:Georgia,'Times New Roman',serif;background:#04000e;color:#ffffff;min-height:100vh;min-height:100dvh;font-size:20px;position:relative}
.app{display:flex;flex-direction:column;min-height:100vh;min-height:100dvh;position:relative;z-index:2;background:transparent}
.hdr{background:var(--ink);color:#e8d5b0;padding:0;position:relative;overflow:hidden;min-height:90px;background:linear-gradient(180deg,#080115 0%,#0e0228 100%)}
.hdr::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,#3a1a5e 0%,transparent 70%);pointer-events:none}
.hdr-inner{position:relative;z-index:2;padding:1.4rem 1.2rem 1rem;text-align:center}
.hdr h1{font-family:Georgia,serif;font-size:2.6rem;font-weight:700;letter-spacing:.12em;color:var(--gold);cursor:pointer;transition:text-shadow .2s}
.hdr h1:hover{text-shadow:0 0 30px rgba(201,162,39,.4)}
.hdr .sub{font-size:.94rem;letter-spacing:.16em;color:#c8b8e0;margin-top:.2rem}
.stars{font-size:1.1rem;color:var(--gold);opacity:.75;letter-spacing:.35em;display:block;margin-bottom:.4rem;cursor:pointer}
/* ── NAV: Two scrolling rows + sparkle ── */
.nav{background:#06000e;border-bottom:1px solid #2a1050;padding:0}
.nav-rows{display:flex;flex-direction:column}
.nav-row{display:flex;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:5px 6px;gap:5px;justify-content:center}
.nav-row::-webkit-scrollbar{display:none}
/* REALM NAV */
.realm-nav{display:flex;gap:6px;padding:4px 6px 6px;overflow-x:auto;scrollbar-width:none;align-items:flex-start}
.realm-nav::-webkit-scrollbar{display:none}
.realm-group{flex:1 1 0;min-width:100px;border-radius:14px;padding:5px 4px 6px;cursor:pointer;position:relative;overflow:hidden;transition:box-shadow .3s,transform .2s;transform-style:preserve-3d;perspective:400px}
.realm-group:hover{transform:translateY(-2px) rotateX(4deg) rotateY(-2deg);box-shadow:0 8px 24px rgba(0,0,0,.5)}
.realm-circle{border:2px solid rgba(0,220,180,.5);background:linear-gradient(160deg,rgba(0,60,50,.7),rgba(0,30,30,.9));box-shadow:0 2px 12px rgba(0,200,160,.15),inset 0 1px 0 rgba(0,255,200,.1)}
.realm-triangle{border:2px solid rgba(200,80,80,.5);background:linear-gradient(160deg,rgba(60,10,10,.7),rgba(30,5,5,.9));box-shadow:0 2px 12px rgba(200,80,80,.15),inset 0 1px 0 rgba(255,120,120,.1)}
.realm-pentagon{border:2px solid rgba(80,120,255,.5);background:linear-gradient(160deg,rgba(10,20,70,.7),rgba(5,10,40,.9));box-shadow:0 2px 12px rgba(80,120,255,.15),inset 0 1px 0 rgba(120,160,255,.1)}
.realm-label{display:flex;align-items:center;gap:4px;padding:0 3px 4px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:4px}
.realm-shape-icon{font-size:1.1rem;line-height:1;transition:transform .4s,filter .4s;display:inline-block}
.realm-title{font-size:.58rem;letter-spacing:.06em;text-transform:uppercase;opacity:.7;font-family:Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.realm-circle .realm-title{color:#00ddb4}
.realm-triangle .realm-title{color:#ff9090}
.realm-pentagon .realm-title{color:#90a8ff}
.realm-btns{display:flex;flex-wrap:wrap;gap:3px;justify-content:center}
.nav-tab-btn{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;padding:3px 6px;min-width:44px;background:rgba(20,5,50,.7);border:1px solid rgba(120,80,200,.3);border-radius:8px;color:#c8a8ff;cursor:pointer;font-family:Georgia,serif;transition:background .15s,border-color .15s,transform .1s;text-align:center;line-height:1}
.nav-tab-btn:hover,.nav-tab-btn.active{background:rgba(120,60,220,.35);border-color:rgba(180,120,255,.7);color:#fff;transform:translateY(-1px)}
.realm-btn{display:flex;flex-direction:column;align-items:center;padding:4px 5px;min-width:42px;max-width:60px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.28);border-radius:8px;cursor:pointer;font-family:inherit;transition:all .18s;position:relative;overflow:hidden}
.realm-btn .rb-icon{font-size:1.1rem;line-height:1}
.realm-btn .rb-name{font-size:.6rem;color:#d0c8f0;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.realm-btn.active{background:rgba(255,255,255,.12);border-color:var(--gold)}
.realm-btn.active .rb-name{color:var(--gold)}
.realm-circle .realm-btn:hover{border-color:#00ddb4;background:rgba(0,200,160,.12)}
.realm-triangle .realm-btn:hover{border-color:#ff9090;background:rgba(200,80,80,.12)}
.realm-pentagon .realm-btn:hover{border-color:#90a8ff;background:rgba(80,120,255,.12)}
/* Flash animations */
@keyframes realmFlashCircle{0%{box-shadow:0 2px 12px rgba(0,200,160,.15)}50%{box-shadow:0 0 40px rgba(0,255,200,.9),0 0 80px rgba(0,255,200,.5),inset 0 0 30px rgba(0,255,200,.3);border-color:rgba(0,255,200,1);transform:scale(1.03) rotateX(6deg) rotateY(-3deg)}100%{box-shadow:0 2px 12px rgba(0,200,160,.15)}}
@keyframes realmFlashTriangle{0%{box-shadow:0 2px 12px rgba(200,80,80,.15)}50%{box-shadow:0 0 40px rgba(255,100,100,.9),0 0 80px rgba(255,100,100,.5),inset 0 0 30px rgba(255,100,100,.3);border-color:rgba(255,120,120,1);transform:scale(1.03) rotateX(6deg) rotateY(-3deg)}100%{box-shadow:0 2px 12px rgba(200,80,80,.15)}}
@keyframes realmFlashPentagon{0%{box-shadow:0 2px 12px rgba(80,120,255,.15)}50%{box-shadow:0 0 40px rgba(100,140,255,.9),0 0 80px rgba(100,140,255,.5),inset 0 0 30px rgba(100,140,255,.3);border-color:rgba(140,170,255,1);transform:scale(1.03) rotateX(6deg) rotateY(-3deg)}100%{box-shadow:0 2px 12px rgba(80,120,255,.15)}}
.realm-flashing-circle{animation:realmFlashCircle .9s ease forwards}
.realm-flashing-triangle{animation:realmFlashTriangle .9s ease forwards}
.realm-flashing-pentagon{animation:realmFlashPentagon .9s ease forwards}
@keyframes realmSpark{0%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(0)}}
.realm-spark{position:absolute;pointer-events:none;font-size:.9rem;animation:realmSpark .8s ease forwards;z-index:10}
.nav-btn{flex:1 1 0;display:flex;flex-direction:column;align-items:center;padding:8px 11px;min-width:52px;max-width:90px;background:#0a0120;border:1px solid #2a1050;border-radius:9px;cursor:pointer;font-family:inherit;transition:all .2s;position:relative;overflow:hidden}
.nav-btn .nb-icon{font-size:1.38rem;line-height:1}
.nav-btn .nb-name{font-size:.72rem;color:#d8cef0;margin-top:3px;white-space:nowrap}
.nav-btn.active{background:#1a0440;border-color:var(--gold)}
.nav-btn.active .nb-name{color:var(--gold)}
.nav-btn:hover:not(.active){background:#12032a;border-color:#5a3080}
.nav-home-row{display:flex;justify-content:center;padding:1px 0 2px;background:#04000a}
.nav-home-btn2{padding:0;height:9px;font-size:.42rem;line-height:9px;color:var(--gold);background:#0a0120;border:1px solid rgba(201,162,39,.4);border-radius:5px;cursor:pointer;font-family:inherit;letter-spacing:.12em;transition:all .2s;width:100%;max-width:680px;display:block;margin:0 auto;text-align:center;overflow:hidden}
.nav-home-btn2.active{background:#2a0a50;border-color:var(--gold)}
.nav-home-btn2:hover:not(.active){background:#12032a}
@keyframes sparkle{0%{opacity:0;transform:translate(-50%,-50%) scale(.2)}50%{opacity:1;transform:translate(-50%,-60%) scale(1)}100%{opacity:0;transform:translate(-50%,-80%) scale(.4)}}
.nav-spark{position:absolute;pointer-events:none;font-size:.8rem;animation:sparkle .65s ease-out forwards;z-index:20;color:#f0c040}
.content{flex:1;padding:1rem;max-width:680px;margin:0 auto;width:100%}

/* CARDS */
.card{background:#160830;border-radius:12px;border:.5px solid #3a2060;margin-bottom:.85rem;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.4)}
.card.dark{background:#0e0225;border-color:#4a2a70}
.card.featured{border-color:var(--gold);border-width:1px}
.card.spell-card{background:#0e0225;border-color:#4a2070}
.ch{padding:.8rem 1rem .65rem;border-bottom:.5px solid #2a1050;display:flex;align-items:center;gap:.5rem}
.ch-title{font-size:1.2rem;font-weight:600;color:#ffffff;letter-spacing:.02em;text-shadow:0 0 14px rgba(201,162,39,.25)}
.ch-meta{font-size:.9rem;color:#b090d0;margin-top:2px}
.tag{margin-left:auto;font-size:.85rem;letter-spacing:.05em;padding:4px 11px;border-radius:20px;background:#2a1050;color:#d0a8ff;white-space:nowrap;flex-shrink:0;border:.5px solid #4a2080}
.cb{padding:.9rem 1.1rem;font-size:1.28rem;line-height:1.8;color:#ffffff;text-shadow:0 0 18px rgba(201,162,39,.18),0 0 4px rgba(160,100,255,.12)}
.cb p+p{margin-top:.55rem}
.cb strong{color:#ffb060;text-shadow:0 0 16px rgba(255,176,96,.35)}
.cb em{color:#c8a8ff;font-style:italic}

/* TEXT GLOW */
.cb,.tl-txt,.art-desc,.result-box,.reading-text,.ritual-result-body,
.potion-lore,.garnish-lore,.card-body{color:#ffffff;text-shadow:0 0 18px rgba(201,162,39,.2),0 0 4px rgba(160,100,255,.12)}
.art-name,.ch-title,.pin-name{color:#ffffff;text-shadow:0 0 18px rgba(201,162,39,.35),0 0 6px rgba(201,162,39,.15)}

/* SEARCH */
.sbar{display:flex;align-items:center;gap:.5rem;background:#1a0838;border:1px solid #3a2060;border-radius:8px;padding:.48rem .75rem;margin-bottom:.8rem}
.sbar input{border:none;outline:none;font-size:1.08rem;flex:1;background:none;color:#ffffff;font-family:inherit}
.sbar input::placeholder{color:#9080b8}

/* TABS */
.tabs{display:flex;gap:.4rem;margin-bottom:.75rem;flex-wrap:wrap}
.tab{font-size:1rem;padding:.5rem 1.05rem;border:1px solid #4a2080;border-radius:20px;background:#120228;cursor:pointer;color:#ffffff;font-family:inherit;transition:all .15s}
.tab.active{background:#2a0a50;color:var(--gold);border-color:var(--gold)}
.tab:hover:not(.active){border-color:var(--gold);color:#ffffff}

/* CHIPS */
.chip{font-size:1rem;padding:.46rem 1rem;border:1px solid #4a3080;border-radius:20px;background:#1a0838;cursor:pointer;color:#ffffff;font-family:inherit;transition:all .15s;line-height:1.3;text-align:center}
.chip:hover:not(.sel){background:#2a1050;border-color:var(--gold)}
.chip.sel{background:#2a0a50;color:var(--gold);border-color:var(--gold);text-shadow:0 0 10px rgba(240,192,64,.4)}
.chip.intent-chip.sel{background:#3a0a60;color:#ffffff;border-color:#c060ff}
.chip.moon-chip.sel{background:#0a1840;color:#ffffff;border-color:#4090f0}
.chip.trad-chip.sel{background:#3a1000;color:#ffffff;border-color:#f08030}
.chip-hint{font-size:.86rem;color:#c8b8e8;opacity:.8;display:block;margin-top:1px}

/* TIMELINE */
.tl{position:relative;padding-left:1.4rem}
.tl::before{content:'';position:absolute;left:.5rem;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,var(--blood),rgba(255,112,112,.1))}
.tl-item{position:relative;margin-bottom:1.1rem}
.tl-dot{position:absolute;left:-1.25rem;top:.22rem;width:9px;height:9px;border-radius:50%;background:var(--blood);border:2px solid #0a0118;box-shadow:0 0 0 1px var(--blood)}
.tl-yr{font-size:1.15rem;font-weight:600;color:#ff9060;letter-spacing:.06em;margin-bottom:.1rem}
.tl-txt{font-size:1.24rem;line-height:1.7;color:#ffffff}
.tl-txt strong{color:#ffffff;font-weight:700}

/* MAP */
.map-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-bottom:.8rem}
.map-pin{background:#150830;border:.5px solid #3a2060;border-radius:10px;padding:.65rem .75rem;cursor:pointer;transition:all .15s}
.map-pin:hover{border-color:var(--blood)}
.map-pin.active{border-color:var(--blood);border-width:1px;background:#1a0820}
.pin-name{font-size:1.03rem;font-weight:600;color:#ffffff}
.pin-count{font-size:.9rem;color:var(--blood);margin-top:.1rem}
.pin-detail{font-size:.98rem;color:#e8e0f8;margin-top:.35rem;line-height:1.5;display:none;border-top:.5px solid #2a1050;padding-top:.35rem}
.map-pin.active .pin-detail{display:block}

/* ARTIFACTS */
.art-item{display:flex;align-items:flex-start;gap:.7rem;padding:.8rem 1rem;border-bottom:.5px solid #1a0830}
.art-item:last-child{border-bottom:none}
.art-thumb{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#2a0a40,#5a1a20);border:.5px solid #4a2a60;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.3rem}
.art-name{font-size:1.08rem;font-weight:600;color:#ffffff;margin-bottom:.12rem}
.art-loc{font-size:.92rem;color:#9080b0}
.art-desc{font-size:1rem;color:#e8e0f8;margin-top:.18rem;line-height:1.5}

/* MINI CARDS GRID */
.g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-bottom:.8rem}
.mc{background:#160830;border:1px solid #3a2060;border-radius:10px;padding:.8rem;text-align:center;cursor:pointer;transition:all .2s}
.mc:hover{border-color:var(--gold);background:#1e0a3a;transform:translateY(-2px)}
.mc-lb{font-size:1rem;font-weight:600;color:#ffffff;letter-spacing:.03em}
.mc-sub{font-size:.9rem;color:#c8b8e8;margin-top:.1rem}

/* RESULT BOX */
.result-box{background:#120228;border:.5px solid #3a2060;border-radius:8px;padding:.85rem 1.05rem;font-size:1.06rem;line-height:1.68;color:#ffffff;display:none;margin-top:.55rem}
.result-box.vis{display:block}
.result-box p{margin-bottom:.5rem}
.result-box p:last-child{margin-bottom:0}

/* LOADING */
.loading{text-align:center;padding:1.5rem;color:#e8e0f8;font-size:1.06rem;display:none}
.spin{display:inline-block;font-size:1.3rem;margin-bottom:.4rem;animation:spin 2s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* BUTTONS */
.fbtn{display:flex;align-items:center;justify-content:center;gap:.4rem;width:100%;padding:.7rem;border:1px solid #6a40a0;border-radius:8px;background:#120228;color:#ffffff;font-size:1.02rem;cursor:pointer;margin-top:.5rem;font-family:inherit;transition:all .15s}
.fbtn:hover{background:#1e0840;border-color:var(--gold)}

/* RITUAL */
.ritual-section{margin-bottom:.9rem}
.ritual-label{font-size:.92rem;font-weight:600;color:#e8e0f8;letter-spacing:.09em;text-transform:uppercase;margin-bottom:.45rem;display:flex;align-items:center;gap:.4rem}
.ritual-label::after{content:'';flex:1;height:.5px;background:rgba(201,162,39,.2)}
.chips{display:flex;flex-wrap:wrap;gap:.38rem}
.compose-btn{width:100%;padding:.8rem;background:#2a0a50;color:var(--gold);border:1px solid var(--gold);border-radius:10px;font-size:1.06rem;cursor:pointer;letter-spacing:.07em;margin-top:.7rem;font-family:Georgia,serif;transition:all .2s}
.compose-btn:hover{background:#3a1060}
.ritual-result{background:#06010e;border:1px solid #7a3aae;border-radius:12px;padding:1rem 1.1rem;margin-top:.8rem;display:none}
.ritual-result.vis{display:block}
.ritual-result-title{font-size:.94rem;font-weight:600;color:var(--gold);letter-spacing:.09em;text-transform:uppercase;margin-bottom:.5rem}
.ritual-result-body{font-size:1.08rem;line-height:1.72;color:#ffffff}
.ritual-result-body p{margin-bottom:.55rem;color:#ffffff}
.selection-summary{background:#1a0838;border:1px solid #4a2080;border-radius:8px;padding:.65rem .9rem;margin:.45rem 0;font-size:1rem;color:#ffffff;line-height:1.55;display:none}
.selection-summary.vis{display:block}

/* POTIONS */
.potion-hero{background:linear-gradient(160deg,#0e0318 0%,#1e0a30 60%,#2a0a1a 100%);border-radius:12px;padding:1.1rem 1rem .9rem;margin-bottom:.85rem;text-align:center;border:1px solid #3a1a5e}
.potion-hero h2{font-family:Georgia,serif;font-size:1.7rem;color:var(--gold)}
.potion-hero p{font-size:1rem;color:#e8e0f8;margin-top:.3rem;line-height:1.55}
.age-notice{font-size:.9rem;color:#6a5080;margin-top:.55rem;padding:.35rem .75rem;border:.5px solid #3a1a5e;border-radius:20px;display:inline-block}
.potion-card{background:#0e0225;border:1px solid #4a2a70;border-radius:12px;margin-bottom:.8rem;overflow:hidden}
.potion-header{padding:.8rem 1rem .65rem;display:flex;align-items:flex-start;gap:.7rem}
.potion-icon{font-size:1.85rem;flex-shrink:0}
.potion-spell-name{font-family:Georgia,serif;font-size:1.22rem;color:var(--gold)}
.potion-real-name{font-size:.92rem;color:#9080b8;margin-top:.18rem;font-style:italic}
.potion-spirit-tag{margin-left:auto;font-size:.84rem;padding:3px 9px;border-radius:20px;background:#2a0a40;color:#c0a0f0;border:.5px solid #4a2a70;white-space:nowrap;flex-shrink:0}
.potion-divider{height:.5px;background:linear-gradient(to right,transparent,#3a1a5e,transparent)}
.potion-body{padding:.75rem 1rem}
.potion-lore{font-size:1.22rem;line-height:1.7;color:#ffffff;font-style:italic;margin-bottom:.6rem}
.potion-lore strong{color:#f0d070;font-style:normal}
.ingredients{display:flex;flex-wrap:wrap;gap:.32rem;margin-bottom:.55rem}
.ingr{font-size:.92rem;padding:.28rem .72rem;background:#1a0830;border:.5px solid #4a2a60;border-radius:20px;color:#b090d0}
.potion-serve{font-size:.94rem;color:#d8cef0}
.p-filter{font-size:.94rem;padding:.36rem .88rem;border:1px solid #4a2080;border-radius:20px;background:#120228;cursor:pointer;color:#ffffff;font-family:inherit;transition:all .15s}
.p-filter.active{background:#2a0a50;color:var(--gold);border-color:var(--gold)}
.p-filter:hover:not(.active){border-color:var(--gold);color:#ffffff}
.potion-filters{display:flex;gap:.38rem;flex-wrap:wrap;margin-bottom:.8rem}
.custom-potion-section{background:#06010f;border:1px solid #3a1a5e;border-radius:12px;padding:.9rem 1rem;margin-bottom:.85rem}
.custom-potion-title{font-family:Georgia,serif;font-size:1.15rem;color:var(--gold);margin-bottom:.25rem}
.custom-potion-sub{font-size:.98rem;color:#e8e0f8;margin-bottom:.8rem}
.potion-input-row{display:flex;gap:.45rem;margin-top:.55rem}
.potion-input-row input,.potion-input-row select{flex:1;border:.5px solid #3a1a5e;border-radius:8px;padding:.55rem .8rem;font-size:1rem;outline:none;font-family:inherit;background:#08020f;color:#e8e0f8}
.potion-summon-btn{width:100%;padding:.7rem;background:linear-gradient(135deg,#2a1050,#1a0830);color:var(--gold);border:1px solid #4a2a70;border-radius:8px;font-size:1.04rem;cursor:pointer;font-family:Georgia,serif;letter-spacing:.07em;margin-top:.6rem}
.potion-result{background:#08020f;border:1px solid #4a2070;border-radius:10px;padding:.85rem 1rem;margin-top:.7rem;display:none}
.potion-result.vis{display:block}
.potion-result-name{font-family:Georgia,serif;font-size:1.32rem;color:var(--gold);margin-bottom:.28rem}
.potion-result-body{font-size:1.22rem;line-height:1.7;color:#ffffff}

/* ORACLE */
