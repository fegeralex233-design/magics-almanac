// ═══ CURSOR / TOUCH SPARKLE TRAIL ═══
(function(){
  const canvas=document.createElement('canvas');
  canvas.id='sparkleTrailCanvas';
  canvas.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999';
  document.body.appendChild(canvas);
  const ctx=canvas.getContext('2d');
  const SYMS=['✦','✧','⋆','∗','✶','⭐'];
  const COLORS=['#f0c040','#c090f0','#ff9050','#e0d0ff'];
  let W,H,dpr;
  function resize(){
    dpr=Math.min(window.devicePixelRatio||1,2);
    W=window.innerWidth;H=window.innerHeight;
    canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  resize();window.addEventListener('resize',resize);

  let particles=[];
  let lastX=null,lastY=null,lastSpawn=0;
  const SPAWN_INTERVAL=28; // ms between sparkles while moving, so a fast swipe doesn't flood the canvas

  function spawnAt(x,y){
    const sym=SYMS[Math.floor(Math.random()*SYMS.length)];
    particles.push({
      x:x+(Math.random()*10-5),y:y+(Math.random()*10-5),
      sym,size:4+Math.random()*4,
      color:COLORS[Math.floor(Math.random()*COLORS.length)],
      alpha:1,life:0,maxLife:16+Math.random()*10,
      drift:(Math.random()*.6-.3),rise:-(0.3+Math.random()*.5),
      rot:Math.random()*Math.PI*2,vr:(Math.random()*.06-.03)
    });
    if(particles.length>120)particles.splice(0,particles.length-120);
  }

  function onMove(x,y){
    const now=performance.now();
    if(lastX!==null){
      const dx=x-lastX,dy=y-lastY;
      const dist=Math.sqrt(dx*dx+dy*dy);
      // Spawn along the segment for fast moves so the trail has no gaps,
      // but throttle by time for slow/idle hovering so it stays light.
      if(dist>6){
        const steps=Math.min(Math.ceil(dist/14),6);
        for(let i=1;i<=steps;i++)spawnAt(lastX+dx*i/steps,lastY+dy*i/steps);
        lastSpawn=now;
      }else if(now-lastSpawn>SPAWN_INTERVAL){
        spawnAt(x,y);lastSpawn=now;
      }
    }
    lastX=x;lastY=y;
  }

  window.addEventListener('mousemove',e=>onMove(e.clientX,e.clientY),{passive:true});
  window.addEventListener('touchmove',e=>{
    if(e.touches&&e.touches.length)onMove(e.touches[0].clientX,e.touches[0].clientY);
  },{passive:true});
  window.addEventListener('touchstart',e=>{
    if(e.touches&&e.touches.length){lastX=e.touches[0].clientX;lastY=e.touches[0].clientY;}
  },{passive:true});
  window.addEventListener('touchend',()=>{lastX=null;lastY=null;},{passive:true});
  window.addEventListener('mouseleave',()=>{lastX=null;lastY=null;});

  let rafId=null;
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];
      p.life++;p.x+=p.drift;p.y+=p.rise;p.rot+=p.vr;
      const pr=p.life/p.maxLife;
      p.alpha=pr<.15?pr/.15:1-((pr-.15)/.85);
      if(p.life>=p.maxLife){particles.splice(i,1);continue;}
      ctx.save();
      ctx.globalAlpha=Math.max(0,p.alpha);
      ctx.translate(p.x,p.y);ctx.rotate(p.rot);
      ctx.shadowBlur=8;ctx.shadowColor=p.color;
      ctx.fillStyle=p.color;
      ctx.font=`${p.size}px serif`;ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(p.sym,0,0);
      ctx.restore();
    }
    if(!document.hidden)rafId=requestAnimationFrame(draw);else rafId=null;
  }
  document.addEventListener('visibilitychange',()=>{if(!document.hidden&&rafId===null)rafId=requestAnimationFrame(draw);});
  draw();
})();

