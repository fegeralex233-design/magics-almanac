// ═══ FAIRY VILLAGE ANIMATION ═══════════════════════════════════════
function startFairyVillage(){
  const canvas=document.getElementById('fairyVillageCanvas');
  if(!canvas)return;
  const W=canvas.offsetWidth||360,H=180;
  const dpr=Math.min(window.devicePixelRatio||1,2);
  canvas.width=W*dpr;canvas.height=H*dpr;
  canvas.style.width=W+'px';canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');
  ctx.setTransform(dpr,0,0,dpr,0,0);

  // Fairy sprites flying around
  const fairies=[
    {x:W*.2,y:H*.4,vx:.6,vy:-.3,ph:0,spd:.04,col:'#ffd76a',size:1.2},
    {x:W*.6,y:H*.3,vx:-.5,vy:.2,ph:1.5,spd:.035,col:'#c0a0ff',size:1.0},
    {x:W*.8,y:H*.6,vx:-.4,vy:-.4,ph:3,spd:.05,col:'#7ee8ff',size:.9},
    {x:W*.4,y:H*.7,vx:.7,vy:.1,ph:4.5,spd:.03,col:'#ffa0c0',size:1.1},
    {x:W*.1,y:H*.6,vx:.5,vy:-.2,ph:2,spd:.045,col:'#a0ffb0',size:.8},
  ];
  // Stars
  const stars=Array.from({length:40},()=>({x:Math.random()*W,y:Math.random()*H*.6,r:Math.random()*.8+.2,ph:Math.random()*Math.PI*2,spd:Math.random()*.02+.008}));
  // Mushrooms (fairy houses)
  const mushrooms=[
    {x:W*.15,y:H*.88,scale:.7,col:'#c03030'},
    {x:W*.35,y:H*.9,scale:.5,col:'#8030c0'},
    {x:W*.55,y:H*.87,scale:.65,col:'#c07030'},
    {x:W*.75,y:H*.9,scale:.55,col:'#308040'},
    {x:W*.88,y:H*.86,scale:.6,col:'#a03060'},
  ];
  // Ground flowers
  const flowers=Array.from({length:12},(_,i)=>({x:(i+.5)/12*W,y:H*.82+Math.random()*H*.08,r:2+Math.random()*2,col:['#ffd76a','#ff90c0','#90c0ff','#c0ff90'][i%4]}));

  let raf;
  function draw(){
    ctx.clearRect(0,0,W,H);
    // Sky gradient
    const sky=ctx.createLinearGradient(0,0,0,H);
    sky.addColorStop(0,'#02010a');sky.addColorStop(.6,'#0a0320');sky.addColorStop(1,'#04100a');
    ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
    // Stars twinkle
    stars.forEach(s=>{s.ph+=s.spd;const a=.1+.7*(.5+.5*Math.sin(s.ph));ctx.globalAlpha=a;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle='#ffffff';ctx.fill();});
    ctx.globalAlpha=1;
    // Moonlight glow
    const moon=ctx.createRadialGradient(W*.75,H*.15,2,W*.75,H*.15,50);
    moon.addColorStop(0,'rgba(220,200,255,.35)');moon.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=moon;ctx.fillRect(0,0,W,H);
    // Ground
    const grd=ctx.createLinearGradient(0,H*.78,0,H);
    grd.addColorStop(0,'#081808');grd.addColorStop(1,'#0a200a');
    ctx.fillStyle=grd;ctx.fillRect(0,H*.78,W,H*.22);
    // Flowers
    flowers.forEach(f=>{ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,Math.PI*2);ctx.fillStyle=f.col;ctx.globalAlpha=.7;ctx.fill();ctx.globalAlpha=1;});
    // Mushroom houses
    mushrooms.forEach(m=>{
      const sc=m.scale,bx=m.x,by=m.y;
      // Stem
      ctx.fillStyle='#e8d0a0';ctx.globalAlpha=.9;
      ctx.fillRect(bx-8*sc,by-16*sc,16*sc,16*sc);
      // Cap
      ctx.beginPath();ctx.ellipse(bx,by-16*sc,20*sc,14*sc,0,Math.PI,0);
      ctx.fillStyle=m.col;ctx.globalAlpha=.85;ctx.fill();
      // Spots
      ctx.fillStyle='rgba(255,255,255,.5)';
      [[bx-6*sc,by-20*sc,3*sc],[bx+5*sc,by-22*sc,2*sc],[bx,by-26*sc,2.5*sc]].forEach(([sx,sy,sr])=>{ctx.beginPath();ctx.arc(sx,sy,sr,0,Math.PI*2);ctx.fill();});
      // Glowing window
      const wgl=ctx.createRadialGradient(bx,by-9*sc,0,bx,by-9*sc,4*sc);
      wgl.addColorStop(0,'rgba(255,240,150,.9)');wgl.addColorStop(1,'rgba(255,200,50,0)');
      ctx.fillStyle=wgl;ctx.beginPath();ctx.arc(bx,by-9*sc,4*sc,0,Math.PI*2);ctx.fill();
      ctx.globalAlpha=1;
    });
    // Flying fairies
    fairies.forEach(f=>{
      f.ph+=f.spd;
      f.x+=f.vx+Math.sin(f.ph*.7)*.5;
      f.y+=f.vy+Math.cos(f.ph*.5)*.4;
      if(f.x<0)f.x=W;if(f.x>W)f.x=0;
      if(f.y<5)f.vy=Math.abs(f.vy);if(f.y>H*.78)f.vy=-Math.abs(f.vy);
      // Glow
      const gl=ctx.createRadialGradient(f.x,f.y,0,f.x,f.y,12*f.size);
      gl.addColorStop(0,f.col);gl.addColorStop(1,'rgba(0,0,0,0)');
      ctx.globalAlpha=.6;ctx.beginPath();ctx.arc(f.x,f.y,12*f.size,0,Math.PI*2);ctx.fillStyle=gl;ctx.fill();
      // Body dot
      ctx.globalAlpha=.9;ctx.beginPath();ctx.arc(f.x,f.y,2.2*f.size,0,Math.PI*2);ctx.fillStyle='#ffffff';ctx.fill();
      // Wings
      ctx.globalAlpha=.35;ctx.strokeStyle=f.col;ctx.lineWidth=.8;
      const ww=7*f.size,wh=4*f.size;
      ctx.beginPath();ctx.ellipse(f.x-ww*.5,f.y,ww,wh,-.3,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.ellipse(f.x+ww*.5,f.y,ww,wh,.3,0,Math.PI*2);ctx.stroke();
      // Sparkle trail
      ctx.globalAlpha=.5;ctx.fillStyle=f.col;
      ctx.beginPath();ctx.arc(f.x-f.vx*4,f.y-f.vy*4,1.2*f.size,0,Math.PI*2);ctx.fill();
      ctx.globalAlpha=1;
    });
    if(document.getElementById('fairyVillageCanvas'))raf=requestAnimationFrame(draw);
  }
  draw();
}


// ═══ FAIRY DUST ═════════════════════════════════════════════════════
function sprayFairyDust(){
  const card=document.getElementById('fairyResultCard');
  const target=card||document.getElementById('portraitResult');
  if(!target)return;

  // Inject styles once
  if(!document.getElementById('fairyDustStyle')){
    const st=document.createElement('style');
    st.id='fairyDustStyle';
    st.textContent=`
      @keyframes dustFall{
        0%  {transform:translate(0,0) rotate(0deg) scale(1);   opacity:1}
        60% {opacity:.8}
        100%{transform:translate(var(--dx),var(--dy)) rotate(var(--dr)) scale(.3);opacity:0}
      }
      .fairy-dust-particle{
        position:fixed;pointer-events:none;z-index:9999;
        font-size:var(--fs);
        animation:dustFall var(--dur) ease-in forwards;
      }
    `;
    document.head.appendChild(st);
  }

  const glyphs=['✦','✧','⋆','·','★','✨','⭐','💫','🌟','❋','✼','❀'];
  const colors=['#f0c040','#e0d0ff','#ffffff','#ffd6fa','#c0ffee','#ffe4b5','#b0d8ff'];
  const rect=target.getBoundingClientRect();

  // Three waves of dust — immediate, then 600ms, then 1200ms
  [0, 600, 1200].forEach(delay=>{
    setTimeout(()=>{
      const count = delay===0 ? 28 : 16;
      for(let i=0;i<count;i++){
        const p=document.createElement('span');
        p.className='fairy-dust-particle';
        // Start position scattered across the card + above it
        const startX=rect.left + Math.random()*rect.width;
        const startY=rect.top  - 20 + Math.random()*(rect.height+60);
        const dx=(Math.random()-0.5)*180;
        const dy=40+Math.random()*200;
        const dr=(Math.random()-0.5)*360;
        const dur=(0.9+Math.random()*1.4).toFixed(2);
        const fs=(0.55+Math.random()*1.1).toFixed(2);
        const col=colors[Math.floor(Math.random()*colors.length)];
        p.style.cssText=`
          left:${startX}px;top:${startY}px;
          color:${col};text-shadow:0 0 6px ${col};
          --dx:${dx}px;--dy:${dy}px;--dr:${dr}deg;
          --dur:${dur}s;--fs:${fs}rem;
          animation-delay:${(Math.random()*0.4).toFixed(2)}s;
        `;
        p.textContent=glyphs[Math.floor(Math.random()*glyphs.length)];
        document.body.appendChild(p);
        setTimeout(()=>p.remove(), (parseFloat(dur)+0.6)*1000);
      }
    }, delay);
  });
}


function getLifePath(dateStr){
  const digits=dateStr.replace(/-/g,'').split('').map(Number);
  let sum=digits.reduce((a,b)=>a+b,0);
  while(sum>9&&sum!==11&&sum!==22&&sum!==33) sum=sum.toString().split('').map(Number).reduce((a,b)=>a+b,0);
  return sum;
}

