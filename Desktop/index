function wopSetCat(cat){
  wopCurrentCat=cat;
  var btns=document.querySelectorAll('#content button');
  for(var i=0;i<WORDS_OF_POWER.length;i++){
    var d=WORDS_OF_POWER[i];
    if(btns[i]){
      if(d.cat===cat){
        btns[i].style.background=d.color;
        btns[i].style.borderColor=d.color;
        btns[i].style.color='#fff';
      } else {
        btns[i].style.background='none';
        btns[i].style.borderColor='rgba(212,175,55,.3)';
        btns[i].style.color='#9a7a4a';
      }
    }
  }
  wopRenderSpells();
}

function wopRenderSpells(){
  var section=null;
  for(var i=0;i<WORDS_OF_POWER.length;i++){if(WORDS_OF_POWER[i].cat===wopCurrentCat){section=WORDS_OF_POWER[i];break;}}
