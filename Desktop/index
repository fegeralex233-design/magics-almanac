function seekSearch(q){
  var box=document.getElementById('seekResults');
  if(!box)return;
  var raw=(q||'').trim().toLowerCase();
  if(!raw){box.innerHTML='';return;}

  // Save to history
  try{
    var hist=JSON.parse(localStorage.getItem('magics_seek_history')||'[]');
    hist=hist.filter(function(x){return x!==raw;});
    hist.unshift(raw);
    if(hist.length>12)hist=hist.slice(0,12);
    localStorage.setItem('magics_seek_history',JSON.stringify(hist));
  }catch(e){}

  // Score results
  var terms=raw.split(/\s+/);
  var scored=[];
  for(var i=0;i<SEEK_INDEX.length;i++){
    var entry=SEEK_INDEX[i];
    var score=0;
    var allKeys=entry.keys.concat([entry.name.toLowerCase(),entry.tab]);
    for(var t=0;t<terms.length;t++){
      var term=terms[t];
      if(term.length<3)continue;
      for(var k=0;k<allKeys.length;k++){
        if(allKeys[k]===term)score+=10;
        else if(allKeys[k].indexOf(term)===0)score+=6;
        else if(allKeys[k].indexOf(term)>=0)score+=4;
      }
    }
    if(score>=4)scored.push({entry:entry,score:score});
  }
  scored.sort(function(a,b){return b.score-a.score;});

  if(!scored.length){
    box.innerHTML='<div style="text-align:center;padding:1.5rem;color:#806090;font-size:.95rem">Nothing found for <em style="color:#c0a8ff">'+q+'</em> — try a different word</div>';
    return;
  }

  var html='<div style="margin-bottom:.4rem;font-size:.78rem;color:#806090;letter-spacing:.06em">'+scored.length+' result'+(scored.length!==1?'s':'')+' for <em style="color:#c0a8ff">'+q+'</em></div>';
  for(var r=0;r<scored.length;r++){
    var e=scored[r].entry;
    html+='<div style="background:rgba(16,2,40,.7);border:1px solid rgba(120,80,200,.3);border-radius:12px;padding:.85rem 1rem;margin-bottom:.65rem;cursor:pointer;transition:border-color .2s,background .2s" onclick="go(\''+e.tab+'\')" onmouseover="this.style.borderColor=\'rgba(201,162,39,.6)\';this.style.background=\'rgba(30,8,70,.8)\'" onmouseout="this.style.borderColor=\'rgba(120,80,200,.3)\';this.style.background=\'rgba(16,2,40,.7)\'">';
    html+='<div style="display:flex;align-items:center;gap:.55rem;margin-bottom:.4rem">';
    html+='<span style="font-size:1.3rem">'+e.icon+'</span>';
    html+='<span style="font-family:Georgia,serif;font-size:1.05rem;color:var(--gold);font-weight:600">'+e.name+'</span>';
    html+='<span style="margin-left:auto;font-size:.75rem;color:rgba(201,162,39,.5);letter-spacing:.06em;text-transform:uppercase">open →</span>';
    html+='</div>';
    html+='<div style="font-size:.88rem;color:#c0b0e0;line-height:1.65">'+e.how+'</div>';
    html+='</div>';
  }
  box.innerHTML=html;
}
