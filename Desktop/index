var _lcInterval=null;
function startLifeClock(birthdayStr){
  if(_lcInterval)clearInterval(_lcInterval);
  var parts=birthdayStr.split('-');
  var bYear=parseInt(parts[0]),bMonth=parseInt(parts[1])-1,bDay=parseInt(parts[2]);
  var born=new Date(bYear,bMonth,bDay,0,0,0,0);
  function tick(){
    var now=new Date();
    var ms=now-born;
    if(ms<0){document.getElementById('hh-life-clock').style.display='none';return;}
    var totalHours=Math.floor(ms/3600000);
    var totalDays=Math.floor(ms/86400000);
    var years=now.getFullYear()-bYear;
    var hadBdayThisYear=(now.getMonth()>bMonth)||(now.getMonth()===bMonth&&now.getDate()>=bDay);
    if(!hadBdayThisYear)years--;
    var el=document.getElementById('hh-life-clock');
    if(!el)return;
    el.style.display='block';
    document.getElementById('lc-years').textContent=years.toLocaleString();
    document.getElementById('lc-days').textContent=totalDays.toLocaleString();
    document.getElementById('lc-hours').textContent=totalHours.toLocaleString();
    // Next birthday countdown
    var nextBday=new Date(now.getFullYear(),bMonth,bDay);
    if(nextBday<=now)nextBday=new Date(now.getFullYear()+1,bMonth,bDay);
    var daysTo=Math.ceil((nextBday-now)/86400000);
    var nb=document.getElementById('lc-next-bday');
    if(nb){
      if(daysTo===0)nb.textContent='🎂 Happy Birthday!';
