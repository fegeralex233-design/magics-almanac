function stopAllSounds(){
  if(currentSource){try{currentSource.stop();}catch(e){}currentSource=null;}
  if(currentBtn){currentBtn.classList.remove('playing');const idx=currentBtn.id.replace('sbtn','');const ind=document.getElementById('sind'+idx);if(ind)ind.style.background='#3a2060';}
  currentBtn=null;
}
function toggleSound(i){
  const btn=document.getElementById('sbtn'+i);const ind=document.getElementById('sind'+i);
  if(btn.classList.contains('playing')){stopAllSounds();return;}
  stopAllSounds();
  if(!audioContext)audioContext=new(window.AudioContext||window.webkitAudioContext)();
  const s=soundDefs[i];const ac=audioContext;
  const buf=ac.createBuffer(2,ac.sampleRate*4,ac.sampleRate);
  for(let c=0;c<2;c++){
    const d=buf.getChannelData(c);
    for(let j=0;j<d.length;j++){
      if(s.type==='fire'){d[j]=(Math.random()*2-1)*0.3*Math.pow(Math.random(),2);}
      else if(s.type==='rain'){d[j]=(Math.random()*2-1)*0.15*(Math.random()<0.02?5:1);}
      else if(s.type==='ocean'){d[j]=(Math.random()*2-1)*0.4*Math.sin(j/ac.sampleRate*0.3)*(0.5+0.5*Math.sin(j/ac.sampleRate*0.1));}
      else if(s.type==='forest'){d[j]=(Math.random()*2-1)*0.2*(1+Math.sin(j/ac.sampleRate*0.5));}
      else if(s.type==='storm'){d[j]=(Math.random()*2-1)*0.5*(Math.random()<0.001?8:1)*Math.max(0,Math.sin(j/ac.sampleRate*0.2));}
      else if(s.type==='candle'){d[j]=(Math.random()*2-1)*0.05;}
      else{d[j]=(Math.random()*2-1)*0.25;}
    }
  }
  if(s.type==='bowl'||s.type==='cosmic'){
    const osc=ac.createOscillator();const gain=ac.createGain();
    osc.frequency.value=s.freq;osc.type=s.type==='bowl'?'sine':'sine';
    gain.gain.value=0.12;osc.connect(gain);gain.connect(ac.destination);osc.start();
    currentSource={stop:()=>{osc.stop();gain.disconnect();}};
  }else{
    const src=ac.createBufferSource();src.buffer=buf;src.loop=true;
    const gain=ac.createGain();gain.gain.value=0.6;
    const filter=ac.createBiquadFilter();filter.type='lowpass';filter.frequency.value=s.freq*3+200;
    src.connect(filter);filter.connect(gain);gain.connect(ac.destination);src.start();
    currentSource=src;
  }
  currentBtn=btn;btn.classList.add('playing');if(ind)ind.style.background='#60d060';
}

