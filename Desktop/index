  );
}

function nessieStart(){
  if(nessieRunning)return;
  nessieScore=0;nessieTimeLeft=45;nessieRunning=true;nessieStage=1;
  nessieTotalSpots=0;nessieSpellMode=false;
  var g=function(id){return document.getElementById(id);};
  g('nessie-score').textContent='0';
  g('nessie-time').textContent='45';
  var btn=g('nessie-btn');
  if(btn){btn.disabled=true;btn.textContent='🌊 Swimming...';}
  g('nessie-msg').textContent='Stage 1 — Nessie is splashing around. Tap her!';
  var badge=g('nessie-stage-badge');
  if(badge){badge.style.display='inline';badge.textContent='Stage 1 — Swimming';}
  nessieCountdown=setInterval(function(){
    nessieTimeLeft--;
    g('nessie-time').textContent=nessieTimeLeft;
    if(nessieTimeLeft===30){nessieUpgradeStage(2);}
    if(nessieTimeLeft===15){nessieUpgradeStage(3);}
    if(nessieTimeLeft<=0){clearInterval(nessieCountdown);nessieEnd();}
  },1000);
  nessieScheduleNext();
}

function nessieUpgradeStage(s){
  nessieStage=s;
  clearTimeout(nessieTimer);
  clearTimeout(nessieHideTimer);
  var spot=document.getElementById('nessie-spot');
  if(spot)spot.style.display='none';
  nessieSpellMode=false;
  var prompt=document.getElementById('nessie-spell-prompt');
  if(prompt)prompt.style.display='none';
  var badge=document.getElementById('nessie-stage-badge');
  var msg=document.getElementById('nessie-msg');
  if(s===2){
    if(badge)badge.textContent='Stage 2 — Rising!';
    if(msg)msg.textContent='She is rising out of the water! Faster!';
  } else {
    if(badge){badge.textContent='Stage 3 — SHE FLIES!';badge.style.color='#7DF9A0';badge.style.animation='nessiePulse .7s ease-in-out infinite';}
    if(msg)msg.innerHTML='<span style="color:#7DF9A0;font-weight:bold;font-family:Georgia,serif">She is flying! Shout: Messy Nessie back to sea!</span>';
    var prompt=document.getElementById('nessie-spell-prompt');
    if(prompt){prompt.style.display='block';prompt.style.animation='nessieGlow 1s ease-in-out infinite';}
  }
  setTimeout(function(){nessieScheduleNext();},350);
}

function nessieScheduleNext(){
  if(!nessieRunning)return;
  // gaps: stage1=1.6-3s, stage2=0.8-1.6s, stage3=0.45-1s
  var lo=[0,1600,800,450];
  var range=[0,1400,800,550];
  var delay=lo[nessieStage]+Math.random()*range[nessieStage];
  nessieTimer=setTimeout(function(){nessieShow();},delay);
}

function nessieShow(){
  if(!nessieRunning)return;
  var g=function(id){return document.getElementById(id);};
  var spot=g('nessie-spot');
  var sprite=g('nessie-sprite');
  var taunt=g('nessie-taunt');
  if(!spot||!sprite)return;
  nessieTotalSpots++;
  var game=g('nessie-game');
  var W=game?game.offsetWidth:300;
  sprite.innerHTML=nessieGetSprite(nessieStage);
  taunt.textContent=nessieTaunt(nessieStage);
  // position: stage 1 = near water line (bottom 30-55px from lake top=240)
  //           stage 2 = mid-lake
  //           stage 3 = upper half, flying
  var maxY=nessieStage===1?150:nessieStage===2?120:80;
  var minY=nessieStage===1?120:nessieStage===2?60:10;
  var x=10+Math.random()*(W-85);
  var y=minY+Math.random()*(maxY-minY);
  spot.style.left=x+'px';
  spot.style.top=y+'px';
  spot.style.opacity='0';
  spot.style.display='block';
  nessieSpellMode=(nessieStage===3);
  setTimeout(function(){spot.style.opacity='1';},15);
  // stay time: stage1=1.8-2.4s, stage2=0.9-1.3s, stage3=0.65-0.95s
  var stayLo=[0,1800,900,650];
  var stayR=[0,600,400,300];
  var stay=stayLo[nessieStage]+Math.random()*stayR[nessieStage];
  nessieHideTimer=setTimeout(function(){nessieMiss(spot);},stay);
}

function nessieMiss(spot){
  if(!spot)spot=document.getElementById('nessie-spot');
  if(spot)spot.style.display='none';
  nessieSpellMode=false;
  nessieScheduleNext();
}

function nessieHit(el){
  if(!nessieRunning)return;
  clearTimeout(nessieHideTimer);
  var pts=nessieStage===3?2:1;
  nessieScore+=pts;
  var sc=document.getElementById('nessie-score');
  if(sc)sc.textContent=nessieScore;
  var x=parseFloat(el.style.left)||0;
  var y=parseFloat(el.style.top)||0;
  var fxLabel=nessieStage===3?'+2 ✨':'+1';
  var fxColor=nessieStage===3?'#7DF9A0':'#c8f0ff';
  var fxSize=nessieStage===3?'1.1rem':'.9rem';
  var fx=document.getElementById('nessie-hit-fx');
  var sp=document.getElementById('nessie-splash');
  if(fx){
    fx.textContent=fxLabel;
    fx.style.fontSize=fxSize;
    fx.style.color=fxColor;
    fx.style.left=(x+8)+'px';
    fx.style.top=(y-6)+'px';
    fx.style.display='block';
    fx.style.animation='none';
    setTimeout(function(){fx.style.animation='nessieScoreUp .75s ease-out forwards';},10);
  }
  if(sp){
    sp.style.left=(x+5)+'px';
    sp.style.top=(y+15)+'px';
    sp.style.display='block';
    sp.style.animation='none';
    sp.textContent=nessieStage===3?'🌊':'💦';
    setTimeout(function(){sp.style.animation='nessieSplash .55s ease-out forwards';},10);
  }
  el.style.display='none';
  nessieSpellMode=false;
  setTimeout(function(){
    if(fx)fx.style.display='none';
    if(sp)sp.style.display='none';
  },800);
  // Stage 3 hit: Nessie does a fly-around loop then splashes back and resets to Stage 1
  if(pts===2){
    nessieFlyAround();
  } else {
    nessieScheduleNext();
  }
}

function nessieFlyAround(){
  // Pause spawning while Nessie does her victory lap
  clearTimeout(nessieTimer);
  var g=function(id){return document.getElementById(id);};
  var lake=g('nessie-lake');
  var W=lake?lake.offsetWidth:300;
  var msg=g('nessie-msg');
