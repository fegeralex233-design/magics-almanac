        color: colors[Math.floor(Math.random() * colors.length)],
        type: Math.random() < 0.5 ? 'star' : 'dot'
      };
    }

    function drawStar(ctx, x, y, r, color, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.fillStyle = color;
      ctx.shadowColor = color;
      ctx.shadowBlur = 8;
      ctx.beginPath();
      var pts = 4, outer = r, inner = r * 0.4;
