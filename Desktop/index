async function castDefense(){
  const situation=document.getElementById('defenseInput')?.value?.trim()||'general bad luck and negativity';
  const moment=getMysticMoment();
  const l=document.getElementById('defenseLoading');const r=document.getElementById('defenseResult');
  l.style.display='block';r.style.display='none';
  const typeDesc={counter:'a counterspell — an immediate ritual word or action to flip bad luck into positive momentum RIGHT NOW',breaker:'a spell breaker — old-world incantations and rhyming sayings to shatter an ongoing negative streak or heavy stress',shield:'a spell shield — a proactive protective warding with historic protective phrases to guard against the negativity they\u2019re about to face'};
  const typeColor={counter:'#c060ff',breaker:'#ff8060',shield:'#60c0ff'};
  const typeIcon={counter:'⚡',breaker:'🔨',shield:'🛡️'};
  try{
    const text=await aiText(`Situation: ${situation}\nCurrent moment: ${moment.timeWindow}, ${moment.moon.name}, ${moment.season.name}.\nCast the ${_defType||'counter'}spell.`,`You are a keeper of old-world magic — a scholar of folk incantations, protective charms, and traditional rhyming spells drawn from Scottish, German, Irish, Italian, Norse, and Slavic folk magic traditions. When given a situation, you generate ${typeDesc[_defType||'counter']}.\n\nFormat:\nINCIP: [one line — dramatic opening line of the incantation]\nINCANT: [the full incantation — 4-8 lines, ideally with rhythm/rhyme, drawing from real folk magic tradition]\nRITUAL: [one specific physical action to perform alongside the words — a gesture, object, direction]\nSOURCE: [brief note on which folk tradition this draws from]\n\nMake it genuinely dramatic and historically grounded. Not generic. Specific to the situation described.`);
    const incip=(text.match(/INCIP:\s*([\s\S]+?)(?=INCANT:|$)/)||[])[1]?.trim()||'';
    const incant=(text.match(/INCANT:\s*([\s\S]+?)(?=RITUAL:|$)/)||[])[1]?.trim()||text;
    const ritual=(text.match(/RITUAL:\s*([\s\S]+?)(?=SOURCE:|$)/)||[])[1]?.trim()||'';
    const source=(text.match(/SOURCE:\s*([\s\S]+)/)||[])[1]?.trim()||'';
    const col=typeColor[_defType||'counter'];const ico=typeIcon[_defType||'counter'];
    l.style.display='none';
    r.innerHTML=`<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.65rem;padding-bottom:.55rem;border-bottom:.5px solid #2a0050"><span style="font-size:1.1rem">${ico}</span><div style="font-family:Georgia,serif;font-size:1rem;color:${col}">The spell is cast</div><div style="margin-left:auto;font-size:.76rem;color:#8060a8;letter-spacing:.08em">${moment.moon.name}</div></div>
    ${incip?`<div style="font-family:Georgia,serif;font-size:1.16rem;color:#ffffff;text-align:center;margin-bottom:.65rem;text-shadow:0 0 20px rgba(192,96,255,.3);line-height:1.5">${incip}</div>`:''}
    <div style="background:rgba(0,0,0,.5);border-left:2px solid ${col};border-radius:0 8px 8px 0;padding:.7rem .9rem;margin-bottom:.65rem;font-family:Georgia,serif;font-size:1rem;line-height:1.85;color:#e0c0ff;white-space:pre-line">${incant}</div>
    ${ritual?`<div style="background:#0a0018;border:.5px solid #3a0060;border-radius:8px;padding:.6rem .8rem;margin-bottom:.5rem"><div style="font-size:.74rem;color:#9060c0;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.25rem">Physical ritual</div><div style="font-size:.93rem;color:#e8e0f8;line-height:1.6">${ritual}</div></div>`:''}
    ${source?`<div style="font-size:.79rem;color:#8060a8;font-style:italic;margin-top:.3rem">Source: ${source}</div>`:''}`;
    r.style.display='block';
  }catch(e){l.style.display='none';r.innerHTML=e.message==='NOT_CONFIGURED'?relayErrorHTML():relayFailureHTML(e);r.style.display='block';}
}

