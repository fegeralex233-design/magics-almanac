// ═══ TOKEN SYSTEM ═══
var TOKEN_KEY = 'magics_tokens';
var TOKEN_DEFAULT = 66;
function tokensGet() {
  try { var v = localStorage.getItem(TOKEN_KEY); return v !== null ? parseInt(v, 10) : 0; } catch(e) { return 0; }
}
function tokensSet(n) {
  try { localStorage.setItem(TOKEN_KEY, String(Math.max(0, n))); } catch(e) {}
  tokensUpdateUI();
}
function tokensSpend(n) {
  var bal = tokensGet();
  if (bal < n) return false;
  tokensSet(bal - n);
  return true;
}
function tokensAdd(n) { tokensSet(tokensGet() + n); }
function tokensUpdateUI() {
  var el = document.getElementById('tokenCountDisplay');
  if (!el) return;
  var bal = tokensGet();
  el.textContent = 'T ' + bal + ' token' + (bal === 1 ? '' : 's');
  el.style.color = bal <= 10 ? '#ff6060' : bal <= 20 ? '#ffaa40' : '#a0e0a0';
}
function tokensClock() {
  var el = document.getElementById('tokenClockDisplay');
  if (!el) return;
  var now = new Date();
  var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
  var ampm = h >= 12 ? 'PM' : 'AM';
  h = h % 12 || 12;
  var mm = String(m).padStart(2,'0');
  var ss = String(s).padStart(2,'0');
  el.textContent = days[now.getDay()] + ' ' + months[now.getMonth()] + ' ' + now.getDate() + '  ' + h + ':' + mm + ':' + ss + ' ' + ampm;
}
  var _carouselIdx = 0;
