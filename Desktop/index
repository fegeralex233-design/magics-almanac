#app-nav button.active{background:rgba(201,162,39,.1);color:var(--gold);border-color:rgba(201,162,39,.4)}
#app-nav .nav-back{min-width:28px;padding:.3rem .5rem;color:rgba(201,162,39,.6);border-color:rgba(201,162,39,.25);font-size:.85rem}

.app-page{display:none;max-width:620px;margin:0 auto;padding:.8rem 1rem 4rem}
.app-page.active-page{display:block}

/* ── PAGE ELEMENTS ── */
.hero{text-align:center;padding:2rem 1rem 1.5rem;background:${headerGrad};border-bottom:.5px solid rgba(201,162,39,.2);position:relative;overflow:hidden;margin:0 -1rem 1.2rem}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,${accentGlow},transparent 65%);pointer-events:none}
.hero-sigil{font-size:3.2rem;margin-bottom:.65rem;filter:drop-shadow(0 0 24px ${accentColor});animation:heroFloat 4s ease-in-out infinite}
.hero-name{font-size:1.85rem;color:var(--gold);letter-spacing:.08em;margin-bottom:.2rem;text-shadow:0 0 28px rgba(240,192,64,.4)}
.hero-sub{font-size:.8rem;color:#b0a0c8;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.4rem}
.hero-product{font-size:.88rem;color:var(--accent);letter-spacing:.05em}
@keyframes heroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.section{background:#0e0228;border-radius:14px;border:.5px solid #2a1050;padding:1rem;margin-bottom:.9rem;position:relative;overflow:hidden}
.section::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent),transparent);opacity:.5}
.sec-label{font-size:.6rem;color:#6050a0;letter-spacing:.2em;text-transform:uppercase;margin-bottom:.5rem}
.sec-title{font-size:1.05rem;color:var(--gold);margin-bottom:.5rem;letter-spacing:.04em}
.sec-body{font-size:.88rem;color:#d8d0f0;line-height:1.75}
.pill{display:inline-block;padding:.2rem .65rem;border-radius:20px;font-size:.7rem;letter-spacing:.08em;background:rgba(201,162,39,.08);color:var(--gold);border:.5px solid rgba(201,162,39,.25);margin:.12rem .08rem}
.pill.accent{background:rgba(255,255,255,.05);color:var(--accent);border-color:${accentColor}44}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.55rem 0}
.mini-card{background:#06000e;border-radius:9px;padding:.5rem .65rem;border:.5px solid #1a0830}
.mini-label{font-size:.56rem;color:#5040a0;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.12rem}
.mini-val{font-size:.88rem;color:#e8d8ff}
.affirmation{font-size:1rem;color:var(--gold);font-style:italic;text-align:center;padding:.75rem 1rem;background:rgba(201,162,39,.04);border-radius:10px;border:.5px solid rgba(201,162,39,.2);margin:.55rem 0;line-height:1.65;letter-spacing:.03em;text-shadow:0 0 16px rgba(240,192,64,.25)}
.moon-bar{display:flex;gap:.2rem;margin:.45rem 0;align-items:center}
.moon-seg{flex:1;height:5px;border-radius:4px;background:#1a0830}
.moon-seg.active{background:var(--accent);box-shadow:0 0 8px var(--glow)}
.lunar-tip{font-size:.86rem;color:#c0b8e0;line-height:1.7;font-style:italic;padding:.55rem .75rem;background:rgba(255,255,255,.02);border-radius:9px;border-left:2px solid var(--accent);margin:.45rem 0}
.stone-row{display:flex;gap:.35rem;flex-wrap:wrap;margin:.35rem 0}
.stone-pill{padding:.25rem .7rem;border-radius:20px;font-size:.75rem;background:#06000e;color:#c0b0e0;border:.5px solid #2a1050}
.footer{text-align:center;padding:2rem 1rem 1rem;font-size:.65rem;color:rgba(201,162,39,.4);letter-spacing:.12em;text-transform:uppercase;line-height:2}

/* ── SHARE BUTTONS ── */
.share-btn{display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.65rem;border-radius:10px;font-family:Georgia,serif;font-size:.88rem;cursor:pointer;border:.5px solid;margin-bottom:.45rem;transition:all .18s;letter-spacing:.06em}

/* ── CALENDAR GRID ── */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:.2rem;margin:.5rem 0}
.cal-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:.7rem;color:#9080b8}
.cal-cell.has-moon{background:rgba(201,162,39,.08);color:var(--gold);font-size:.85rem}
.cal-cell.today{border:.5px solid var(--accent);color:var(--accent)}
.cal-cell.header{color:#5040a0;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;aspect-ratio:unset;padding:.15rem 0}
</style>
</head>
<body>

<!-- ════════════════════════════════════════════════════════
     SCREENSAVER FACE — Full-screen canvas opening screen
     Customer taps to enter the app
     ════════════════════════════════════════════════════════ -->
<div id="ss-layer" onclick="appUnlock()">
  <div id="ss-canvas-wrap"><canvas id="ss-canvas"></canvas></div>
  <div id="ss-bottom">
    <div id="ss-name">${nameClean}</div>
    <div id="ss-sign">${zodEmoji} ${zodSign} &nbsp;·&nbsp; ${prod.emoji} ${prodNameClean}</div>
    <div id="ss-moon"></div>
    <div id="ss-tip"></div>
    <div id="ss-tap">✦ &nbsp; tap to enter &nbsp; ✦</div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════
     MAIN APP — revealed after tap
     ════════════════════════════════════════════════════════ -->
<div id="app-layer">
  <div id="app-nav">
    <button class="nav-back" onclick="appBack()">☽</button>
    <button onclick="navTo('home')" class="active" id="nav-home">✦ Home</button>
    <button onclick="navTo('decide')" id="nav-decide">⚖ Decide</button>
    <button onclick="navTo('calendar')" id="nav-calendar">📅 Calendar</button>
    <button onclick="navTo('sign')" id="nav-sign">🌟 Sign</button>
    <button onclick="navTo('share')" id="nav-share">↑ Share</button>
  </div>

  <!-- HOME PAGE -->
  <div class="app-page active-page" id="page-home">
    <div class="hero">
      <div class="hero-sigil">${prod.emoji}</div>
      <div class="hero-name">${nameClean}</div>
      <div class="hero-sub">${zodEmoji} ${zodSign} &nbsp;·&nbsp; Life Path ${lp} &nbsp;·&nbsp; ${heroEmoji}</div>
      <div class="hero-product">${prodNameClean} &nbsp;·&nbsp; MAGICS</div>
      <div style="font-size:.65rem;color:rgba(201,162,39,.35);margin-top:.35rem;letter-spacing:.1em">${todayStr}</div>
    </div>

<!-- ── YOUR TALISMAN ───────────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Your Talisman</div>
  <div class="sec-title">${prod.emoji} ${prodNameClean}</div>
  <div class="sec-body" style="margin-bottom:.65rem">${prod.desc}</div>
  <div style="margin-bottom:.5rem"><span class="pill">${prod.element}</span><span class="pill">${prod.planet}</span></div>
  <div style="font-size:.68rem;color:#5040a0;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.3rem">Powers it carries</div>
  <div style="font-size:.85rem;color:#b0a8d8;margin-bottom:.65rem">${prod.power}</div>
  <div style="font-size:.68rem;color:#5040a0;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.3rem">Companion stones</div>
  <div class="stone-row">${prod.stone.split(' · ').map(s=>`<span class="stone-pill">${s}</span>`).join('')}</div>
  <div class="affirmation">"${prod.affirmation}"</div>
</div>

<!-- ── SUN SIGN ────────────────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Sun Sign</div>
  <div class="sec-title">${zodEmoji} ${zodSign}</div>
  <div class="grid2">
    <div class="mini-card"><div class="mini-label">Element</div><div class="mini-val">${zodEl}</div></div>
    <div class="mini-card"><div class="mini-label">Ruled by</div><div class="mini-val">${zodRuler}</div></div>
  </div>
  <div class="sec-body" style="margin-bottom:.65rem">${zodTrait}</div>
  <div style="background:rgba(180,80,80,.06);border:.5px solid rgba(180,80,80,.2);border-radius:9px;padding:.6rem .8rem">
    <div style="font-size:.6rem;color:#8050a0;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.25rem">Shadow work</div>
    <div style="font-size:.84rem;color:#b090b0;line-height:1.65;font-style:italic">${zodShadow}</div>
  </div>
</div>

<!-- ── LIFE PATH ──────────────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Numerology</div>
  <div class="sec-title">Life Path ${lp} — ${lpName}</div>
  <div style="font-size:.75rem;color:#6050a0;margin-bottom:.5rem">${String(year).split('').join(' + ')} + ${month} + ${day} → ${lp}</div>
  <div class="sec-body">${lpDesc}</div>
  <div style="margin-top:.6rem;padding:.55rem .7rem;background:#06000e;border-radius:9px;border:.5px solid #1a0830">
    <div style="font-size:.6rem;color:#5040a0;letter-spacing:.16em;text-transform:uppercase;margin-bottom:.2rem">Your number in the cosmos</div>
    <div style="font-size:.85rem;color:#b0a8d8">${lp===11?'Master Number — a doubled 2. Heightened sensitivity and spiritual antenna. The burden and the gift are inseparable.':lp===22?'Master Number — the greatest builder frequency. Visionary ambition grounded in extraordinary practical capacity.':lp===33?'Master Number — the rarest. A life of teaching through love lived completely.':'Single-digit essence. Pure, direct, undiluted.'}</div>
  </div>
</div>

<!-- ── MOON PHASE ─────────────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Current Moon</div>
  <div class="sec-title">🌙 ${moon.name}</div>
  <div class="moon-bar">${['New Moon','Waxing Crescent','First Quarter','Waxing Gibbous','Full Moon','Waning Gibbous','Last Quarter','Waning Crescent'].map((p,i)=>{
    const active=Math.floor(moon.cycle*8)===i;
    return `<div class="moon-seg${active?' active':''}" title="${p}"></div>`;
  }).join('')}</div>
  <div class="lunar-tip">${lunarGuide[moon.name]||''}</div>
  <div style="font-size:.78rem;color:#7060a0;margin-top:.5rem;font-style:italic">This is a live reading — the moon phase shown reflects today, ${todayStr}. Return on any day to read the current guidance.</div>
</div>

<!-- ── DECISION ENGINE CARD (tap to open) ─────────────────────── -->
<div class="section" style="border-color:rgba(201,162,39,.3);cursor:pointer" onclick="navTo('decide')">
  <div class="sec-label">✦ Decision Engine</div>
  <div class="sec-title" style="font-size:1.1rem">First-Principles Decision Engine</div>
  <div style="font-size:.84rem;color:#a090c0;margin-bottom:.75rem;line-height:1.6">Hold your ${prod.emoji}. Name one decision you are circling. Run it through 4 filters — the engine strips away everything false so only truth remains.</div>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.35rem;margin-bottom:.75rem">
    <div style="background:#06000e;border-radius:8px;padding:.5rem .4rem;text-align:center;border:.5px solid #2a1050"><div style="font-size:1rem;margin-bottom:.15rem;color:${accentColor}">1</div><div style="font-size:.6rem;color:#7060a0;line-height:1.3">Ideal vs<br>Current</div></div>
    <div style="background:#06000e;border-radius:8px;padding:.5rem .4rem;text-align:center;border:.5px solid #2a1050"><div style="font-size:1rem;margin-bottom:.15rem;color:#ef4444">2</div><div style="font-size:.6rem;color:#7060a0;line-height:1.3">Inversion<br>Hazards</div></div>
    <div style="background:#06000e;border-radius:8px;padding:.5rem .4rem;text-align:center;border:.5px solid #2a1050"><div style="font-size:1rem;margin-bottom:.15rem;color:#a855f7">3</div><div style="font-size:.6rem;color:#7060a0;line-height:1.3">Execution<br>No Fear</div></div>
    <div style="background:#06000e;border-radius:8px;padding:.5rem .4rem;text-align:center;border:.5px solid #2a1050"><div style="font-size:1rem;margin-bottom:.15rem;color:#22c55e">4</div><div style="font-size:.6rem;color:#7060a0;line-height:1.3">Objective<br>Reality</div></div>
  </div>
  <div style="text-align:center;font-size:.78rem;color:rgba(201,162,39,.6);letter-spacing:.16em">TAP TO OPEN DECISION ENGINE →</div>
</div>

<!-- ── TALISMAN ACTIVATION ────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Activate Your Talisman</div>
  <div class="sec-title">The First Rite</div>
  <div style="font-size:.88rem;color:#c0b8e0;line-height:1.75">
    <p style="margin-bottom:.65rem">Your ${prodNameClean} arrives already attuned to ${prod.planet}'s frequency — but it awakens fully through your specific energy. Perform this once, ideally on a ${moon.name==='Full Moon'||moon.name==='New Moon'?moon.name:'Full or New Moon'}.</p>
    <div style="counter-reset:rite">
      ${[
        `Hold the ${prod.emoji} in your dominant hand. Close your eyes. Breathe in through the nose for four counts, hold for four, release for four. Do this three times.`,
        `Say your full name aloud, slowly. Then say your birthdate aloud — ${month}/${day}/${year}. You are introducing yourself to the talisman.`,
        `State your intention aloud: what you are asking this talisman to protect, amplify, or draw toward you. Be specific. Vague intentions produce vague results.`,
        `Breathe onto the talisman three times. Your breath carries your life force — this is the oldest form of consecration in recorded history.`,
        `Place the ${prod.emoji} against your heart for one full minute. Feel it warm. The circuit is complete.`,
        `Wear it or place it on your altar. Return to it when you need grounding. It remembers.`
      ].map((s,i)=>`<div style="display:flex;gap:.65rem;margin-bottom:.55rem;align-items:flex-start">
        <div style="min-width:22px;height:22px;border-radius:50%;background:rgba(201,162,39,.12);border:.5px solid rgba(201,162,39,.3);display:flex;align-items:center;justify-content:center;font-size:.68rem;color:var(--gold);flex-shrink:0;margin-top:.1rem">${i+1}</div>
        <div style="font-size:.88rem;color:#c8c0e0;line-height:1.65">${s}</div>
      </div>`).join('')}
    </div>
  </div>
</div>

<!-- ── DAILY PRACTICE ─────────────────────────────────────────── -->
<div class="section">
  <div class="sec-label">✦ Daily Practice</div>
  <div class="sec-title">Tending the Field</div>
  <div style="font-size:.88rem;color:#c0b8e0;line-height:1.75">
    <p style="margin-bottom:.6rem">A talisman is not a passive object. It is a relationship. The more you tend it, the more it responds. Here is a minimal daily practice that takes three minutes.</p>
    <div class="grid2" style="margin-bottom:.6rem">
      <div class="mini-card"><div class="mini-label">Morning</div><div style="font-size:.82rem;color:#d8d0f0;margin-top:.2rem">Hold the ${prod.emoji}. State one intention for the day. Place it on your body.</div></div>
      <div class="mini-card"><div class="mini-label">Evening</div><div style="font-size:.82rem;color:#d8d0f0;margin-top:.2rem">Hold it again. Recall one moment from the day where you felt its element — ${prod.element}. Thank it.</div></div>
      <div class="mini-card"><div class="mini-label">Full Moon</div><div style="font-size:.82rem;color:#d8d0f0;margin-top:.2rem">Place outdoors or in moonlight for the night. It resets and amplifies.</div></div>
      <div class="mini-card"><div class="mini-label">When Stagnant</div><div style="font-size:.82rem;color:#d8d0f0;margin-top:.2rem">Bury it in soil for 24 hours. The earth clears and restores any talisman.</div></div>
    </div>
    <div class="affirmation">"${prod.affirmation}"</div>
  </div>
</div>

<div class="footer">
  <div>✦ &nbsp; ${nameClean} &nbsp;·&nbsp; ${prodNameClean} &nbsp; ✦</div>
  <div>${zodEmoji} ${zodSign} &nbsp;·&nbsp; Life Path ${lp} &nbsp;·&nbsp; ${moon.name}</div>
  <div id="heroDateBar" style="margin-top:.4rem;color:rgba(201,162,39,.6);font-size:.65rem;letter-spacing:.08em"></div>
  <div style="color:rgba(201,162,39,.2);margin-top:.2rem">So mote it be.</div>
</div>
  </div><!-- end page-home -->

  <!-- ═══════════════════════════════════════════════════════
       DECIDE PAGE
       ═══════════════════════════════════════════════════════ -->
  <div class="app-page" id="page-decide">
