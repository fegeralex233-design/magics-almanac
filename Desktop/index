  {id:'solomon72',cat:'Solomonic',glyph:'📖',name:'The 72 Names of God',origin:'Kabbalah · Zohar, 13th century CE',tradition:'Jewish mysticism, Hermetic Kabbalah',era:'1st–13th century CE',
   desc:'The Shemhamphorasch — the explicit name of God — is traditionally 72 three-letter names derived from Exodus 14:19–21 (three verses of 72 letters each, combined in a specific cipher). Each name corresponds to an angel, a 5-day period of the year, a specific protection, and a meditation. Medieval Kabbalists believed that Moses used these names to part the Red Sea. The Hermetic tradition adopted them into angel-summoning and amulet magic. The 72 names appear in Agrippa, in the Zohar, and in folk Judaism as printed protective amulets.',
   use:'Written on amulets (kamea) for protection, healing, and connection to specific angelic intelligences. Each name governs a specific domain — protection of children, healing of illness, defeating enemies, safe travel.',
   symbol:'✡'},

  // ── RUNIC ALPHABETS ─────────────────────────────────────────────────────
  {id:'elder_futhark',cat:'Runic',glyph:'ᚠ',name:'Elder Futhark',origin:'Germanic Europe · 150–800 CE',tradition:'Norse, Anglo-Saxon, Germanic',era:'2nd–8th century CE',
   desc:'The oldest runic alphabet — 24 symbols used by Germanic and Norse peoples from roughly 150 CE to 800 CE. Named for its first six letters: F-U-Th-A-R-K. Each rune is both a letter and a force of the world: Fehu (ᚠ) is cattle and portable wealth; Uruz (ᚢ) is the auroch, raw untamed strength; Thurisaz (ᚦ) is the thorn, chaos and Thor\'s hammer; Ansuz (ᚨ) is Odin, the divine breath and inspired speech; Raidho (ᚱ) is the wheel and righteous journey; Kenaz (ᚲ) is the torch and controlled creative fire. Odin is said to have hung upside-down on Yggdrasil for nine days to receive them.',
   use:'Carved into wood, bone, and stone for protection, healing, and communication. Runic inscriptions appear across Scandinavia, the British Isles, and as far east as Byzantium. Used in bind-rune amulets where multiple runes are overlaid into a single composite glyph.',
   symbol:'ᚠᚢᚦᚨᚱᚲ'},

  {id:'isa',cat:'Runic',glyph:'ᛁ',name:'Isa — The Ice Rune',origin:'Elder Futhark',tradition:'Norse',era:'2nd–8th century CE',
   desc:'The ninth rune. Isa means ice — stillness, stasis, concentrated focus, the frozen moment before action. In Norse cosmology ice was one of the two primordial forces (fire was the other) from which the world emerged. Isa appears in runic inscriptions as a binding force — to freeze conflict, to stop an enemy, to hold a situation in place while clarity arrives. It is also the rune of introspection, of winter, of the self contemplating itself in total silence.',
   use:'Used in magical workings to halt progression of disease, freeze an enemy\'s actions, or create a still center in chaotic circumstances. Also used in meditation for concentration and inner stillness.',
   symbol:'ᛁ'},

  {id:'algiz',cat:'Runic',glyph:'ᛉ',name:'Algiz — The Elk Rune',origin:'Elder Futhark',tradition:'Norse, Anglo-Saxon',era:'2nd–8th century CE',
   desc:'The fifteenth rune, shaped like an outstretched hand or antlers reaching upward. Algiz represents divine protection, the shielding of the gods, the warding of sacred space. It corresponds to the elk\'s ability to defend itself without aggression. In Anglo-Saxon tradition it was called Eolh. Warriors carved it into sword hilts. It appears in Anglo-Saxon texts as a charm against evil. The reversed Algiz (ᛦ) appears in memorial stones as a death rune.',
   use:'One of the most frequently used protective runes. Inscribed on doorways, weapons, and bodies for divine shielding. Combined with Tiwaz for warrior protection.',
   symbol:'ᛉ'},

  {id:'runes_bind',cat:'Runic',glyph:'⊛',name:'Bind Runes',origin:'Germanic / Norse · 300 CE onward',tradition:'Norse, Anglo-Saxon',era:'4th–11th century CE',
   desc:'A bind rune (bindrune) is a composite of two or more runes overlaid into a single glyph — their powers combined and intensified by the merger. They appear on Viking Age artifacts including the Kragehul lance shaft (5th century CE) and many runestones. A bind rune is not simply the sum of its parts: the overlapping forms create new resonances. The most famous modern bind rune is the Lebensrune/Todesrune combination used by the SS — a reminder that runic knowledge has been weaponized politically and requires responsible context.',
   use:'Created by the runemaster for a specific purpose — healing, love, protection, travel. Each is unique. The making of a bind rune requires understanding of how the runes interact geometrically and symbolically.',
   symbol:'⊛'},

  // ── ALCHEMICAL SYMBOLS ────────────────────────────────────────────────────
  {id:'philosophers_stone',cat:'Alchemical',glyph:'🜍',name:'Philosopher\'s Stone',origin:'Hermetic Europe · 3rd–17th century CE',tradition:'Western alchemy, Hermetic',era:'3rd–17th century CE',
   desc:'The most sought object in Western esotericism — the agent of transmutation. Represented in alchemical manuscripts as a red stone, a red tincture, a red king, a pelican, a phoenix, or a double eagle. Not a literal rock but a perfected substance capable of converting base metals to gold and, by extension, the mortal soul to its immortal state. The symbol — a circle with a dot at center within a triangle within a square — encodes the cosmology: the spiritual (circle) animating matter (square) through elemental transformation (triangle).',
   use:'The lapis philosophorum was the declared goal of centuries of European laboratory-alchemical work. Modern Jungian psychology reads the Stone as the integrated Self — the psyche in its perfected, individuated state.',
   symbol:'🜍'},

  {id:'ouroboros',cat:'Alchemical',glyph:'🐍',name:'Ouroboros — The World Serpent',origin:'Egypt · ~1600 BCE',tradition:'Egyptian, Greek, Norse, Hermetic, Gnostic',era:'1600 BCE to present',
   desc:'A serpent eating its own tail — the first recorded image appears in the Enigmatic Book of the Netherworld found in Tutankhamun\'s tomb (c. 1323 BCE). It represents the eternal cycle: creation consuming itself to be reborn. The Stoics used it as a symbol of the cosmos as a self-sustaining whole. Gnostic texts used it to represent the lower god, the Demiurge, who creates the world by binding matter into cycles. Norse mythology calls it Jörmungandr — the Midgard Serpent encircling the world, releasing it only at Ragnarök. Kekulé claimed to have discovered the ring structure of benzene in a dream of the ouroboros (1865).',
   use:'The universal symbol of cyclical time, self-sufficiency, and the unity of opposites (beginning/end, life/death, matter/spirit). Central to Hermetic cosmology.',
   symbol:'🐍'},

  {id:'sulfur_merc',cat:'Alchemical',glyph:'🜋',name:'Sulfur, Mercury & Salt',origin:'Paracelsian alchemy · 16th century CE',tradition:'Paracelsian, Hermetic',era:'16th century CE',
   desc:'Paracelsus (1493–1541) replaced the Greek four-element model with a three-principle model. Sulfur (🜍) is the principle of combustibility, will, and the soul. Mercury (☿) is the principle of fluidity, mind, and the spirit. Salt (🜔) is the principle of fixity, body, and material form. Everything in creation is some proportion of these three. The triangle pointing up is fire/sulfur; pointing down is water/mercury; with a horizontal line through it, it is earth/salt. Paracelsus applied this system to medicine, claiming every disease was an imbalance of the three principles in a specific organ.',
   use:'The three-principle system underlies much of Renaissance magical medicine and is still used as a framework in alchemical and Hermetic practice. The symbols appear in lab notebooks, grimoires, and medical texts.',
   symbol:'🜋'},

  // ── SERVITORS & ENTITIES ──────────────────────────────────────────────────
  {id:'servitor',cat:'Servitors',glyph:'⟁',name:'The Servitor — Constructed Being',origin:'Chaos magic tradition · 1980s CE',tradition:'Chaos magic, Austin Osman Spare',era:'20th century CE',
   desc:'A servitor is a purposefully created magical entity — not summoned from a tradition but constructed from will, symbol, and intent. The concept developed in Austin Osman Spare\'s sigil magic (1913) and was systematized by chaos magicians Peter Carroll and Phil Hine in the 1980s. A servitor is built like software: given a name, a form (visual or symbolic), a function, and a lifespan. Unlike a goetic demon, it has no prior existence — it is created entirely by the practitioner. It operates autonomously within its defined parameters. Carroll called these "artificial elementals." Ray Sherwin coined the term "servitor."',
   use:'Created for specific repeating tasks: protecting a home, bringing a practitioner\'s attention to relevant information, anchoring a desired psychological state. Given a trigger to activate and an expiry condition. Must be formally discharged at the end of its work or it may continue operating.',
   symbol:'⟁'},

  {id:'egregore',cat:'Servitors',glyph:'◈',name:'Egregore — Collective Thoughtform',origin:'Hermetic Brotherhood · 1895',tradition:'Hermetic, Kabbalistic, group magic',era:'19th century CE',
   desc:'An egregore is a collective entity generated by a group of people sharing a sustained belief, ritual, or intention. First defined in its modern occult sense by Hermetic Brotherhood of Luxor writings in the 1890s, though the concept appears in earlier Kabbalistic texts (galgal = whirling entity generated by sustained prayer). Every nation, corporation, religion, and sports team generates an egregore — an autonomous entity that takes on its own momentum and begins to influence the group that created it. The more energy poured into it, the more autonomous it becomes. A living tradition\'s egregore is one of the most powerful entities in the world.',
   use:'Large magical orders work consciously with their egregore — feeding it through ritual, drawing on it in workings. Individual practitioners can tap into a tradition\'s egregore by performing its rituals correctly, even alone. Egregores can outlive their creators by centuries.',
   symbol:'◈'},

  {id:'fetch',cat:'Servitors',glyph:'🐺',name:'The Fetch — Spirit Double',origin:'Norse and British folk magic · 500–1800 CE',tradition:'Norse, Scottish, Irish, Scandinavian',era:'5th–19th century CE',
   desc:'The fetch (Norse: fylgja, "follower") is a spiritual double — a being that accompanies a person through life, bearing their fate and taking an animal or human form. In Norse tradition, seeing your own fetch was an omen of death. In Scottish folklore the fetch was a double that appeared at the moment of death, sometimes seen by witnesses at a distance while the person was still alive. In Irish tradition the fetch preceded a death by appearing in the form of the dying person. The fetch is related to the concept of the doppelgänger, the animal familiar, and the Roman genius (personal divine companion).',
   use:'In traditional practice, the fetch was not summoned but acknowledged — a relationship cultivated with one\'s own spiritual companion. Norse practitioners of seiðr would communicate with their fylgja for guidance and protection.',
   symbol:'🐺'},

  {id:'genius',cat:'Servitors',glyph:'🏛',name:'The Genius — Roman Personal Spirit',origin:'Rome · ~500 BCE',tradition:'Roman religion, Hermetic',era:'Roman Republic to Late Antiquity',
   desc:'Every Roman male possessed a genius — a divine companion spirit representing his vitality, generative force, and continuity through time. The paterfamilias\'s genius was honored by the entire household at the Lares shrine. Emperors declared their genius divine (worship of the emperor was technically worship of his genius, not himself). Women had a juno. The genius was distinct from the soul: it was the divine spark of creative and generative power, something between a guardian angel and an animating force. On birthdays, Romans poured wine for their genius. On death, the genius returned to the gods.',
   use:'The genius cult underlies the Roman concept of the muse (muse = the genius in artistic mode). In Hermetic tradition it connects to the Holy Guardian Angel, the Higher Self, and the magician\'s personal divine. The relationship was one of mutual honor, not servitude.',
   symbol:'🏛'},

  {id:'golem',cat:'Servitors',glyph:'🪆',name:'The Golem — Clay Servitor',origin:'Jewish Kabbalah · 11th–16th century CE',tradition:'Jewish mysticism, Kabbalistic magic',era:'11th–17th century CE',
   desc:'A golem is an animated being created from inanimate matter, most often clay or mud, through the correct application of divine names. The most complete golem creation ritual comes from Sefer Yetzirah (Book of Formation) and involves walking around the clay form while reciting permutations of the Hebrew alphabet combined with God\'s name. The truth (emet, אמת) written on the forehead activates it; erasing the aleph to leave met (מת, "dead") deactivates it. The most famous golem was made by Rabbi Loew of Prague (1580) to protect the Jewish quarter from antisemitic attacks. The golem served until the Sabbath — on which no work was permitted — when it had to be deactivated.',
   use:'The golem is the Jewish parallel to the servitor: a constructed being created for protective labor that must be carefully controlled. Its inability to rest on the Sabbath led to disaster in most versions of the legend — a warning about entities that exceed their intended parameters.',
   symbol:'🪆'},

  {id:'tulpa',cat:'Servitors',glyph:'👤',name:'Tulpa — Tibetan Thoughtform',origin:'Tibetan Buddhist practice · pre-9th century CE',tradition:'Tibetan Buddhism (Vajrayana), Western occultism',era:'Pre-9th century CE; Western adaptation 1920s',
   desc:'A tulpa is an entity created through sustained and deliberate visualization in Tibetan Buddhist practice — originally as a meditative exercise, a way of training the mind to shape reality. Alexandra David-Néel\'s account of creating a monk tulpa that eventually took on autonomous behavior and had to be forcibly dissolved (Magic and Mystery in Tibet, 1929) introduced the concept to the West. In Buddhist context, tulpa-creation demonstrates the illusory nature of all apparent beings — if you can make one, nothing was more real than yours in the first place. In chaos magic it was reinterpreted as a sophisticated form of servitor.',
   use:'In Tibetan practice: an advanced meditator\'s training exercise, demonstrating mind\'s creative power. In Western occultism: a long-form servitor created through intensive visualization over weeks or months, capable of complex autonomous behavior. Both traditions emphasize the importance of dissolution — a tulpa that runs free is considered dangerous.',
   symbol:'👤'},

  // ── GNOSTIC & HERMETIC ───────────────────────────────────────────────────
  {id:'baphomet',cat:'Hermetic',glyph:'⛧',name:'Baphomet',origin:'Knights Templar accusations · 1307 CE; Lévi\'s image 1855',tradition:'Gnostic, Hermetic, modern Satanism',era:'1307 CE onward',
   desc:'The name Baphomet first appears in confessions extracted under torture from Knights Templar in 1307 — almost certainly fabricated under duress, as the same prisoners produced contradictory accounts of its form. Eliphas Lévi gave it its canonical image in 1855: a winged, androgynous goat-headed figure with a torch at the skull, an inverted pentagram on the forehead, and a caduceus for a phallus. Lévi explicitly stated it was a symbol of the reconciliation of opposites — male/female, animal/divine, matter/spirit — not an object of worship. Anton LaVey adopted the Lévi image for the Church of Satan in 1966, where it remains the official symbol.',
   use:'As a symbol of the conjunction of opposites in Hermetic/Gnostic work. In modern Satanism, as a symbol of individual sovereignty and opposition to arbitrary authority. The name\'s etymology is disputed: one theory links it to "Baphe Metis" (baptism of wisdom) in Templar Gnosticism.',
   symbol:'⛧'},

  {id:'hermetic_cross',cat:'Hermetic',glyph:'⊕',name:'The Rose Cross',origin:'Rosicrucianism · 17th century CE',tradition:'Rosicrucian, Hermetic, Golden Dawn',era:'1614 CE onward',
   desc:'The founding documents of Rosicrucianism — the Fama Fraternitatis (1614) and Confessio (615) — describe a secret fraternity of adepts operating behind history, founded by Christian Rosenkreuz (1378–1484) after receiving esoteric wisdom in Arabia. The Rose Cross combines the cross of matter with the rose of spirit: the divine unfolding at the intersection of the vertical (heaven) and horizontal (earth) axes. The Hermetic Order of the Golden Dawn (founded 1888) used the rose cross as its central initiation symbol. Whether the Rosicrucians existed is debated; the documents unquestionably shaped Western esotericism for 400 years.',
   use:'The central symbol of the Rosicrucian and Golden Dawn traditions. Used in initiation ceremonies, amulets, and as a meditation object on the integration of spirit and matter. The specific colors and arrangement of roses carry grade-level meanings within these orders.',
   symbol:'🌹'},

  {id:'caduceus',cat:'Hermetic',glyph:'☤',name:'Caduceus — Staff of Hermes',origin:'Greece · ~600 BCE',tradition:'Greek, Roman, Hermetic, medical',era:'6th century BCE to present',
   desc:'Two serpents twisting around a winged staff — the symbol of Hermes (Mercury), messenger of the gods. The two serpents represent opposing forces in harmony: life and death, solar and lunar, manifest and hidden. In Hermetic philosophy the caduceus encodes the entire worldview: the staff is the central axis of the universe; the serpents are the solar (right) and lunar (left) currents spiraling upward. The wings are divine authority and the capacity for transcendence. Medieval alchemists used the caduceus to represent mercury (quicksilver) and the mediating principle between opposites. It is often confused with the Rod of Asclepius (one snake, no wings) — the actual medical symbol.',
   use:'In Hermetic practice: a symbol of mediation, communication between realms, the resolution of apparent opposites. In alchemical work: the mercury principle. In practice: frequently invoked at the opening of any communication between different planes of existence.',
   symbol:'☤'},
];

const GRIMOIRE_CATS=['All','Protective','Planetary Seals','Solomonic','Runic','Alchemical','Servitors','Hermetic'];

let _grimCat='All';
let _grimSearch='';

function renderGrimoire(){
  var el=document.getElementById('content');
  el.innerHTML='<div style="background:linear-gradient(160deg,#06010f,#0e0228);border:.5px solid rgba(201,162,39,.3);border-radius:14px;padding:1rem;margin-bottom:.8rem">'
    +'<div style="font-family:Georgia,serif;font-size:1.35rem;color:var(--gold);text-align:center;margin-bottom:.5rem">&#x1F4DC; Symbols &amp; Seals</div>'
    +'<div style="font-size:.82rem;color:#b0a0d0;text-align:center;line-height:1.5;margin-bottom:.85rem">Historical magical symbols, seals, planetary sigils, and sacred scripts from traditions worldwide.</div>'
    +'<div class="sbar" style="margin-bottom:.65rem"><span style="color:#6050a0;font-size:1rem">&#x1F50D;</span><input id="grimoireSearch" type="text" placeholder="Search symbols, traditions, origins…" oninput="grimoireFilter()" style="font-size:.95rem"></div>'
    +'<div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-bottom:.85rem" id="gcatBtns"></div>'
    +'<div id="grimoireList"></div>'
    +'</div>';
  var btns=document.getElementById('gcatBtns');
  GRIMOIRE_CATS.forEach(function(c){
    var b=document.createElement('button');
    b.textContent=c;
    b.id='gcat_'+c.replace(/\s/g,'_');
    b.style.cssText='padding:.3rem .7rem;font-size:.75rem;border-radius:14px;cursor:pointer;font-family:inherit;border:.5px solid #3a1a5e;background:#06010e;color:#9080b8';
    b.onclick=function(){grimoireSetCat(c,b);};
    btns.appendChild(b);
  });
  grimoireRender();
}

function switchGrimTab(tab){
  window._grimTab=tab;
  grimTabActivate(tab);
}

function grimTabActivate(tab){
  ['symbols','discover','map','superstitions','objects'].forEach(function(t){
    var panel=document.getElementById('grimTab_'+t);
    var btn=document.getElementById('gtab_'+t);
    if(panel) panel.style.display=(t===tab)?'block':'none';
    if(btn){
      if(t===tab){
        btn.style.borderColor='rgba(201,162,39,.7)';
        btn.style.background='rgba(201,162,39,.12)';
        btn.style.color='rgba(201,162,39,.9)';
      } else {
        btn.style.borderColor='#3a1a5e';
        btn.style.background='#06010e';
        btn.style.color='#9080b8';
      }
    }
  });
  if(tab==='symbols') grimoireRender();
  if(tab==='map'){
    var mg=document.getElementById('mapGrid');
    if(mg&&!mg.dataset.built){
      mg.dataset.built='1';
      mg.innerHTML=locations.map(function(l,i){return '<div class="map-pin" id="pin'+i+'" onclick="togglePin('+i+')"><div style="display:flex;align-items:center;gap:.3rem"><span style="color:var(--blood)">⊕</span><div class="pin-name">'+l.name+'</div></div><div class="pin-count">'+l.count+' executions</div></div>';}).join('');
    }
  }
  if(tab==='superstitions'){
    var sl=document.getElementById('grimSupList');
    if(sl&&!sl.dataset.built){
      sl.dataset.built='1';
      var supItems=[
        {icon:'🐱',title:'The Black Cat',region:'Global',tag:'Omen',body:'In most of Western Europe and North America, a black cat crossing your path brings bad luck. But in <strong>Britain and Ireland</strong>, a black cat walking toward you is good luck — entirely the opposite belief, held simultaneously across the same island chain.'},
        {icon:'🔢',title:'The Number 13',region:'Western world',tag:'Triskaidekaphobia',body:'The fear of 13 — <strong>triskaidekaphobia</strong> — has multiple overlapping origins. In Norse mythology, Loki was the uninvited 13th guest at a feast. In Christian tradition, 13 sat at the Last Supper. Fear so persistent that most high-rise buildings skip the 13th floor entirely.'},
        {icon:'🪞',title:'Breaking a Mirror',region:'Rome, Greece, worldwide',tag:'7 Years Bad Luck',body:'The Romans believed mirrors held a fragment of the soul — and that the soul renewed itself every <strong>7 years</strong>. A broken mirror trapped and shattered the soul. The practical cure: bury the pieces under a full moon, touch them to a tombstone, or throw them into a south-running stream.'},
        {icon:'🧂',title:'Spilling Salt',region:'Europe, Middle East',tag:'Ward off the Devil',body:'Salt was so valuable that Roman soldiers were paid in it (<em>salarium</em> — the root of "salary"). In Leonardo da Vinci&#39;s <em>Last Supper</em>, Judas Iscariot has spilled the salt. Throwing salt over the left shoulder sends it into the Devil&#39;s eyes.'},
        {icon:'🪵',title:'Knock on Wood',region:'Celtic, Germanic, worldwide',tag:'Protection',body:'The Celtic peoples believed trees were inhabited by spirits. Touching a tree summoned its protective spirit and grounded any boastful statement. In Germany it became <em>auf Holz klopfen</em>; in Italy <em>tocca ferro</em> — touch iron instead.'},
        {icon:'☘️',title:'Irish Folk Omens',region:'Ireland',tag:'The Full Tradition',body:'<strong>Magpies:</strong> "One for sorrow, two for joy, three for a girl, four for a boy…" Always greet a lone magpie. <strong>Bees</strong> must be told of deaths in the family or they will leave the hive. <strong>Whistling</strong> indoors invites the devil.'},
        {icon:'🪄',title:'Lucky Charms Worldwide',region:'Global',tag:'Folk Magic',body:'<strong>Hamsa</strong> — the open palm with an eye, 10,000 years old, found across North Africa and the Middle East. <strong>Horseshoe</strong> — hung opening upward to hold the luck; iron repels faeries. <strong>Rabbit&#39;s foot</strong> — specifically the left hind foot, killed at a crossroads under a full moon. <strong>Four-leaf clover</strong> — odds of finding one: 1 in 10,000.'}
      ];
      sl.innerHTML=supItems.map(function(s){return '<div class="card"><div class="ch"><span style="font-size:1.2rem">'+s.icon+'</span><div><div class="ch-title">'+s.title+'</div><div class="ch-meta">'+s.region+'</div></div><span class="tag">'+s.tag+'</span></div><div class="cb">'+s.body+'</div></div>';}).join('');
    }
  }
  if(tab==='objects'){
    var oc=document.getElementById('grimObjContent');
    if(oc&&!oc.dataset.built){
      oc.dataset.built='1';
      var artHtml='<div style="font-size:.88rem;color:#c8b8e8;margin-bottom:.8rem;line-height:1.6">Physical objects, manuscripts, and monuments where magic was inscribed, stored, or enacted — and that have survived the centuries.</div>';
      artHtml+='<div class="card">';
      artHtml+=artifacts.map(function(a){return '<div class="art-item"><div class="art-thumb">'+a.icon+'</div><div><div class="art-name">'+a.n+'</div><div class="art-loc">📍 '+a.loc+'</div><div class="art-desc">'+a.d+'</div></div></div>';}).join('');
      artHtml+='</div>';
      artHtml+='<div style="font-family:Georgia,serif;font-size:1.1rem;color:var(--gold);letter-spacing:.08em;margin:.8rem 0 .5rem;text-shadow:0 0 20px rgba(201,162,39,.4)">📜 Actual Texts — Public Domain Translations</div>';
      artHtml+='<div style="font-size:.84rem;color:#c8b8e8;margin-bottom:.7rem;line-height:1.6">Real excerpts from grimoires now in the public domain. Tap any title to open.</div>';
      artHtml+=grimtexts.map(function(g,gi){
        var s='<div style="background:#0e0225;border:1px solid #4a2080;border-radius:12px;margin-bottom:.7rem;overflow:hidden">';
        s+='<div style="padding:.75rem 1rem .6rem;border-bottom:.5px solid #2a1050;display:flex;align-items:flex-start;gap:.55rem;cursor:pointer" onclick="toggleGrim('+gi+')"><span style="font-size:1rem">'+g.icon+'</span>';
        s+='<div style="flex:1"><div style="font-family:Georgia,serif;font-size:1rem;color:#fff;font-weight:600">'+g.title+'</div><div style="font-size:.75rem;color:#9080b0;margin-top:.1rem">'+g.source+' · '+g.date+'</div></div>';
        s+='<span id="grimArrow'+gi+'" style="font-size:.9rem;color:var(--gold);flex-shrink:0">▼</span></div>';
        s+='<div id="grimBody'+gi+'" style="display:none">';
        s+='<div style="padding:.65rem 1rem;font-size:.84rem;color:#e8e0f8;line-height:1.6;border-bottom:.5px solid #1a0830"><strong style="color:var(--gold)">About:</strong> '+g.about+'</div>';
        s+=g.sections.map(function(sec){
          var r='<div style="padding:.65rem 1rem;border-bottom:.5px solid #0e0820">';
          r+='<div style="font-size:.72rem;color:#7a3aae;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.3rem">'+sec.label+'</div>';
          r+='<div style="font-family:Georgia,serif;font-size:.92rem;color:#f0e8ff;line-height:1.8;background:#04000a;border-left:2px solid var(--gold);border-radius:0 8px 8px 0;padding:.65rem .8rem;font-style:italic">'+sec.text+'</div>';
          if(sec.note) r+='<div style="font-size:.78rem;color:#9080b0;margin-top:.25rem;line-height:1.5">'+sec.note+'</div>';
          r+='</div>';
          return r;
        }).join('');
        s+='<div style="padding:.5rem 1rem;display:flex;justify-content:flex-end"><a href="'+g.link+'" target="_blank" rel="noopener" style="font-size:.79rem;color:var(--gold);text-decoration:none;border:.5px solid var(--gold);padding:.2rem .6rem;border-radius:20px">Read full text ↗</a></div>';
        s+='</div></div>';
        return s;
      }).join('');
      oc.innerHTML=artHtml;
    }
  }
}


function grimoireSetCat(cat,btn){
  _grimCat=cat;
  document.querySelectorAll('[id^="gcat_"]').forEach(b=>{
    b.style.borderColor='#3a1a5e';b.style.background='#06010e';b.style.color='#9080b8';
  });
  if(btn){btn.style.borderColor='rgba(201,162,39,.7)';btn.style.background='rgba(201,162,39,.12)';btn.style.color='rgba(201,162,39,.9)';}
  grimoireRender();
}

function grimoireFilter(){
  _grimSearch=(document.getElementById('grimoireSearch')||{}).value||'';
