function buildGalaxy(){
  var container=document.getElementById('galaxyPlanets');
  var canvas=document.getElementById('galaxyCanvas');
  var nav=document.getElementById('galaxyNav');
  if(!container||!canvas||!nav)return;

  // Size the galaxy
  var W=nav.offsetWidth||window.innerWidth;
  var H=Math.min(Math.max(W*0.72,260),480);
  nav.style.height=H+'px';
  canvas.width=W*2; canvas.height=H*2;
  canvas.style.width=W+'px'; canvas.style.height=H+'px';

  // Draw starfield on canvas
  var ctx=canvas.getContext('2d');
