// ── SHARED VOICE ENGINE ──────────────────────────────────────────────────────
// magicSpeak: mysterious, slower, slightly lower — used for oracle/seance/well/hat
function magicSpeak(text,rate,pitch){
  if(!window.speechSynthesis)return;
  window.speechSynthesis.cancel();
  var u=new SpeechSynthesisUtterance(text);
  u.rate=rate||0.8;
  u.pitch=pitch||0.9;
  u.volume=1;
  var voices=window.speechSynthesis.getVoices();
  var pick=null;
  // Prefer deep/theatrical voices
  var preferred=['Daniel','Alex','Fred','Arthur','Moira','Fiona','Victoria','Tessa'];
  for(var pi=0;pi<preferred.length&&!pick;pi++){
    for(var vi=0;vi<voices.length;vi++){if(voices[vi].name.indexOf(preferred[pi])!==-1){pick=voices[vi];break;}}
  }
  if(pick)u.voice=pick;
  window.speechSynthesis.speak(u);
}
// magicStop: stop any current speech
function magicStop(){if(window.speechSynthesis)window.speechSynthesis.cancel();}

function elfSay(text,rate,pitch){
  if(!window.speechSynthesis)return;
  window.speechSynthesis.cancel();
  var u=new SpeechSynthesisUtterance(text);
  u.rate=rate||0.88;
  u.pitch=pitch||1.3;
  u.volume=1;
  // Try to pick a child-friendly or female voice
  var voices=window.speechSynthesis.getVoices();
  var pick=null;
  for(var i=0;i<voices.length;i++){
    var n=voices[i].name.toLowerCase();
    if(n.indexOf('samantha')!==-1||n.indexOf('karen')!==-1||n.indexOf('moira')!==-1||n.indexOf('tessa')!==-1||n.indexOf('fiona')!==-1||n.indexOf('victoria')!==-1){pick=voices[i];break;}
  }
  if(!pick){for(var i=0;i<voices.length;i++){if(voices[i].name.indexOf('Female')!==-1||voices[i].name.indexOf('female')!==-1){pick=voices[i];break;}}}
  if(pick)u.voice=pick;
  window.speechSynthesis.speak(u);
}

