.toast-section, [style*="background:#0"] {
  position: relative;
}

/* Body text: pure white, always */
.cb, .cb p, .tl-txt, .art-desc, .pin-detail,
.result-box, .result-box p,
.ritual-result-body, .ritual-result-body p,
.potion-lore, .garnish-lore,
.reading-text, .reading-text p,
.herb-body, .recipe-body,
.oracle-blessing-text,
.toast-text, .toast-translation,
.sound-desc, .home-quote {
  color: #ffffff !important;
