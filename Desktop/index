            <textarea id="de_ideal" placeholder="The ideal outcome in full..." style="width:100%;height:80px;background:#0a0120;border:.5px solid #2a1050;border-radius:7px;color:#d8d0f0;font-family:Georgia,serif;font-size:.8rem;padding:.5rem .6rem;resize:vertical;box-sizing:border-box;outline:none" oninput="deCheckReady()"></textarea>
          </div>
        </div>
      </div>
      <div style="background:#06000e;border-radius:10px;border:.5px solid #2a1050;padding:.8rem .9rem;margin-bottom:.65rem">
