function togglePin(idx) {
  var pin = document.getElementById('pin'+idx);
  if(!pin) return;
  var info = pin.querySelector('.pin-info');
  if(!info){
    var expanded = pin.getAttribute('data-expanded');
    if(expanded === 'true'){
      pin.setAttribute('data-expanded','false');
      pin.style.background = '';
    } else {
      pin.setAttribute('data-expanded','true');
      pin.style.background = 'rgba(80,20,20,.2)';
    }
  } else {
    info.style.display = info.style.display === 'none' ? 'block' : 'none';
  }
}

