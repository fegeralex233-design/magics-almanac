// Returns moon sign index 0-11 based on date
function getMoonSignForDate(dateStr){
  // Moon moves ~13.2 degrees/day, completes zodiac in ~27.3 days
  // Reference: Moon was in Aries (0) on Jan 1, 2000 at roughly day 0
  var refDate=new Date('2000-01-01');
  var d=new Date(dateStr);
  var daysDiff=Math.floor((d-refDate)/(1000*60*60*24));
  // Moon cycle ~27.3217 days through 12 signs = ~2.277 days per sign
  var moonPos=((daysDiff%27.3217)+27.3217)%27.3217;
  var signIdx=Math.floor(moonPos/2.277)%12;
  return signIdx;
}

// Rising sign — approximated by birth time (2 hours per sign, starting from Aries at 6am local)
function getRisingSign(timeStr,lat){
  var parts=timeStr.split(':');
  var hour=parseInt(parts[0])||6;
  var min=parseInt(parts[1])||0;
  var decHour=hour+min/60;
  // Simplified: Aries rises at ~6am, each sign takes ~2 hours
  var signIdx=Math.floor(((decHour-6+24)%24)/2)%12;
  return signIdx;
}

