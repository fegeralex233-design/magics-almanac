function getWN(){const inp=document.querySelectorAll('#nameInputs input');const n=[];inp.forEach(i=>{if(i.value.trim())n.push(i.value.trim());});return n.length>=2?n:wheelNames;}
function drawWheel(){
  const canvas=document.getElementById('wheelCanvas');if(!canvas)return;
  const ctx=canvas.getContext('2d');const names=getWN();const n=names.length;
  if(!canvas._dprSet){
    const dpr=Math.min(window.devicePixelRatio||1,2);
    canvas.width=280*dpr;canvas.height=280*dpr;
    canvas.style.width='280px';canvas.style.height='280px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
    canvas._dprSet=true;
  }
  const cx=140,cy=140,r=130;const slice=(Math.PI*2)/n;
  ctx.clearRect(0,0,280,280);
  for(let i=0;i<n;i++){
    const sa=wheelAngle+i*slice,ea=sa+slice;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,sa,ea);ctx.closePath();
    ctx.fillStyle=WCOLS[i%WCOLS.length];ctx.fill();
    ctx.strokeStyle='rgba(201,162,39,.3)';ctx.lineWidth=1.5;ctx.stroke();
