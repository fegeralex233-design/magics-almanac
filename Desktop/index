}

// ── MAGIC NUMBER (kids) ──────────────────────────────────────────────────────
function kidsMagicNumber(){
  var now=new Date();
  var seed=(now.getFullYear()*10000+(now.getMonth()+1)*100+now.getDate())>>>0;
  var rnd=function(max){seed=(Math.imul(seed,1664525)+1013904223)>>>0;return(seed>>>0)%max;};
  var num=rnd(9)+1;
  var meanings=['A day of beginnings — number 1 means you go FIRST today!','The number of pairs — look for two of everything today!','Magic triangle — three wishes are extra powerful today!','Four seasons, four directions — you are perfectly balanced today!','The magic hand — five fingers, five lucky things coming your way!','The number of the honeybee — busy, sweet, and buzzing with energy today!','Lucky 7 — the luckiest number of all! Something wonderful is coming!','Number 8 looks like a snowman — a magical, cozy, friendly day!','Three groups of three — look for patterns and hidden magic today!'];
  var colors=['#ff6b6b','#ffd93d','#6bcb77','#4d96ff','#c77dff','#ff9f43','#ffd700','#74b9ff','#fd79a8'];
  var color=colors[num-1];
  kidsSetActivity('<div style="background:rgba(0,20,60,.5);border:1px solid rgba(100,160,255,.25);border-radius:12px;padding:.85rem;text-align:center">'
    +'<div style="font-family:Georgia,serif;font-size:.85rem;color:#5a8ab0;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.5rem">Your Magic Number Today</div>'
    +'<div style="font-size:5rem;font-family:Georgia,serif;color:'+color+';text-shadow:0 0 30px '+color+'80;line-height:1;margin-bottom:.4rem">'+num+'</div>'
    +'<div style="font-size:.92rem;color:#c8e8ff;line-height:1.6;font-style:italic;max-width:280px;margin:0 auto .5rem">'+meanings[num-1]+'</div>'
    +'<div style="font-size:.75rem;color:rgba(100,160,255,.4)">✦ '+(now.toLocaleDateString('en-US',{month:'long',day:'numeric'}))+' ✦</div>'
    +'</div>');
}


