      if(badge){badge.textContent='Stage 1 — Swimming';badge.style.color='#6dc8f0';badge.style.animation='';}
      if(msg)msg.textContent='She splashed back in! Spot her again!';
      nessieScheduleNext();
    },900);
  },1200);
}

function nessieEnd(){
  nessieRunning=false;
  clearTimeout(nessieTimer);
  clearTimeout(nessieHideTimer);
  var g=function(id){return document.getElementById(id);};
  var spot=g('nessie-spot');
  if(spot)spot.style.display='none';
  var prompt=g('nessie-spell-prompt');
  if(prompt)prompt.style.display='none';
  var btn=g('nessie-btn');
  var msg=g('nessie-msg');
  var badge=g('nessie-stage-badge');
  if(badge){badge.textContent='Done!';badge.style.color='#7DF9A0';badge.style.animation='';}
  if(btn){btn.disabled=false;btn.textContent='Play Again';}
  var rank,praise;
  if(nessieScore===0){rank='🌊';praise='Nessie giggled all the way home. Try the spell next time!';}
  else if(nessieScore<4){rank='🌿';praise='You spotted her! She barely escaped with her wings!';}
  else if(nessieScore<8){rank='⭐⭐';praise='Great work! Nessie had to fly extra fast to escape you!';}
  else if(nessieScore<13){rank='🌟🌟🌟';praise='Amazing wizard! You cast the spell perfectly!';}
  else{rank='🐉✨🐉';praise='LEGENDARY! Nessie has never been chased back to sea so many times!';}
  if(msg)msg.innerHTML=
    '<div style="font-family:Georgia,serif;font-size:.98rem;color:#7DF9A0;margin-bottom:.25rem">'+rank+' You caught Nessie '+nessieScore+' times! '+rank+'</div>'
    +'<div style="font-size:.75rem;color:#5a8ab0;font-style:italic">'+praise+'</div>';
}


