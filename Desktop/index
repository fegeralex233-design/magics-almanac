document.addEventListener('input', function(e){
  if(e.target && e.target.id === 'homeSeekInput'){
    var q = e.target.value.trim().toLowerCase();
    var preview = document.getElementById('homeSeekPreview');
    if(!preview) return;
    if(!q){preview.innerHTML='';return;}
    var terms=q.split(/\s+/);
    var scored=[];
    for(var i=0;i<SEEK_INDEX.length;i++){
      var entry=SEEK_INDEX[i];
      var score=0;
      var allKeys=entry.keys.concat([entry.name.toLowerCase(),entry.tab]);
      for(var t=0;t<terms.length;t++){
        var term=terms[t];
        if(term.length<3)continue;
        for(var k=0;k<allKeys.length;k++){
          if(allKeys[k]===term)score+=10;
          else if(allKeys[k].indexOf(term)===0)score+=6;
          else if(allKeys[k].indexOf(term)>=0)score+=4;
        }
      }
      if(score>=4)scored.push({entry:entry,score:score});
    }
    scored.sort(function(a,b){return b.score-a.score;});
    var top=scored.slice(0,4);
    if(!top.length){preview.innerHTML='<div style="font-size:.8rem;color:#806090;padding:.3rem .2rem">Nothing found — try another word</div>';return;}
    var html='<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:.1rem">';
    for(var r=0;r<top.length;r++){
      var en=top[r].entry;
      html+='<button onclick="go(\''+en.tab+'\')" style="padding:.3rem .75rem;background:rgba(30,8,70,.8);border:1px solid rgba(201,162,39,.4);border-radius:20px;color:var(--gold);font-size:.8rem;cursor:pointer;font-family:Georgia,serif">'+en.icon+' '+en.name+'</button>';
    }
    if(scored.length>4){
      html+='<button onclick="seekSearch(\''+q+'\');go(\'seek\')" style="padding:.3rem .75rem;background:rgba(80,40,120,.3);border:1px solid rgba(150,100,200,.3);border-radius:20px;color:#c0a8e8;font-size:.8rem;cursor:pointer;font-family:Georgia,serif">+'+( scored.length-4)+' more →</button>';
    }
    html+='</div>';
    preview.innerHTML=html;
  }
});
