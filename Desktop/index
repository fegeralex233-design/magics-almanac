      // Place along perimeter of image border
      var side = Math.floor(Math.random() * 4);
      var x, y;
      if (side === 0) { x = Math.random() * W; y = 5 + Math.random()*30; }       // top
      else if (side === 1) { x = W-5-Math.random()*30; y = Math.random()*H; }    // right
      else if (side === 2) { x = Math.random() * W; y = H-5-Math.random()*30; }  // bottom
      else { x = 5+Math.random()*30; y = Math.random()*H; }                       // left
      var ang = Math.random() * Math.PI * 2;
      var spd = 0.6 + Math.random() * 1.4;
