// ═══ CAULDRON ANIMATION ═══
(function(){
  const canvas = document.getElementById('cauldronCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = 80, H = 70;
  const dpr = Math.min(window.devicePixelRatio||1,2);
  canvas.width = W*dpr; canvas.height = H*dpr;
  canvas.style.width = W+'px'; canvas.style.height = H+'px';
  ctx.setTransform(dpr,0,0,dpr,0,0);
  let frame = 0;
  const bubbles = Array.from({length:8}, (_,i) => ({
    x: 20 + Math.random()*40, y: 52 + Math.random()*6,
    r: 1.5 + Math.random()*2, vy: -(0.3+Math.random()*0.4),
    alpha: 0.8, life: 0, maxLife: 40+Math.floor(Math.random()*30),
    hue: Math.floor(Math.random()*60)+270
  }));

  function drawCauldron() {
    ctx.clearRect(0, 0, W, H);

    // Cauldron body — dark iron pot
    ctx.beginPath();
    ctx.ellipse(40, 58, 26, 10, 0, 0, Math.PI*2);
    ctx.fillStyle = '#1a0a2e';
    ctx.fill();
    ctx.strokeStyle = '#4a2a70';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Pot body
    ctx.beginPath();
    ctx.moveTo(16, 40);
    ctx.bezierCurveTo(12, 52, 14, 62, 40, 68);
    ctx.bezierCurveTo(66, 62, 68, 52, 64, 40);
    ctx.closePath();
    ctx.fillStyle = '#12082a';
    ctx.fill();
    ctx.strokeStyle = '#3a1a5e';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Pot rim
    ctx.beginPath();
    ctx.ellipse(40, 40, 24, 7, 0, 0, Math.PI*2);
    ctx.fillStyle = '#1e0a3a';
    ctx.fill();
    ctx.strokeStyle = '#5a2a8e';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Legs
    [[25,68,21,75],[55,68,59,75]].forEach(([x1,y1,x2,y2])=>{
      ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);
      ctx.strokeStyle='#2a1050';ctx.lineWidth=3;ctx.stroke();
    });

    // Fire underneath
    const fireColors = ['#ff4400','#ff8800','#ffcc00','#ff6600'];
    for (let i = 0; i < 5; i++) {
      const fx = 26 + i*7;
      const flicker = Math.sin(frame*0.15 + i*1.2) * 3;
      ctx.beginPath();
      ctx.moveTo(fx, 74);
      ctx.quadraticCurveTo(fx+2, 68+flicker, fx, 62+flicker*0.5);
      ctx.quadraticCurveTo(fx-2, 68+flicker*0.3, fx, 74);
      ctx.fillStyle = fireColors[i%4];
      ctx.globalAlpha = 0.7 + Math.sin(frame*0.2+i)*0.3;
      ctx.fill();
      ctx.globalAlpha = 1;
    }

    // Brew liquid surface
    const brewY = 40 + Math.sin(frame*0.08)*1.5;
    ctx.beginPath();
    ctx.ellipse(40, brewY, 22, 5, 0, 0, Math.PI*2);
    const brewGrad = ctx.createRadialGradient(40,brewY,2,40,brewY,22);
    brewGrad.addColorStop(0, `hsla(${270+frame%60},80%,50%,0.9)`);
    brewGrad.addColorStop(1, `hsla(${290+frame%40},60%,30%,0.7)`);
    ctx.fillStyle = brewGrad;
    ctx.fill();

    // Steam wisps
    for (let s = 0; s < 3; s++) {
      const sx = 30 + s*10;
      const sOff = Math.sin(frame*0.06 + s*2)*4;
      ctx.beginPath();
      ctx.moveTo(sx, brewY-2);
      ctx.bezierCurveTo(sx+sOff, brewY-10, sx-sOff, brewY-18, sx+sOff*0.5, brewY-26);
      ctx.strokeStyle = `rgba(180,150,255,${0.25 - s*0.05})`;
      ctx.lineWidth = 2+s;
      ctx.lineCap = 'round';
      ctx.stroke();
    }

    // Bubbles
    bubbles.forEach((b,i) => {
      b.life++;
      b.y += b.vy;
      b.alpha = b.life < 10 ? b.life/10 : 1 - (b.life-10)/(b.maxLife-10);
      if (b.life >= b.maxLife) {
        bubbles[i] = {x:20+Math.random()*40, y:brewY+Math.random()*4,
          r:1.5+Math.random()*2, vy:-(0.3+Math.random()*0.4),
          alpha:0, life:0, maxLife:40+Math.floor(Math.random()*30),
          hue:Math.floor(Math.random()*60)+270};
      }
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, Math.PI*2);
      ctx.strokeStyle = `hsla(${b.hue},80%,70%,${b.alpha*0.8})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    });

    // Sparkles above cauldron
    if (frame % 12 === 0) {
      const sx = 20 + Math.random()*40;
      const sy = 20 + Math.random()*15;
      ctx.save();
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = `hsl(${Math.floor(Math.random()*60+280)},90%,80%)`;
      ctx.font = `${8+Math.random()*6}px serif`;
      ctx.textAlign = 'center';
      ctx.fillText(['✦','✧','⋆','∗'][Math.floor(Math.random()*4)], sx, sy);
      ctx.restore();
    }

    frame++;
    requestAnimationFrame(drawCauldron);
  }
  drawCauldron();
})();

// ═══ BACKGROUND CANVAS ═══
(function(){
  const canvas=document.getElementById('bgCanvas');if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const SYMS=['✦','✧','⭐','☽','☾','⟡','◈','✵','❋','⋆','∗','⁂','△','▽','◇','○','✶','❉'];
  let W,H,particles=[],wand=null;
  function resize(){
    const dpr=Math.min(window.devicePixelRatio||1,2);
    W=window.innerWidth;H=window.innerHeight;
    canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function rnd(a,b){return a+Math.random()*(b-a);}
  function makeP(){const sym=SYMS[Math.floor(Math.random()*SYMS.length)];const isM=sym.includes('☽')||sym.includes('☾');const isH=Math.random()<0.04;
    return{x:rnd(0,W),y:rnd(0,H),sym:isH?'🧙':sym,size:isM?rnd(16,30):rnd(9,20),alpha:0,maxA:rnd(0.25,0.7),drift:rnd(-.15,.15),rise:rnd(-.12,-.04),life:0,maxLife:rnd(180,400),hue:Math.floor(rnd(240,310)),glow:isM||isH};}
  function makeW(){const side=Math.random()<.5?-1:1;return{x:side<0?-60:W+60,y:rnd(H*.1,H*.9),angle:rnd(-.3,.3)+(side<0?0:Math.PI),vx:side<0?rnd(.4,.9):rnd(-.9,-.4),vy:rnd(-.2,.2),len:rnd(38,55),sparkTimer:0,life:0,maxLife:rnd(300,600),trail:[]};}
  function spawnSparks(wx,wy){
    for(let i=0;i<3;i++){particles.push({x:wx,y:wy,sym:['✦','✧','⋆','∗'][Math.floor(Math.random()*4)],size:rnd(6,12),alpha:0,maxA:rnd(.5,.9),drift:rnd(-1.2,1.2),rise:rnd(-1.5,-.5),life:0,maxLife:rnd(40,80),hue:rnd(40,70),glow:true});}}
  resize();window.addEventListener('resize',resize);
  for(let i=0;i<35;i++){const p=makeP();p.life=Math.floor(Math.random()*p.maxLife);p.alpha=p.maxA*Math.sin(Math.PI*p.life/p.maxLife);particles.push(p);}
  wand=makeW();
  let frame=0;
  function draw(){
    ctx.clearRect(0,0,W,H);frame++;
    if(frame%40===0&&particles.length<60)particles.push(makeP());
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];p.life++;const pr=p.life/p.maxLife;
      if(pr<.2)p.alpha=p.maxA*(pr/.2);else if(pr>.8)p.alpha=p.maxA*((1-pr)/.2);else p.alpha=p.maxA;
      p.x+=p.drift;p.y+=p.rise;
      ctx.save();ctx.globalAlpha=p.alpha;if(p.glow){ctx.shadowBlur=18;ctx.shadowColor=`hsl(${p.hue},80%,70%)`;}
      ctx.font=`${p.size}px serif`;ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillStyle=p.sym.length===1&&p.sym.charCodeAt(0)<10000?`hsl(${p.hue},70%,75%)`:'white';
      ctx.fillText(p.sym,p.x,p.y);ctx.restore();if(p.life>=p.maxLife)particles.splice(i,1);
    }
    if(wand){
      wand.life++;const wp=wand.life/wand.maxLife;wand.alpha=wp<.1?wp/.1:wp>.85?(1-wp)/.15:1;
      wand.x+=wand.vx;wand.y+=wand.vy;wand.trail.push({x:wand.x,y:wand.y});if(wand.trail.length>28)wand.trail.shift();
      ctx.save();ctx.globalAlpha=wand.alpha*.35;ctx.strokeStyle='#f0c040';ctx.lineWidth=1.5;ctx.shadowBlur=8;ctx.shadowColor='#f0c040';
      ctx.beginPath();for(let t=0;t<wand.trail.length;t++){const pt=wand.trail[t];t===0?ctx.moveTo(pt.x,pt.y):ctx.lineTo(pt.x,pt.y);}ctx.stroke();ctx.restore();
      ctx.save();ctx.globalAlpha=wand.alpha;ctx.translate(wand.x,wand.y);ctx.rotate(wand.angle);
      const sg=ctx.createLinearGradient(0,0,wand.len,0);sg.addColorStop(0,'#f0c040');sg.addColorStop(.7,'#8040a0');sg.addColorStop(1,'#2a0a40');
      ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(wand.len,0);ctx.strokeStyle=sg;ctx.lineWidth=3.5;ctx.lineCap='round';ctx.shadowBlur=12;ctx.shadowColor='#c090f0';ctx.stroke();
      ctx.font='12px serif';ctx.fillStyle='#f0e040';ctx.shadowBlur=20;ctx.shadowColor='#ffe060';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('✦',0,0);ctx.restore();
      wand.sparkTimer++;if(wand.sparkTimer%22===0){const tx=wand.x+Math.cos(wand.angle)*wand.len;const ty=wand.y+Math.sin(wand.angle)*wand.len;spawnSparks(tx,ty);}
      if(wand.life>=wand.maxLife||wand.x<-120||wand.x>W+120){wand=null;setTimeout(()=>{wand=makeW();},rnd(3000,8000));}
    }
    if(!document.hidden)rafId=requestAnimationFrame(draw);else rafId=null;
  }
  let rafId=null;
  function startLoop(){if(rafId===null)rafId=requestAnimationFrame(draw);}
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)startLoop();});
  startLoop();
})();

