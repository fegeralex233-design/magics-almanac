<script>
// ── FIRST-PRINCIPLES DECISION ENGINE ─────────────────────────
var _deZodSign='${zodSign}';
var _deLp=${lp};
var _deMoon='${moon.name}';
var _deProd='${prod.name}';
var _deProdEl='${prod.element}';
var _deAccent='${accentColor}';

var _deZodBias={
  Aries:'Act fast once alignment is confirmed — delay is your real enemy, not the decision.',
  Taurus:'Give yourself 48 hours before committing. You decide best when the ground is steady under you.',
  Gemini:'Write both sides of this decision out fully. Your clarity arrives through articulation, not silence.',
  Cancer:'Trust the feeling in your body — but cross-check it against Filter 4. Intuition here is real; fear sometimes wears its face.',
  Leo:'Ask: am I doing this for myself or for an audience? The answer to that question is the decision.',
  Virgo:'Your analysis is correct. The problem is you will keep refining it. Set a deadline for the decision — tonight, or it never happens.',
  Libra:'You have been weighing this longer than you know. Pick the option you would choose if no one was affected but you. Then check the others.',
  Scorpio:'You already know. The work here is not finding the answer — it is giving yourself permission to act on the one you have been avoiding.',
  Sagittarius:'Scope is your blind spot. Is the version of this you are committing to the actual size of the thing, or the exciting version?',
  Capricorn:'The long-term math is in your favor. The short-term cost is real. Know which one is making you hesitate.',
  Aquarius:'You are optimizing for the vision. Make sure the version of this that exists in the world — not just your mind — can actually serve it.',
  Pisces:'Your instincts are extremely accurate here. Write them down before the second-guessing begins. That first feeling is the data.',
};

var _deMoonBias={
  'New Moon':'This is the ideal phase to commit and begin. The cycle opens. What you plant now compounds.',
  'Waxing Crescent':'Momentum is building. Move with it — this is not the time to hesitate.',
  'First Quarter':'Tension is part of the phase. Push through it. The friction here is the forge.',
  'Waxing Gibbous':'You are close to something. Refine, do not restart. The adjustment needed is smaller than it feels.',
  'Full Moon':'Peak clarity available now. Trust what you know. Heightened emotion is information, not noise.',
  'Waning Gibbous':'This is a completion phase — good for decisions that close chapters, consolidate, or release.',
  'Last Quarter':'Release what is not working. This phase supports endings and honest reckonings.',
  'Waning Crescent':'Rest before committing. If this cannot wait, go with the option that requires the least from you right now.',
};

function deCheckReady(){
  var goal=document.getElementById('de_goal').value.trim();
  var current=document.getElementById('de_current').value.trim();
  var ideal=document.getElementById('de_ideal').value.trim();
  var btn=document.getElementById('de_run');
  if(btn)btn.style.display=(goal&&current&&ideal)?'block':'none';
}

function deRun(){
  var goal=document.getElementById('de_goal').value.trim();
  var current=document.getElementById('de_current').value.trim();
  var ideal=document.getElementById('de_ideal').value.trim();
  var hazards=document.getElementById('de_hazards').value.trim();
  var nottodo=document.getElementById('de_nottodo').value.trim();
  var exec=document.getElementById('de_execution').value.trim();
  var data=document.getElementById('de_data').value.trim();
  var out=document.getElementById('de_output');
  if(!out)return;

  // Filter gap detection
  var gaps=[];
  if(!hazards&&!nottodo) gaps.push('Filter 2 is empty — you have not mapped what can go wrong. That is where most decisions fail.');
  if(!exec) gaps.push('Filter 3 has no execution step — there is no first move yet. A decision without a concrete action is a feeling, not a plan.');
  if(!data) gaps.push('Filter 4 has no objective data — nothing here is anchored to real numbers. Feelings are not base rates.');

  // Verdict
  var score=4-gaps.length-(hazards&&!nottodo?0.5:0);
  var verdict,verdictColor;
  if(score>=3.5&&gaps.length===0){verdict='All four filters clear — proceed.';verdictColor='#4ade80';}
  else if(score>=2.5){verdict='Mostly aligned — fill the gaps below.';verdictColor='#f59e0b';}
  else{verdict='Incomplete — build the full picture first.';verdictColor='#ef4444';}

  // Gap analysis
  var gapText='';
  if(current&&ideal){
    gapText='The gap between "'+current.substring(0,80)+(current.length>80?'…':'')+'" and "'+ideal.substring(0,80)+(ideal.length>80?'…':'')+'" is your operating distance. Every filter speaks to closing that distance without unnecessary casualties.';
  }

  // Zodiac lens
  var zodLens=_deZodBias[_deZodSign]||'';
  // Moon lens
  var moonLens=_deMoonBias[_deMoon]||'';
  // Talisman lens
  var talLens='Your '+_deProd+' ('+_deProdEl+' energy) is most active in decisions involving '+
    (_deProdEl==='Fire'?'bold action, leadership, and creative courage':
     _deProdEl==='Water'?'relationships, emotional truth, and intuitive pulls':
     _deProdEl==='Earth'?'resources, long-term structure, and what is real and lasting':
     'communication, perception, and choices that require clear thinking')+'.';

  // Next step
  var nextStep=exec||'Name one concrete action you can take within 24 hours. If you cannot name it, the decision is not ready.';

  out.innerHTML=\`
  <div style="background:#06000e;border-radius:10px;border:.5px solid \${verdictColor}44;padding:.9rem 1rem;margin-bottom:.65rem">
    <div style="font-size:.6rem;color:#6050a0;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.35rem">System Verdict</div>
    <div style="font-size:1.05rem;color:\${verdictColor};font-weight:600;margin-bottom:\${gapText?'.4rem':'0'}">\${verdict}</div>
    \${gapText?\`<div style="font-size:.82rem;color:#a090c0;line-height:1.6;font-style:italic">\${gapText}</div>\`:''}
  </div>

  \${gaps.length?\`<div style="margin-bottom:.65rem">
    <div style="font-size:.6rem;color:#ef4444;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.35rem">⚠ Critical Gaps</div>
    \${gaps.map(g=>\`<div style="display:flex;gap:.55rem;align-items:flex-start;background:rgba(239,68,68,.06);border-left:3px solid #ef4444;border-radius:4px;padding:.5rem .7rem;margin-bottom:.4rem;font-size:.82rem;color:#e0c0c0;line-height:1.5">⚠ \${g}</div>\`).join('')}
  </div>\`:''}

  <div style="margin-bottom:.65rem">
    <div style="font-size:.6rem;color:#6050a0;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.35rem">✦ Cosmic Lens</div>
    <div style="background:#0a0120;border-radius:9px;padding:.65rem .8rem;font-size:.82rem;color:#c0b8e0;line-height:1.65">
