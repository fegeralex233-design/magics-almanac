// ── SPLASH SEQUENCE ─────────────────────────────────────────────────
(function(){
  const splash=document.getElementById('magicsSplash');
  const canvas=document.getElementById('splashCanvas');
  const content=document.getElementById('splashContent');
  if(!splash||!canvas) return;

  const W=canvas.width=window.innerWidth;
  const H=canvas.height=window.innerHeight;
  const ctx=canvas.getContext('2d');

  const glyphs=['\u00b7','\u00b7','\u22c6','\u2022','\u00b7','+','\u00b7'];
  const colors=['#f0c040','#e8d8ff','#ffffff','#ffd6fa','#ffd76a','#ffe4b5'];

  function mkP(burst){
    return{
      x: burst ? W/2+(Math.random()-0.5)*W*0.9 : Math.random()*W,
      y: burst ? H/2+(Math.random()-0.5)*H*0.9 : Math.random()*H,
      vx:(Math.random()-0.5)*(burst?4:0.3),
      vy:(Math.random()-0.5)*(burst?4:0.3)-(burst?0.5:0),
      life:1, decay: burst ? 0.02+Math.random()*0.03 : 0.005+Math.random()*0.007,
      size: burst ? 0.45+Math.random()*0.6 : 0.3+Math.random()*0.45,
      glyph:glyphs[Math.floor(Math.random()*glyphs.length)],
      col:colors[Math.floor(Math.random()*colors.length)]
    };
  }

  const particles=[];
  for(let i=0;i<50;i++) particles.push(mkP(false));

  let phase=1, startTime=performance.now(), raf;

  function draw(now){
    const elapsed=(now-startTime)/1000;
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);

    // Phase 1: ambient sparkles (0-1.4s)
    if(phase===1 && elapsed>1.4){ phase=2; }

    // Phase 2: black flash (1.4-1.8s)
    if(phase===2 && elapsed>1.8){
      particles.length=0;
      for(let i=0;i<100;i++) particles.push(mkP(true));
      phase=3;
      setTimeout(()=>{if(content)content.style.opacity='1';},500);
    }

    // Phase 3: sparkles burst + MAGICS fades in (1.8-3.8s)
    if(phase===3 && elapsed>3.8){
      phase=4;
      // One big final burst
      for(let i=0;i<80;i++) particles.push(mkP(true));
      // Then clean cut — fade splash, load app
      setTimeout(()=>{
        splash.style.transition='opacity 0.6s ease';
        splash.style.opacity='0';
        setTimeout(()=>{
          if(splash.parentNode) splash.parentNode.removeChild(splash);
          ctx.clearRect(0,0,W,H);
          particles.length=0;
          cancelAnimationFrame(raf);
        },600);
      },400);
    }

    // Draw particles
    if(phase!==2){
      for(let i=particles.length-1;i>=0;i--){
        const p=particles[i];
        p.x+=p.vx; p.y+=p.vy; p.life-=p.decay;
        if(p.life<=0){particles.splice(i,1);continue;}
        ctx.globalAlpha=p.life;
        ctx.fillStyle=p.col;
        ctx.font=(p.size*14)+'px serif';
        ctx.textAlign='center';ctx.textBaseline='middle';
        ctx.fillText(p.glyph,p.x,p.y);
      }
      ctx.globalAlpha=1;
      if(phase===1 && particles.length<60) particles.push(mkP(false));
    }

    if(phase<4) raf=requestAnimationFrame(draw);
  }
  raf=requestAnimationFrame(draw);
})();

