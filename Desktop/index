// ═══ WAND: BACK TO TOP ═══
(function(){
  let ticking=false;
  function updateWandVisibility(){
    const btn=document.getElementById('wandTopBtn');
    if(!btn)return;
    const show=(window.scrollY||document.documentElement.scrollTop||0)>320;
    btn.style.display=show?'flex':'none';
    ticking=false;
  }
  window.addEventListener('scroll',()=>{
