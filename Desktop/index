function selPO(v,btn){feastOccasion=feastOccasion===v?'':v;document.querySelectorAll('#pOccChips .chip').forEach(b=>b.classList.remove('sel'));if(feastOccasion)btn.classList.add('sel');}
function selPI(v,btn){feastIntent=feastIntent===v?'':v;document.querySelectorAll('#pIntChips .chip').forEach(b=>b.classList.remove('sel'));if(feastIntent)btn.classList.add('sel');}

async function buildFeast(){
  if(feastBuilding)return;
  feastBuilding=true;
  const loadEl=document.getElementById('feastLoading');
  const resEl=document.getElementById('feastResult');
  loadEl.style.display='block';
  resEl.style.display='none';resEl.innerHTML='';
  const occ=feastOccasion||'a magical gathering';
  const intent=feastIntent||'celebration and wonder';
  try{
    const text=await aiText(
      `Occasion: ${occ}\nIntent: ${intent}`,
      `You are the keeper of a magical feast grimoire — a scholar of sacred and folkloric food traditions across world history. Assemble a full thematic 4-course feast grounded in real historical magical food traditions. Draw from Celtic, Norse, Greek, Roman, Slavic, Persian, or Egyptian traditions.\n\nFormat exactly:\nFEAST_NAME: [dramatic magical feast name]\nFEAST_INVOCATION: [1 atmospheric sentence, max 20 words]\n\nCOURSE_1_LABEL: [e.g. The Opening Charm]\nCOURSE_1_NAME: [magical dish name]\nCOURSE_1_DESC: [real food + 1 sentence of magical/historical significance]\n\nCOURSE_2_LABEL:\nCOURSE_2_NAME:\nCOURSE_2_DESC:\n\nCOURSE_3_LABEL:\nCOURSE_3_NAME:\nCOURSE_3_DESC:\n\nCOURSE_4_LABEL:\nCOURSE_4_NAME:\nCOURSE_4_DESC:\n\nBLESSING: [one short poetic line to say before eating, max 12 words]\n\nKeep every DESC under 2 sentences. Be specific and historically grounded.`
    );
    const g=(key)=>{const m=text.match(new RegExp(key+':\\s*(.+?)(?=\\n[A-Z_0-9]+:|$)','s'));return m?m[1].trim():'';};
    const courses=[1,2,3,4].map(n=>({label:g(`COURSE_${n}_LABEL`),name:g(`COURSE_${n}_NAME`),desc:g(`COURSE_${n}_DESC`)})).filter(c=>c.name);
    resEl.innerHTML=`
      <div style="background:linear-gradient(135deg,#0e0225,#1a0a10);border:1px solid var(--gold);border-radius:12px;padding:.85rem 1rem;margin-bottom:.65rem">
        <div style="font-family:Georgia,serif;font-size:1.2rem;color:var(--gold);margin-bottom:.2rem">${g('FEAST_NAME')||'The Conjured Feast'}</div>
        <div style="font-size:.93rem;color:#c0b0e0;font-style:italic">${g('FEAST_INVOCATION')}</div>
      </div>
      ${courses.map(c=>`
        <div style="background:#0e0225;border:.5px solid #3a2060;border-radius:10px;padding:.7rem .9rem;margin-bottom:.5rem">
          <div style="font-size:.72rem;font-weight:700;color:#9080b8;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.18rem">${c.label}</div>
          <div style="font-family:Georgia,serif;font-size:1.05rem;color:var(--gold);margin-bottom:.18rem">${c.name}</div>
          <div style="font-size:.93rem;color:#ffffff;line-height:1.55">${c.desc}</div>
        </div>`).join('')}
      ${g('BLESSING')?`<div style="background:rgba(201,162,39,.07);border:1px solid rgba(201,162,39,.3);border-radius:10px;padding:.65rem 1rem;text-align:center;margin-top:.55rem">
        <div style="font-size:.72rem;color:var(--gold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:.25rem">✦ Before the first bite ✦</div>
        <div style="font-family:Georgia,serif;font-size:1rem;color:#ffffff;font-style:italic">"${g('BLESSING')}"</div>
      </div>`:''}
      <button onclick="buildFeast()" style="width:100%;margin-top:.6rem;padding:.55rem;background:none;color:#9080b8;border:.5px solid #2a1050;border-radius:10px;font-size:.92rem;cursor:pointer;font-family:inherit">✦ Conjure a different feast</button>`;
    // Share button
  if(!document.getElementById('feastShareBtn')){
    const fs=document.createElement('button');
    fs.id='feastShareBtn';
    fs.style.cssText='width:100%;margin-top:.5rem;padding:.5rem;background:none;color:#b080c0;border:.5px solid #4a2060;border-radius:8px;font-size:.88rem;cursor:pointer;font-family:inherit';
    fs.textContent='↗ Share this feast';
    fs.onclick=()=>shareResult("A Wizard's Feast",resEl.innerText.replace(/↗.*/s,'').trim()+'\n\n— from MAGICS');
    resEl.appendChild(fs);
  }
  resEl.style.display='block';
  }catch(e){
