      <div style="font-size:.65rem;color:#5040a0;letter-spacing:.2em;text-transform:uppercase;margin-bottom:.3rem;margin-top:.6rem">✦ Decision Engine</div>
      <div style="font-size:1.15rem;color:var(--gold);margin-bottom:.3rem;letter-spacing:.04em">First-Principles Decision Engine</div>
      <div style="font-size:.82rem;color:#a090c0;margin-bottom:.85rem;line-height:1.6">Hold your ${prod.emoji}. Name one decision you are circling. Run it through all four filters. The engine strips away everything false so only the truth remains.</div>
      <div id="de-cosmic-bar" style="background:rgba(201,162,39,.04);border:.5px solid rgba(201,162,39,.18);border-radius:9px;padding:.6rem .8rem;margin-bottom:1rem;font-size:.78rem;color:#a090c0;line-height:1.6">
        <span style="color:rgba(201,162,39,.6);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;display:block;margin-bottom:.2rem">Your Cosmic Filter</span>
        <strong style="color:#d8d0f0">${zodSign} ${zodEmoji}</strong> — ${TALISMAN_ZOD_TRAIT[zodSign].split('.')[0]}. &nbsp;·&nbsp;
        <strong style="color:#d8d0f0">Life Path ${lp}</strong> — ${lpDesc.split('.')[0]}. &nbsp;·&nbsp;
        <strong style="color:#d8d0f0">${moon.name}</strong> — ${lunarGuide[moon.name]?lunarGuide[moon.name].split('.')[0]:'Current phase'}.
      </div>
      <div style="margin-bottom:.85rem">
        <div style="font-size:.6rem;color:#6050a0;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.35rem">Target Pursuit / Primary Decision</div>
