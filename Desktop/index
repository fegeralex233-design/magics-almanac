function drawZodiacButterfly(redrawOnly){
  var bStr=document.getElementById('bfBirth').value;
  var mode=document.getElementById('bfMode').value;
  if(!bStr){alert('Please enter your birthday first.');return;}
  var d=new Date(bStr+'T12:00:00');
  var mo=d.getMonth()+1,dy=d.getDate();
  var signs=['Capricorn','Aquarius','Pisces','Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn'];
  var cuts=[20,19,21,20,21,22,22,23,23,23,22,22,99];
  var signIdx=mo-1; if(dy<cuts[signIdx])signIdx=(signIdx+11)%12;
  var sign=signs[signIdx];
  var bdata=ZODIAC_BUTTERFLY[sign];
  var out=document.getElementById('bf-output');
  if(out)out.style.display='block';
  document.getElementById('bf-sign-line').textContent=bdata.emoji+' '+sign.toUpperCase()+' BUTTERFLY '+bdata.emoji;
  document.getElementById('bf-name').textContent=bdata.emoji+' The '+sign+' Butterfly';
  document.getElementById('bf-desc').textContent=bdata.desc;
  document.getElementById('bf-crystal').textContent='Crystal resonance: '+bdata.crystal+' · Element: '+bdata.element;
  // Set default saying if field is empty
  var sayingEl=document.getElementById('bfSaying');
  if(sayingEl&&(!sayingEl.value||sayingEl.value===''))sayingEl.value=bdata.saying;
  var cv=document.getElementById('bf-canvas');
  if(!cv)return;
  var ctx=cv.getContext('2d');
  var W=cv.width,H=cv.height;
  // Pick colors
  var rawCols;
  if(mode==='kids'){
    rawCols=BUTTERFLY_KIDS_COLORS[sign].split(',');
  } else {
    rawCols=bdata.colors;
  }
  var c1=rawCols[0],c2=rawCols[1],c3=rawCols[2];
  // Background
  if(mode==='kids'){
    var bg=ctx.createLinearGradient(0,0,W,H);
    bg.addColorStop(0,'#fff8ff');bg.addColorStop(0.5,'#f0fcff');bg.addColorStop(1,'#fffce8');
    ctx.fillStyle=bg;
  } else {
    var bg2=ctx.createLinearGradient(0,0,W,H);
    bg2.addColorStop(0,'#06000e');bg2.addColorStop(0.5,'#0a0220');bg2.addColorStop(1,'#04000a');
    ctx.fillStyle=bg2;
  }
  ctx.fillRect(0,0,W,H);
  // Stars / sparkles in background
  if(mode==='adult'){
    for(var i=0;i<40;i++){
      var sx=Math.random()*W,sy=Math.random()*H;
      ctx.fillStyle='rgba(255,255,255,'+(0.05+Math.random()*0.12)+')';
      ctx.beginPath();ctx.arc(sx,sy,0.8,0,Math.PI*2);ctx.fill();
    }
  } else {
    // Pastel dots for kids
    var kidDotCols=['#ffcccc','#ccffcc','#ccccff','#ffffcc','#ffccff','#ccffff'];
    for(var j=0;j<25;j++){
      var kx=Math.random()*W,ky=Math.random()*H;
      ctx.fillStyle=kidDotCols[j%6];
      ctx.beginPath();ctx.arc(kx,ky,2+Math.random()*3,0,Math.PI*2);ctx.fill();
    }
  }
  // Draw butterfly centered at W/2, H/2
  var cx2=W/2,cy2=H/2+10;
  bfDrawWings(ctx,cx2,cy2,c1,c2,c3,mode,bdata.wing,sign);
  // Body
  var bodyGrad=ctx.createLinearGradient(cx2-6,cy2-70,cx2+6,cy2+60);
  bodyGrad.addColorStop(0,mode==='kids'?'#888':'#1a0a28');
  bodyGrad.addColorStop(0.4,mode==='kids'?c1:'#2a1040');
  bodyGrad.addColorStop(1,mode==='kids'?'#666':'#080010');
  ctx.fillStyle=bodyGrad;
  // body shape (oval)
  ctx.beginPath();
  ctx.ellipse(cx2,cy2-10,7,60,0,0,Math.PI*2);
  ctx.fill();
  // Head
  ctx.fillStyle=mode==='kids'?c1:c2;
  ctx.beginPath();ctx.arc(cx2,cy2-68,9,0,Math.PI*2);ctx.fill();
  // Eyes
  ctx.fillStyle=mode==='kids'?'#333':'#000';
  ctx.beginPath();ctx.arc(cx2-4,cy2-70,2,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(cx2+4,cy2-70,2,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';
  ctx.beginPath();ctx.arc(cx2-3,cy2-71,0.8,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(cx2+5,cy2-71,0.8,0,Math.PI*2);ctx.fill();
  // Antennae
  ctx.strokeStyle=mode==='kids'?c1:c2;ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(cx2-3,cy2-76);ctx.quadraticCurveTo(cx2-22,cy2-105,cx2-18,cy2-118);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx2+3,cy2-76);ctx.quadraticCurveTo(cx2+22,cy2-105,cx2+18,cy2-118);ctx.stroke();
  ctx.fillStyle=mode==='kids'?c2:c3;
  ctx.beginPath();ctx.arc(cx2-18,cy2-118,4,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(cx2+18,cy2-118,4,0,Math.PI*2);ctx.fill();
  // Sign symbol centered on body
  ctx.save();
  ctx.font='bold 18px Georgia,serif';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillStyle=mode==='kids'?'rgba(80,80,80,0.4)':'rgba(255,255,255,0.25)';
  ctx.fillText(bdata.emoji,cx2,cy2-10);
  ctx.restore();
  // Border glow
  if(mode==='adult'){
    var grd=ctx.createRadialGradient(cx2,cy2,60,cx2,cy2,158);
    grd.addColorStop(0,'transparent');
    grd.addColorStop(0.7,'transparent');
    grd.addColorStop(1,'rgba('+hexToRgb(c1)+',0.12)');
    ctx.fillStyle=grd;ctx.fillRect(0,0,W,H);
  }
  // Draw the saying at bottom of canvas
  var sayingEl2=document.getElementById('bfSaying');
  var sayingText=sayingEl2?sayingEl2.value:'';
  if(!sayingText)sayingText=bdata.saying;
  if(sayingText){
    var sayY=H-34;
    // Background strip for saying
    ctx.fillStyle=mode==='kids'?'rgba(255,255,255,0.55)':'rgba(0,0,0,0.52)';
    ctx.beginPath();ctx.roundRect(12,sayY-14,W-24,28,6);ctx.fill();
    // Saying text — wrap if long
    ctx.save();
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font=(mode==='kids'?'italic 11.5px':'italic 11px')+' Georgia,serif';
    ctx.fillStyle=mode==='kids'?'#5030a0':'rgba(220,200,255,0.9)';
    // Measure and wrap
    var maxW=W-36;
    var words=sayingText.split(' ');
    var lines2=[],cur2='';
    for(var wi=0;wi<words.length;wi++){
      var test2=cur2+(cur2?' ':'')+words[wi];
      if(ctx.measureText(test2).width>maxW&&cur2!==''){lines2.push(cur2);cur2=words[wi];}
      else cur2=test2;
    }
    if(cur2)lines2.push(cur2);
    var lineH2=13;
    var totalH2=lines2.length*lineH2;
    // Re-size background
    ctx.restore();
    ctx.fillStyle=mode==='kids'?'rgba(255,255,255,0.55)':'rgba(0,0,0,0.52)';
    ctx.beginPath();
    if(ctx.roundRect)ctx.roundRect(12,H-totalH2-22,W-24,totalH2+14,6);
    else{ctx.rect(12,H-totalH2-22,W-24,totalH2+14);}
    ctx.fill();
    ctx.save();
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font=(mode==='kids'?'italic 11.5px':'italic 11px')+' Georgia,serif';
    ctx.fillStyle=mode==='kids'?'#5030a0':'rgba(220,200,255,0.9)';
    for(var li2=0;li2<lines2.length;li2++){
      ctx.fillText(lines2[li2],W/2,H-totalH2-22+14+li2*lineH2+(lineH2/2));
    }
    ctx.restore();
  }
  // "Create a wish, receive a wish" tagline tiny at very bottom
  ctx.save();
  ctx.textAlign='center';ctx.textBaseline='bottom';
  ctx.font='9px Georgia,serif';
  ctx.fillStyle=mode==='kids'?'rgba(140,80,200,0.4)':'rgba(180,150,220,0.3)';
  ctx.fillText('Create a wish ~ let it fly ~ one day it returns', W/2, H-3);
  ctx.restore();
}

function bfDrawWings(ctx,cx,cy,c1,c2,c3,mode,wingType,sign){
  // Upper wings (larger)
  ctx.save();
  // Left upper
  var ulg=ctx.createRadialGradient(cx-55,cy-40,5,cx-55,cy-40,110);
  ulg.addColorStop(0,mode==='kids'?lightenHex(c1,0.3):c1);
  ulg.addColorStop(0.5,mode==='kids'?lightenHex(c2,0.25):c2);
  ulg.addColorStop(1,mode==='kids'?lightenHex(c3,0.1)+'88':c3+'44');
  ctx.fillStyle=ulg;
  ctx.beginPath();
  ctx.moveTo(cx-5,cy-55);
  ctx.bezierCurveTo(cx-30,cy-130,cx-140,cy-100,cx-130,cy-10);
  ctx.bezierCurveTo(cx-120,cy+30,cx-40,cy+10,cx-5,cy);
  ctx.closePath();ctx.fill();
  // Right upper (mirror)
  var urg=ctx.createRadialGradient(cx+55,cy-40,5,cx+55,cy-40,110);
  urg.addColorStop(0,mode==='kids'?lightenHex(c1,0.3):c1);
  urg.addColorStop(0.5,mode==='kids'?lightenHex(c2,0.25):c2);
  urg.addColorStop(1,mode==='kids'?lightenHex(c3,0.1)+'88':c3+'44');
  ctx.fillStyle=urg;
  ctx.beginPath();
  ctx.moveTo(cx+5,cy-55);
  ctx.bezierCurveTo(cx+30,cy-130,cx+140,cy-100,cx+130,cy-10);
  ctx.bezierCurveTo(cx+120,cy+30,cx+40,cy+10,cx+5,cy);
  ctx.closePath();ctx.fill();
  // Lower wings (smaller)
  var llg=ctx.createRadialGradient(cx-45,cy+40,5,cx-45,cy+40,80);
  llg.addColorStop(0,mode==='kids'?lightenHex(c2,0.25):c2);
  llg.addColorStop(1,mode==='kids'?lightenHex(c1,0.15)+'88':c1+'55');
  ctx.fillStyle=llg;
  ctx.beginPath();
  ctx.moveTo(cx-5,cy+5);
  ctx.bezierCurveTo(cx-30,cy+20,cx-110,cy+30,cx-100,cy+90);
  ctx.bezierCurveTo(cx-90,cy+120,cx-25,cy+80,cx-5,cy+55);
  ctx.closePath();ctx.fill();
  var lrg=ctx.createRadialGradient(cx+45,cy+40,5,cx+45,cy+40,80);
  lrg.addColorStop(0,mode==='kids'?lightenHex(c2,0.25):c2);
  lrg.addColorStop(1,mode==='kids'?lightenHex(c1,0.15)+'88':c1+'55');
  ctx.fillStyle=lrg;
  ctx.beginPath();
  ctx.moveTo(cx+5,cy+5);
  ctx.bezierCurveTo(cx+30,cy+20,cx+110,cy+30,cx+100,cy+90);
  ctx.bezierCurveTo(cx+90,cy+120,cx+25,cy+80,cx+5,cy+55);
  ctx.closePath();ctx.fill();
  // Wing patterns — eyespots & veins
  bfWingDetails(ctx,cx,cy,c1,c2,c3,mode,wingType);
  ctx.restore();
}

function bfWingDetails(ctx,cx,cy,c1,c2,c3,mode,wingType){
  var al=mode==='adult'?0.55:0.4;
  // Eyespots on upper wings
  function eyespot(ex,ey,r){
    ctx.fillStyle=mode==='kids'?'rgba(255,255,255,0.5)':'rgba(0,0,0,0.45)';
    ctx.beginPath();ctx.arc(ex,ey,r,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=c2;
    ctx.beginPath();ctx.arc(ex,ey,r*0.65,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=mode==='kids'?'rgba(255,255,255,0.8)':'rgba(255,255,255,0.3)';
    ctx.beginPath();ctx.arc(ex,ey,r*0.3,0,Math.PI*2);ctx.fill();
  }
  eyespot(cx-65,cy-45,18);
  eyespot(cx+65,cy-45,18);
  eyespot(cx-55,cy+45,12);
  eyespot(cx+55,cy+45,12);
  // Veins
  ctx.strokeStyle=mode==='kids'?'rgba(255,255,255,0.35)':'rgba(0,0,0,0.3)';
  ctx.lineWidth=0.8;
  // Left upper veins
  [[cx-5,cy-40,cx-80,cy-80],[cx-5,cy-20,cx-100,cy-30],[cx-5,cy,cx-90,cy+20]].forEach(function(v){
    ctx.beginPath();ctx.moveTo(v[0],v[1]);ctx.lineTo(v[2],v[3]);ctx.stroke();
  });
  // Right upper veins
  [[cx+5,cy-40,cx+80,cy-80],[cx+5,cy-20,cx+100,cy-30],[cx+5,cy,cx+90,cy+20]].forEach(function(v){
    ctx.beginPath();ctx.moveTo(v[0],v[1]);ctx.lineTo(v[2],v[3]);ctx.stroke();
  });
  // Wing edge highlight
  ctx.strokeStyle=mode==='kids'?'rgba(255,255,255,0.5)':'rgba(255,255,255,0.1)';
  ctx.lineWidth=1.5;
  ctx.beginPath();
  ctx.moveTo(cx-5,cy-55);
  ctx.bezierCurveTo(cx-30,cy-130,cx-140,cy-100,cx-130,cy-10);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(cx+5,cy-55);
  ctx.bezierCurveTo(cx+30,cy-130,cx+140,cy-100,cx+130,cy-10);
  ctx.stroke();
}

function lightenHex(hex,amt){
  hex=hex.replace('#','');
  var r=parseInt(hex.slice(0,2),16),g=parseInt(hex.slice(2,4),16),b=parseInt(hex.slice(4,6),16);
  r=Math.min(255,Math.floor(r+(255-r)*amt));
  g=Math.min(255,Math.floor(g+(255-g)*amt));
  b=Math.min(255,Math.floor(b+(255-b)*amt));
  return '#'+(r<16?'0':'')+r.toString(16)+(g<16?'0':'')+g.toString(16)+(b<16?'0':'')+b.toString(16);
}
function hexToRgb(hex){
  hex=hex.replace('#','');
  return parseInt(hex.slice(0,2),16)+','+parseInt(hex.slice(2,4),16)+','+parseInt(hex.slice(4,6),16);
}

