    +'<ellipse cx="50" cy="52" rx="11" ry="16" fill="#2a8c60" />'
    +'<ellipse cx="50" cy="52" rx="9" ry="14" fill="#3ab87c" />'
    +'<circle cx="50" cy="22" r="21" fill="#2a8c60" />'
    +'<circle cx="50" cy="22" r="19" fill="#3ab87c" />'
    +'<ellipse cx="46" cy="13" rx="7" ry="5" fill="#4ed491" opacity=".45" />'
    +'<circle cx="40" cy="20" r="6" fill="#fff" />'
    +'<circle cx="40" cy="21" r="3.8" fill="#1a1a3a" />'
    +'<circle cx="38.5" cy="19.5" r="1.3" fill="#fff" />'
    +'<circle cx="60" cy="20" r="6" fill="#fff" />'
    +'<circle cx="60" cy="21" r="3.8" fill="#1a1a3a" />'
    +'<circle cx="58.5" cy="19.5" r="1.3" fill="#fff" />'
    +'<path d="M35 14 Q40 11 45 14" stroke="#1a6040" stroke-width="1.8" fill="none" stroke-linecap="round"/>'
    +'<path d="M55 14 Q60 11 65 14" stroke="#1a6040" stroke-width="1.8" fill="none" stroke-linecap="round"/>'
    +'<circle cx="47" cy="26" r="1.8" fill="#1a6040" />'
    +'<circle cx="53" cy="26" r="1.8" fill="#1a6040" />'
    +'<path d="M38 30 Q50 39 62 30" stroke="#1a6040" stroke-width="2" fill="none" stroke-linecap="round"/>'
    +'<circle cx="34" cy="28" r="5" fill="#e87070" opacity=".3" />'
    +'<circle cx="66" cy="28" r="5" fill="#e87070" opacity=".3" />'
    +'<ellipse cx="40" cy="4" rx="4" ry="7" fill="#2a8c60" transform="rotate(-15 40 4)" />'
    +'<ellipse cx="50" cy="2" rx="3" ry="6" fill="#2a8c60" />'
    +'<ellipse cx="60" cy="4" rx="4" ry="7" fill="#2a8c60" transform="rotate(15 60 4)" />'
