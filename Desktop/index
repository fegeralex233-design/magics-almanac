function searchDreams(){
  var q = document.getElementById('dreamSearch').value.toLowerCase().trim();
  var res = document.getElementById('dreamSearchResults');
  if(!q || q.length < 2){ res.innerHTML=''; return; }
  var syms = window._dreamSymbols || [];
  var matches = syms.filter(function(s){
    return s.symbol.toLowerCase().indexOf(q)>=0 || s.meaning.toLowerCase().indexOf(q)>=0;
  });
  if(matches.length===0){
    res.innerHTML = '<p style="color:#706850;font-size:.85rem;font-style:italic">No exact match — but every symbol is personal. Trust what this image means to you.</p>';
    return;
  }
  var h = '';
  for(var i=0;i<matches.length;i++){
    var m = matches[i];
    h += '<div style="background:'+m.bg+';border:1px solid '+m.color+';border-radius:10px;padding:.8rem;margin-bottom:.5rem">';
    h += '<div style="font-weight:700;color:'+m.color+';margin-bottom:.3rem">'+m.emoji+' '+m.symbol+'</div>';
    h += '<p style="color:#c0b8e0;font-size:.83rem;line-height:1.5;margin:0 0 .4rem">'+m.meaning+'</p>';
    h += '<p style="color:'+m.color+';font-size:.8rem;font-style:italic;margin:0">'+m.questions+'</p>';
    h += '</div>';
  }
  res.innerHTML = h;
}


