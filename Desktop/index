// ── LUNAR CALENDAR ─────────────────────────────────────────────
function moonPhaseAtDate(ts){
  var cycle=(ts/2551442880)%1;
  var phases=['🌑','🌒','🌓','🌔','🌕','🌖','🌗','🌘'];
  var names=['New Moon','Waxing Crescent','First Quarter','Waxing Gibbous','Full Moon','Waning Gibbous','Last Quarter','Waning Crescent'];
  var idx=Math.floor(cycle*8)%8;
  return{emoji:phases[idx],name:names[idx],cycle:cycle,idx:idx};
}

function buildCalendar(){
  var now=new Date();
  var year=now.getFullYear(),month=now.getMonth();
  var monthNames=['January','February','March','April','May','June','July','August','September','October','November','December'];
  var title=document.getElementById('cal-month-title');
  if(title)title.textContent='Moon Phases — '+monthNames[month]+' '+year;

  // Current moon
  var mp=moonPhaseAtDate(Date.now());
  var moonEmojis=['🌑','🌒','🌓','🌔','🌕','🌖','🌗','🌘'];
  var moonTips={
    'New Moon':'Set intentions. Begin what you have been postponing. The cycle opens tonight.',
    'Waxing Crescent':'Build momentum. Make the calls. Cut hair if you want growth.',
    'First Quarter':'Act on decisions. Push through resistance. Energy is rising.',
    'Waxing Gibbous':'Refine and adjust. You are closer than you think.',
    'Full Moon':'Peak power. Charge your talisman under moonlight tonight. Divination is sharpest.',
    'Waning Gibbous':'Share what you have gathered. Teach and release.',
    'Last Quarter':'Release. Clear what no longer serves. Trim for maintenance.',
    'Waning Crescent':'Rest. Surrender. The dark before the new — deepest intuition.'
  };
  var mel=document.getElementById('cal-moon-emoji');
  var mnm=document.getElementById('cal-moon-name');
  var mdt=document.getElementById('cal-moon-date');
  var mtp=document.getElementById('cal-moon-tip');
  if(mel)mel.textContent=mp.emoji;
  if(mnm)mnm.textContent=mp.name;
  if(mdt)mdt.textContent=now.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});
  if(mtp)mtp.textContent=moonTips[mp.name]||'';

  // Month grid
  var grid=document.getElementById('cal-grid');
  if(!grid)return;
  var days=['SUN','MON','TUE','WED','THU','FRI','SAT'];
  var html=days.map(function(d){return'<div class="cal-cell header">'+d+'</div>';}).join('');
  var firstDay=new Date(year,month,1).getDay();
  var daysInMonth=new Date(year,month+1,0).getDate();
  for(var i=0;i<firstDay;i++)html+='<div class="cal-cell"></div>';
  for(var d2=1;d2<=daysInMonth;d2++){
    var dt=new Date(year,month,d2);
    var ph=moonPhaseAtDate(dt.getTime());
    var isToday=d2===now.getDate();
    var cls='cal-cell';
    if(ph.idx===0||ph.idx===4||ph.idx===2||ph.idx===6)cls+=' has-moon';
    if(isToday)cls+=' today';
    html+='<div class="'+cls+'" title="'+ph.name+'">'+(ph.idx===0||ph.idx===4||ph.idx===2||ph.idx===6?ph.emoji:d2)+'</div>';
  }
  grid.innerHTML=html;

  // Upcoming key dates
  var upcoming=document.getElementById('cal-upcoming');
  if(!upcoming)return;
  var lines=[];
  var synodic=29.53058770576;
  var knownNewMs=new Date(2024,0,11).getTime(); // Jan 11 2024 was new moon
  var nowMs=Date.now();
  var phaseMs=((nowMs-knownNewMs)%(synodic*86400000)+synodic*86400000)%(synodic*86400000);
  var fullNames=['New Moon','Waxing Crescent','First Quarter','Waxing Gibbous','Full Moon','Waning Gibbous','Last Quarter','Waning Crescent'];
  var keyPhases=[0,2,4,6]; // new, first q, full, last q
  var keyDays=[0, synodic*0.25, synodic*0.5, synodic*0.75];
  for(var k=0;k<4;k++){
    var daysUntil=keyDays[k]-(phaseMs/86400000);
    if(daysUntil<0)daysUntil+=synodic;
    var phDate=new Date(nowMs+daysUntil*86400000);
    var label=fullNames[keyPhases[k]];
    var emoji=moonEmojis[keyPhases[k]];
    lines.push(emoji+' <strong style="color:var(--gold)">'+label+'</strong> — '+phDate.toLocaleDateString('en-US',{month:'short',day:'numeric'})+(daysUntil<1?' (tomorrow)':' (in '+Math.ceil(daysUntil)+' days)'));
  }
  lines.sort(function(a,b){return a.indexOf('in ')-b.indexOf('in ');});
  upcoming.innerHTML=lines.join('<br>');
}

