    row.appendChild(b);
  });
  // Also populate realm collapsible sections if they exist
  var containers={circle:document.getElementById('realmCircleBtns'),triangle:document.getElementById('realmTriangleBtns'),pentagon:document.getElementById('realmPentagonBtns')};
  if(containers.circle){
    nonHome.forEach(function(t){
