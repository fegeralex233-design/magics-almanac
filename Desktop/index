let calMagicState={month:new Date().getMonth(),year:new Date().getFullYear(),view:'month',editId:null,upcomingOpen:false};

function renderMagicCalendar(){
  const s=calMagicState;
  const now=new Date();
  const entries=calLoad();
  const mo=s.month; // 0-indexed
  const yr=s.year;
  const monthName=['January','February','March','April','May','June','July','August','September','October','November','December'][mo];

  // Build day grid
  const firstDay=new Date(yr,mo,1).getDay(); // 0=Sun
  const daysInMonth=new Date(yr,mo+1,0).getDate();

  // Collect events for this month
  function eventsOnDay(d){
    const result=[];
    // Magic dates
    MAGIC_DATES.forEach(md=>{if(md.mo===mo+1&&md.dy===d)result.push({...md,kind:'magic'});});
    // Personal entries
    entries.forEach(e=>{
      const ed=new Date(e.date);
      if(ed.getMonth()===mo&&ed.getFullYear()===yr&&ed.getDate()===d) result.push({...e,kind:'personal'});
      // Recurring birthdays match any year
      if(e.recurring&&ed.getMonth()===mo&&ed.getDate()===d) result.push({...e,kind:'personal'});
    });
    return result;
  }

  // Build calendar grid HTML
  let gridHTML='';
  const dayNames=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  gridHTML+=`<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:1px;margin-bottom:.4rem">`;
  dayNames.forEach(dn=>{gridHTML+=`<div style="text-align:center;font-size:.62rem;color:#8070b8;letter-spacing:.04em;padding:.2rem 0">${dn}</div>`;});
  gridHTML+=`</div>`;
  gridHTML+=`<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:.8rem">`;
  for(let i=0;i<firstDay;i++) gridHTML+=`<div></div>`;
  for(let d=1;d<=daysInMonth;d++){
    const evs=eventsOnDay(d);
    const isToday=now.getFullYear()===yr&&now.getMonth()===mo&&now.getDate()===d;
    const hasMagic=evs.some(e=>e.kind==='magic');
    const hasPersonal=evs.some(e=>e.kind==='personal');
    const dotColor=hasPersonal?'#f0c040':hasMagic?'#a060ff':'transparent';
