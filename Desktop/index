function initCauldronSeason(){
  var canvas=document.getElementById('cauldronSeasonCanvas');
  if(!canvas)return;
  var ctx=canvas.getContext('2d');
  canvas.width=canvas.offsetWidth||400;
  canvas.height=52;
  var W=canvas.width, H=canvas.height;
  var m=new Date().getMonth();
  var season= m>=2&&m<=4?'spring': m>=5&&m<=7?'summer': m>=8&&m<=10?'fall':'winter';
  var particles=[];
  var emojis={
    fall:['🍂','🍁','🦷','🥂'],
    winter:['❅','❄','☆','★'],
    spring:['🌸','🌼','🌷','🦋'],
    summer:['☀️','✨','🌟','⛅']
  };
  var cols={fall:'rgba(255,140,60,',winter:'rgba(180,220,255,',spring:'rgba(255,180,220,',summer:'rgba(255,220,80,'};
  var em=emojis[season]||emojis.fall;
  var col=cols[season]||cols.fall;
  for(var i=0;i<18;i++){
    particles.push({
      x:Math.random()*W,
      y:Math.random()*H,
      s:.7+Math.random()*.8,
      sp:.3+Math.random()*.5,
      sw:Math.sin(Math.random()*6),
      sw2:Math.random()*.05,
      rot:Math.random()*6.28,
      rs:(Math.random()-.5)*.05,
      em:em[Math.floor(Math.random()*em.length)],
      op:.5+Math.random()*.5
    });
  }
  var raf=null;
  function frame(){
    ctx.clearRect(0,0,W,H);
    // Background gradient
    var grd=ctx.createLinearGradient(0,0,W,H);
    if(season==='fall'){grd.addColorStop(0,'rgba(60,20,5,.6)');grd.addColorStop(1,'rgba(30,10,2,.4)');}
    else if(season==='winter'){grd.addColorStop(0,'rgba(5,15,40,.6)');grd.addColorStop(1,'rgba(2,8,25,.4)');}
    else if(season==='spring'){grd.addColorStop(0,'rgba(20,5,30,.6)');grd.addColorStop(1,'rgba(10,2,20,.4)');}
    else{grd.addColorStop(0,'rgba(40,20,5,.6)');grd.addColorStop(1,'rgba(20,10,2,.4)');}
    ctx.fillStyle=grd;
    ctx.fillRect(0,0,W,H);
    particles.forEach(function(p){
      p.y+=p.sp;
      p.x+=Math.sin(p.sw+p.sw2*p.y)*0.6;
      p.rot+=p.rs;
      if(p.y>H+10){p.y=-10;p.x=Math.random()*W;}
      ctx.save();
      ctx.translate(p.x,p.y);
      ctx.rotate(p.rot);
      ctx.globalAlpha=p.op;
      ctx.font=(12*p.s)+'px serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(p.em,0,0);
      ctx.restore();
    });
    raf=requestAnimationFrame(frame);
  }
  frame();
  // Season label
  var labels={fall:'🍂 Autumn Brew',winter:'❄️ Winter Cauldron',spring:'🌸 Spring Potion',summer:'☀️ Summer Elixir'};
  ctx.font='bold 11px Georgia,serif';
  ctx.fillStyle='rgba(255,220,150,.7)';
  ctx.textAlign='center';
  ctx.fillText(labels[season]||'',W/2,H/2);
}

