function msAnswerBtns(answer,border,text){
  var opts=[answer-1,answer,answer+1,answer+2].sort(function(){return Math.random()-.5;});
  return opts.map(function(n){
    if(n<0)n=0;
    return '<button onclick="msCheckCount(this,'+n+','+answer+')" style="background:#1a0a2e;border:2px solid '+border+';border-radius:12px;width:3.5rem;height:3.5rem;color:'+text+';font-size:1.4rem;font-weight:bold;cursor:pointer;font-family:Georgia,serif">'+n+'</button>';
  }).join('');
}

function msSpellingDone(boxId,emoji){
