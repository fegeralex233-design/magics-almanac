// Get season from birth month
function getBirthSeason(month){
  if(month>=3&&month<=5) return 'spring';
  if(month>=6&&month<=8) return 'summer';
  if(month>=9&&month<=11) return 'autumn';
  return 'winter';
}

// Get fairy by sign + season (the collectible assignment)
function getMyFairy(zodiacSign, month){
  const season=getBirthSeason(month);
  return fairyTypes.find(f=>f.sign===zodiacSign&&f.season===season)||fairyTypes[0];
}

