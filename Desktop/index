function drawDailyCard(){
  const today=new Date();
  const seed=today.getFullYear()*10000+(today.getMonth()+1)*100+today.getDate();
  const idx=seed%fortuneCards.length;
  const card=fortuneCards[idx];
  const isReversed=seed%7===0;
  const reading=isReversed?card.reversed:card.upright;
  const safeReading=reading.replace(/'/g,"\\'");
  const wrap=document.getElementById('dailyCardWrap');
  if(!wrap)return;

  // Build full-screen card modal
  const existing=document.getElementById('tarotCardModal');
  if(existing) existing.remove();

  const modal=document.createElement('div');
  modal.id='tarotCardModal';
  modal.style.cssText='position:fixed;inset:0;z-index:8000;background:rgba(0,0,0,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(6px)';
  modal.onclick=function(e){if(e.target===modal)modal.remove();};

  modal.innerHTML=`
    <div style="width:100%;max-width:340px;position:relative">
      <!-- Close -->
      <button onclick="document.getElementById('tarotCardModal').remove()" style="position:absolute;top:-36px;right:0;background:none;border:none;color:#8070b0;font-size:1.1rem;cursor:pointer;font-family:inherit;z-index:1">✕ close</button>

      <!-- The card face — canvas drawn -->
      <canvas id="dailyCardCanvas" width="340" height="520" style="width:100%;border-radius:16px;display:block;box-shadow:0 0 60px rgba(201,162,39,.3)"></canvas>

      <!-- Reading below the card -->
      <div style="background:linear-gradient(160deg,#0e0228,#06010e);border:.5px solid rgba(201,162,39,.3);border-radius:0 0 16px 16px;padding:.85rem 1rem;margin-top:-4px">
        <div style="font-size:.68rem;color:rgba(201,162,39,.6);letter-spacing:.18em;text-transform:uppercase;margin-bottom:.3rem">${isReversed?'↕ Reversed · ':''}${card.suit}</div>
        <div style="font-size:1rem;color:#f0e8ff;line-height:1.72;font-style:italic;border-left:2px solid var(--gold);padding-left:.75rem;margin-bottom:.5rem">${reading}</div>
        <div style="background:#06010e;border:.5px solid #2a1050;border-radius:8px;padding:.55rem .75rem;margin-bottom:.55rem">
          <div style="font-size:.65rem;color:#8070b0;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.2rem">✦ Your challenge</div>
          <div style="font-size:.9rem;color:#e8e0f8;line-height:1.6">${card.action}</div>
        </div>
        <div style="display:flex;gap:.4rem">
          <button onclick="go('cards')" style="flex:1;padding:.45rem;background:none;color:#9080b8;border:.5px solid #2a1050;border-radius:8px;font-size:.8rem;cursor:pointer;font-family:inherit">Full reading →</button>
          <button onclick="shareResult('${card.name}','${safeReading}\\n\\n— from MAGICS Tarot')" style="flex:1;padding:.45rem;background:none;color:#9080b8;border:.5px solid #2a1050;border-radius:8px;font-size:.8rem;cursor:pointer;font-family:inherit">↗ Share</button>
        </div>
      </div>
    </div>`;

  document.body.appendChild(modal);

  // Draw the card on canvas
  requestAnimationFrame(()=>{
    const canvas=document.getElementById('dailyCardCanvas');
    if(!canvas)return;
    const W=340,H=520;
    canvas.width=W*2;canvas.height=H*2;
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    const ctx=canvas.getContext('2d');
    ctx.setTransform(2,0,0,2,0,0);

    if(isReversed){ctx.save();ctx.translate(W,H);ctx.rotate(Math.PI);}

    // Card background
    const bg=ctx.createLinearGradient(0,0,W,H);
    bg.addColorStop(0,'#1a0438');bg.addColorStop(0.4,'#0a0120');bg.addColorStop(1,'#160330');
    ctx.fillStyle=bg;
    roundRect(ctx,0,0,W,H,16);ctx.fill();

    // Outer glow border
    ctx.strokeStyle='rgba(201,162,39,0.85)';ctx.lineWidth=2.5;
    roundRect(ctx,4,4,W-8,H-8,13);ctx.stroke();

    // Inner border
    ctx.strokeStyle='rgba(201,162,39,0.25)';ctx.lineWidth=1;
    roundRect(ctx,10,10,W-20,H-20,10);ctx.stroke();

    // Decorative inner frame
    ctx.strokeStyle='rgba(201,162,39,0.12)';ctx.lineWidth=0.5;
    roundRect(ctx,16,16,W-32,H-32,8);ctx.stroke();

    // Corner ornaments — four corners
    [[20,20],[W-20,20],[20,H-20],[W-20,H-20]].forEach(([x,y])=>{
      ctx.fillStyle='rgba(201,162,39,0.8)';
      ctx.font='14px serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText('\u2726',x,y);
    });

    // Mid-corner ornaments
    [[W/2,22],[W/2,H-22],[22,H/2],[W-22,H/2]].forEach(([x,y])=>{
      ctx.fillStyle='rgba(201,162,39,0.35)';
      ctx.font='8px serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText('\u00b7',x,y);
    });

    // Card number — top center
    ctx.fillStyle='rgba(201,162,39,0.65)';
    ctx.font='bold 13px Georgia,serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(card.num||'',W/2,32);

    // Top decorative rule
    ctx.strokeStyle='rgba(201,162,39,0.2)';ctx.lineWidth=0.5;
    ctx.beginPath();ctx.moveTo(30,44);ctx.lineTo(W-30,44);ctx.stroke();

    // Illustration area — large circle
    const cx=W/2,cy=H*0.38;
    const r=100;

    // Outer ring glow
    const radGlow=ctx.createRadialGradient(cx,cy,r*0.3,cx,cy,r*1.4);
    radGlow.addColorStop(0,'rgba(201,162,39,0.12)');
    radGlow.addColorStop(0.6,'rgba(80,40,180,0.08)');
    radGlow.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=radGlow;ctx.fillRect(0,0,W,H);

    // Circle rings
    ctx.strokeStyle='rgba(201,162,39,0.5)';ctx.lineWidth=1.5;
    ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.stroke();
    ctx.strokeStyle='rgba(201,162,39,0.2)';ctx.lineWidth=0.7;
    ctx.beginPath();ctx.arc(cx,cy,r-8,0,Math.PI*2);ctx.stroke();
    ctx.strokeStyle='rgba(201,162,39,0.1)';ctx.lineWidth=0.4;
    ctx.beginPath();ctx.arc(cx,cy,r-14,0,Math.PI*2);ctx.stroke();

    // 8 star points around the circle
    for(let i=0;i<8;i++){
      const a=i*Math.PI/4;
      ctx.fillStyle='rgba(201,162,39,0.6)';
      ctx.font='10px serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(i%2===0?'\u2726':'\u00b7',cx+Math.cos(a)*(r+10),cy+Math.sin(a)*(r+10));
    }

    // Circle fill — deep space gradient
    const cirFill=ctx.createRadialGradient(cx,cy-20,10,cx,cy,r-10);
    cirFill.addColorStop(0,'rgba(60,20,120,0.4)');
    cirFill.addColorStop(0.5,'rgba(20,5,50,0.3)');
    cirFill.addColorStop(1,'rgba(0,0,0,0.5)');
    ctx.fillStyle=cirFill;
    ctx.beginPath();ctx.arc(cx,cy,r-2,0,Math.PI*2);ctx.fill();

    // Tiny stars scattered in circle
    for(let i=0;i<20;i++){
      const a=Math.random()*Math.PI*2;
      const dist=Math.random()*(r-20)+5;
      const sx=cx+Math.cos(a)*dist,sy=cy+Math.sin(a)*dist;
      ctx.fillStyle=`rgba(255,255,255,${0.2+Math.random()*0.5})`;
      ctx.fillRect(sx,sy,Math.random()<0.3?2:1,Math.random()<0.3?2:1);
    }

    // The card emoji — large, glowing, center of circle
    ctx.font='80px serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.shadowColor='rgba(201,162,39,0.9)';ctx.shadowBlur=30;
    ctx.fillText(card.emoji,cx,cy);
    ctx.shadowBlur=0;

    // Bottom rule
    ctx.strokeStyle='rgba(201,162,39,0.2)';ctx.lineWidth=0.5;
    ctx.beginPath();ctx.moveTo(28,H-88);ctx.lineTo(W-28,H-88);ctx.stroke();

    // Decorative rune-like symbols between rule and name
    const runes=['\u2736','\u2019','\u2736'];
    ctx.fillStyle='rgba(201,162,39,0.35)';ctx.font='11px serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(runes.join('  '),W/2,H-76);

    // Card name — large
    ctx.fillStyle='rgba(240,220,120,0.95)';
    const nameFontSize=card.name.length>14?14:16;
    ctx.font=`bold ${nameFontSize}px Georgia,serif`;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.shadowColor='rgba(201,162,39,0.4)';ctx.shadowBlur=8;
    ctx.fillText(card.name,W/2,H-55);
    ctx.shadowBlur=0;

    // Suit — small caps below name
    ctx.fillStyle='rgba(160,130,210,0.75)';
    ctx.font='10px sans-serif';
    ctx.fillText(card.suit.toUpperCase(),W/2,H-36);

    // Bottom number
    ctx.fillStyle='rgba(201,162,39,0.5)';
    ctx.font='11px Georgia,serif';
    ctx.fillText(card.num||'',W/2,H-20);

    if(isReversed) ctx.restore();

    function roundRect(ctx,x,y,w,h,r){
      ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);
      ctx.arcTo(x+w,y,x+w,y+r,r);ctx.lineTo(x+w,y+h-r);
      ctx.arcTo(x+w,y+h,x+w-r,y+h,r);ctx.lineTo(x+r,y+h);
      ctx.arcTo(x,y+h,x,y+h-r,r);ctx.lineTo(x,y+r);
      ctx.arcTo(x,y,x+r,y,r);ctx.closePath();
    }
  });

  // Update the home card widget to show it was drawn
  wrap.innerHTML=`
    <div style="font-size:.7rem;color:#9080b8;letter-spacing:.15em;text-transform:uppercase;margin-bottom:.4rem">✦ Your card for today</div>
