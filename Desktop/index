  const ctx=canvas.getContext('2d');
  const stars=Array.from({length:60},()=>({
    x:Math.random()*canvas.width,y:Math.random()*canvas.height,
    r:Math.random()*1.4+.3,ph:Math.random()*Math.PI*2,
    spd:Math.random()*.018+.006,
    col:['#ffd76a','#b0a0ff','#7ee8ff','#ffffff','#ffa0c0'][Math.floor(Math.random()*5)]
  }));
  function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    stars.forEach(s=>{
      s.ph+=s.spd;
      const a=.12+.72*(.5+.5*Math.sin(s.ph));
      ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle=s.col;ctx.globalAlpha=a;ctx.fill();
    });
    ctx.globalAlpha=1;
    requestAnimationFrame(draw);
  }
  draw();
}

