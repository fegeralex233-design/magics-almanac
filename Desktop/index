function doAmuletPrint(canvas,zodiac,element,elData,stone,birthDay,birthMonth,birthYear,birthHour,minSel,amuletName){

  // Build a composite canvas: amulet image + green laurel frame, all rendered to pixels
  // This avoids popup blockers entirely — we draw everything onto a big canvas and download as PNG
  const W=800, H=1100;
  const LW=W, LH=H;
  const pc=document.createElement('canvas');
  pc.width=W; pc.height=H;
  const pctx=pc.getContext('2d');

  // Dark parchment background
  const bg=pctx.createLinearGradient(0,0,LW,LH);
  bg.addColorStop(0,'#08010f'); bg.addColorStop(0.5,'#110228'); bg.addColorStop(1,'#05000e');
  pctx.fillStyle=bg; pctx.fillRect(0,0,LW,LH);

  // Subtle star field
  for(let i=0;i<200;i++){
    pctx.fillStyle=`rgba(255,255,255,${0.05+Math.random()*0.25})`;
    pctx.fillRect(Math.random()*LW,Math.random()*LH,Math.random()<0.15?1.5:0.7,Math.random()<0.15?1.5:0.7);
  }

  // Green laurel border leaves — drawn directly on canvas
  function drawLeaf(x,y,angle,size,shade){
    pctx.save();
    pctx.translate(x,y); pctx.rotate(angle);
    pctx.font=`${size}px serif`;
    pctx.textAlign='center'; pctx.textBaseline='middle';
    pctx.fillStyle=shade;
    pctx.shadowColor='rgba(60,200,60,0.35)'; pctx.shadowBlur=4;
    pctx.fillText('❧',0,0);
    pctx.shadowBlur=0; pctx.restore();
  }
  const leafShades=['#2a8a2a','#3aaa3a','#4ac04a','#2d9a2d'];
  const edgePad=18;
  // Top row
  const topN=44;
  for(let i=0;i<topN;i++){
    const x=edgePad+i*(LW-edgePad*2)/topN+8;
    drawLeaf(x,edgePad+2,(i%2===0?-0.35:0.35),15,leafShades[i%4]);
  }
  // Bottom row
  for(let i=0;i<topN;i++){
    const x=edgePad+i*(LW-edgePad*2)/topN+8;
    drawLeaf(x,LH-edgePad-2,(i%2===0?Math.PI+0.35:Math.PI-0.35),15,leafShades[i%4]);
  }
  // Left col
  const sideN=32;
  for(let i=0;i<sideN;i++){
    const y=edgePad+i*(LH-edgePad*2)/sideN+8;
    drawLeaf(edgePad+2,y,(i%2===0?-Math.PI/2-0.35:-Math.PI/2+0.35),13,leafShades[i%4]);
  }
  // Right col
  for(let i=0;i<sideN;i++){
    const y=edgePad+i*(LH-edgePad*2)/sideN+8;
    drawLeaf(LW-edgePad-2,y,(i%2===0?Math.PI/2+0.35:Math.PI/2-0.35),13,leafShades[i%4]);
  }
  // Corner stars
  [[edgePad,edgePad],[LW-edgePad,edgePad],[LW-edgePad,LH-edgePad],[edgePad,LH-edgePad]].forEach(([x,y])=>{
    pctx.font='18px serif'; pctx.textAlign='center'; pctx.textBaseline='middle';
    pctx.fillStyle='#4ac04a'; pctx.shadowColor='rgba(80,220,80,0.6)'; pctx.shadowBlur=8;
    pctx.fillText('✦',x,y); pctx.shadowBlur=0;
  });
  // Inner border lines
  pctx.strokeStyle='rgba(60,160,60,0.35)'; pctx.lineWidth=1;
  pctx.strokeRect(edgePad+16,edgePad+16,LW-edgePad*2-32,LH-edgePad*2-32);
  pctx.strokeStyle='rgba(60,160,60,0.18)'; pctx.lineWidth=0.5;
  pctx.strokeRect(edgePad+20,edgePad+20,LW-edgePad*2-40,LH-edgePad*2-40);

  // Title
  pctx.textAlign='center';
  pctx.font='bold 26px Georgia,serif';
  pctx.fillStyle='#80e080';
  pctx.shadowColor='rgba(80,220,80,0.4)'; pctx.shadowBlur=16;
  pctx.fillText('⊕  Birth Amulet  ⊕',LW/2,80);
  pctx.shadowBlur=0;
  pctx.font='11px Georgia,serif';
  pctx.fillStyle='rgba(201,162,39,0.65)';
  pctx.fillText('A CELESTIAL MEDALLION · FORGED BY THE CAULDRON',LW/2,108);

  // Name in flowing cursive font — loaded via canvas font stack
  let nameY=108, medalOffsetY=0;
  if(amuletName&&amuletName.trim()){
    nameY=142;
    medalOffsetY=44;
    // Soft glow line under subtitle
    pctx.strokeStyle='rgba(80,160,80,0.2)'; pctx.lineWidth=0.5;
    pctx.beginPath(); pctx.moveTo(LW/2-120,120); pctx.lineTo(LW/2+120,120); pctx.stroke();
    // Name in flowing italic serif — Georgia italic is the most universally available cursive-adjacent font
    pctx.font='italic 34px "Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif';
    pctx.fillStyle='rgba(240,192,64,0.92)';
    pctx.textAlign='center';
    pctx.shadowColor='rgba(201,162,39,0.6)'; pctx.shadowBlur=14;
    pctx.fillText(amuletName.trim(),LW/2,nameY);
    pctx.shadowBlur=0;
    // Decorative flourish either side
    pctx.font='16px serif'; pctx.fillStyle='rgba(80,180,80,0.5)';
    const nw=pctx.measureText(amuletName.trim()).width/2+18;
    pctx.fillText('❧',LW/2-nw,nameY);
    pctx.save(); pctx.translate(LW/2+nw,nameY); pctx.scale(-1,1); pctx.fillText('❧',0,0); pctx.restore();
  }

  // Amulet medallion image — centered
  const MEDAL=320;
  const mx=(LW-MEDAL)/2, my=150+medalOffsetY;
  pctx.save();
  pctx.beginPath(); pctx.arc(mx+MEDAL/2,my+MEDAL/2,MEDAL/2,0,Math.PI*2); pctx.clip();
  pctx.drawImage(canvas,mx,my,MEDAL,MEDAL);
  pctx.restore();
  // Glow ring around medallion
  const glowG=pctx.createRadialGradient(LW/2,my+MEDAL/2,MEDAL/2-2,LW/2,my+MEDAL/2,MEDAL/2+20);
  glowG.addColorStop(0,'rgba(80,180,80,0.18)'); glowG.addColorStop(1,'rgba(0,0,0,0)');
  pctx.fillStyle=glowG; pctx.beginPath(); pctx.arc(LW/2,my+MEDAL/2,MEDAL/2+20,0,Math.PI*2); pctx.fill();

  // Divider
  pctx.fillStyle='rgba(80,180,80,0.4)'; pctx.font='13px serif'; pctx.textAlign='center';
  pctx.fillText('· · · · ❧ · · · ·',LW/2,my+MEDAL+28);

  // Info grid — element, zodiac, stone, etc.
  const infoY=my+MEDAL+50;
  const hourDisp=birthHour>=0?(birthHour<12?(birthHour||12)+(minSel&&minSel.value?':'+minSel.value.padStart(2,'0'):'')+' AM':(birthHour===12?'12':(birthHour-12))+(minSel&&minSel.value?':'+minSel.value.padStart(2,'0'):'')+' PM'):'Unknown';
  const cells=[
    ['ELEMENT',element+' '+elData.sym],
    ['ZODIAC',zodiac.sign+' '+zodiac.emoji],
    ['BORN',birthDay],
    ['MONTH',birthMonth],
    ['YEAR',''+birthYear],
    ['STONE',stone.name],
    ['BIRTH HOUR',hourDisp],
    ['SIGN DATES',zodiac.dates||''],
    ['RULING PLANET',zodiac.ruler||'']
  ];
  const cols=3, cellW=(LW-120)/cols, cellH=70;
  cells.forEach(([label,val],idx)=>{
    const col=idx%cols, row=Math.floor(idx/cols);
    const cx2=60+col*cellW+cellW/2, cy2=infoY+row*cellH+cellH/2;
    // Cell bg
    pctx.fillStyle='rgba(0,0,0,0.25)';
    roundRect(pctx,60+col*cellW+4,infoY+row*cellH+4,cellW-8,cellH-8,8);
    pctx.fill();
    // Label
    pctx.font='9px Georgia,serif'; pctx.fillStyle='rgba(201,162,39,0.55)';
