async function ttGenerate(){
  const sel=window.ttSelected;
  // Symbol is now required first
  if(sel.symbol===null){alert('Please choose a symbol (Step 1) first.');return;}
  const symData=window.ttSymbols[sel.symbol];
  const isCustomSym=(symData.prompt===null);
  if(isCustomSym && sel.sign===null){alert('For a custom zodiac design, please choose your sign (Step 2).');return;}
  if(sel.style===null){alert('Please choose a tattoo style.');return;}
  if(sel.size===null){alert('Please choose a placement & size.');return;}

  const sign=sel.sign!==null?window.ttSigns[sel.sign]:null;
  const style=window.ttStyles[sel.style];
  const size=window.ttSizes[sel.size];
  const c1=document.getElementById('ttColor1').value;
  const c2=document.getElementById('ttColor2').value;
  const c3=document.getElementById('ttColor3').value;
  const bg=document.getElementById('ttBg').value;
  const meaning=document.getElementById('ttMeaning').value.trim();

  document.getElementById('ttGenBtn').style.opacity='0.4';
  document.getElementById('ttResult').style.display='none';
  document.getElementById('ttLoading').style.display='block';

  const colorDesc='Primary: '+c1+', Secondary: '+c2+', Accent: '+c3;
  const meaningPart=meaning?(' Personal meaning to incorporate: '+meaning+'.'):' ';

  // Build subject based on symbol choice
  var subjectPrompt;
  if(isCustomSym){
    subjectPrompt='Tattoo design: '+style.n+' style. Subject: '+sign.n+' zodiac ('+sign.e+') — incorporate '+sign.sym+'.';
  } else {
    subjectPrompt='Tattoo design: '+style.n+' style. Sacred symbol: '+symData.name+' ('+symData.tradition+' tradition) — '+symData.prompt+'.';
    if(sign){subjectPrompt+=' Subtly incorporate '+sign.n+' zodiac energy ('+sign.e+').';}
  }

  const prompt=(
    subjectPrompt
    +' Placement: '+size.p+'. Colors: '+colorDesc+'. Background: '+bg+'.'
    +meaningPart
    +' The design must be isolated on a clean white background, ready for tattoo transfer paper.'
    +' High contrast, clean linework. No text unless requested. Professional tattoo flash sheet quality.'
    +' Square composition.'
  );

  try{
    const result=await aiImage(prompt,null,null);
    window.ttLastImage=result;
    const img=document.getElementById('ttImg');
    img.src='data:'+result.mimeType+';base64,'+result.image;
    document.getElementById('ttLoading').style.display='none';
    document.getElementById('ttResult').style.display='block';
    document.getElementById('ttGenBtn').style.opacity='1';

    // Variation suggestions
    const vars=document.getElementById('ttVariations');
    vars.innerHTML=(
      '<div style="font-size:.7rem;color:#a080d0;letter-spacing:.1em;text-transform:uppercase;font-weight:700;margin-bottom:.45rem">Try a variation</div>'
      +'<div style="display:flex;flex-wrap:wrap;gap:.4rem">'
      +['Add birth date', 'Add initials', 'Add constellation', 'Bolder lines', 'More minimal', 'Add moon phase', 'Color version', 'Black & grey'].map(function(v){
        return '<div onclick="ttQuickVariation(\''+v+'\')" style="padding:.3rem .65rem;font-size:.72rem;border:.5px solid #3a1a5e;border-radius:14px;background:#080118;color:#9080b8;cursor:pointer">'+v+'</div>';
      }).join('')
      +'</div>'
    );
  }catch(e){
    document.getElementById('ttLoading').style.display='none';
    document.getElementById('ttGenBtn').style.opacity='1';
    document.getElementById('ttResult').style.display='block';
    document.getElementById('ttImg').style.display='none';
    document.getElementById('ttResult').innerHTML+=(
      '<div style="color:#c06060;font-size:.82rem;padding:.6rem;background:#0e0225;border-radius:10px">'
      +(e.message==='NOT_CONFIGURED'?relayErrorHTML():'Generation error: '+e.message)
      +'</div>'
    );
  }
}

async function ttQuickVariation(v){
  const meaning=(document.getElementById('ttMeaning').value.trim()||'');
  document.getElementById('ttMeaning').value=(meaning?(meaning+', '):'')+v;
  await ttGenerate();
}

function ttDownload(){
  const img=window.ttLastImage;
  if(!img)return;
  const a=document.createElement('a');
  a.href='data:'+img.mimeType+';base64,'+img.image;
  const symIdx=window.ttSelected.symbol;
  const symDl=symIdx!==null?window.ttSymbols[symIdx]:null;
  const signDl=window.ttSelected.sign!==null?window.ttSigns[window.ttSelected.sign].n:null;
  const sign=(symDl&&symDl.prompt!==null)?symDl.name:(signDl||'tattoo');
  a.download='magic-tattoo-'+sign.toLowerCase()+'-'+Date.now()+'.png';
  a.click();
}


